// Проверка уникальности идентификаторов объектов метаданных в файлах выгрузки.
//
// Значения вида UUID образуют в выгрузке три независимых пространства: идентификаторы объектов
// метаданных (атрибут uuid), идентификаторы порождаемых типов (xr:TypeId и xr:ValueId) и
// идентификаторы предопределённых элементов (Item id). Повтор значения внутри одного пространства
// делает объект неразличимым для платформы; совпадение значений между разными пространствами
// работоспособно и ошибкой не признаётся.
//
// Дополнительно проверяется, что каждая ссылка ExtendedConfigurationObject расширения
// разрешается ровно в один объект конфигурации.
//
// Проверка читает только файлы выгрузки: платформа 1С:Предприятие и информационная база не нужны.

Перем ПространствоОбъектов;
Перем ПространствоТипов;
Перем ПространствоПредопределённых;
Перем ИменаПространств;
Перем КаталогПроекта;

#Область РазборФайловВыгрузки

Функция ДеревьяВыгрузки()

	Деревья = Новый Массив;
	ДобавитьДерево(Деревья, "src/cf");

	КаталогРасширений = Новый Файл(ОбъединитьПути(КаталогПроекта, "src", "cfe"));
	Если КаталогРасширений.Существует() Тогда
		Для Каждого Расширение Из НайтиФайлы(КаталогРасширений.ПолноеИмя, "*", Ложь) Цикл
			Если Расширение.ЭтоКаталог() Тогда
				ДобавитьДерево(Деревья, "src/cfe/" + Расширение.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Деревья;

КонецФункции

Процедура ДобавитьДерево(Деревья, ОтносительныйПуть)

	Каталог = Новый Файл(ОбъединитьПути(КаталогПроекта, ОтносительныйПуть));
	Если Не Каталог.Существует() Тогда
		Возврат;
	КонецЕсли;

	Идентификаторы = Новый Соответствие;
	Для Каждого ИмяПространства Из ИменаПространств Цикл
		Идентификаторы.Вставить(ИмяПространства, Новый Соответствие);
	КонецЦикла;

	Дерево = Новый Структура("Путь, Каталог, Идентификаторы, Ссылки");
	Дерево.Путь = ОтносительныйПуть;
	Дерево.Каталог = Каталог.ПолноеИмя;
	Дерево.Идентификаторы = Идентификаторы;
	Дерево.Ссылки = Новый Массив;
	Деревья.Добавить(Дерево);

КонецПроцедуры

Процедура ПрочитатьДерево(Дерево)

	Для Каждого ФайлВыгрузки Из НайтиФайлы(Дерево.Каталог, "*.xml", Истина) Цикл
		ПрочитатьФайлВыгрузки(Дерево, ФайлВыгрузки.ПолноеИмя, ПутьДляСообщения(ФайлВыгрузки.ПолноеИмя));
	КонецЦикла;

КонецПроцедуры

// Файл разбирается построчно: в выгрузке 1С каждый идентификатор занимает отдельную строку,
// а имя объекта объявлено ниже собственного идентификатора.
Процедура ПрочитатьФайлВыгрузки(Дерево, ПолноеИмя, ПутьФайла)

	Чтение = Новый ЧтениеТекста(ПолноеИмя, "UTF-8");
	НомерСтроки = 0;
	ИмяПорождаемогоТипа = "";
	НосительБезИмени = Неопределено;
	ПоследнийОбъект = Неопределено;

	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл

		НомерСтроки = НомерСтроки + 1;

		Если СтрНайти(Строка, "uuid=""") > 0 Тогда
			НосительБезИмени = ЗаписатьИдентификатор(Дерево, ПространствоОбъектов,
				ТекстМеждуРазделителями(Строка, "uuid=""", """"),
				ПутьФайла, НомерСтроки, ТекстМеждуРазделителями(Строка, "<", " "));
			ПоследнийОбъект = НосительБезИмени;

		ИначеЕсли СтрНайти(Строка, "<Item id=""") > 0 Тогда
			НосительБезИмени = ЗаписатьИдентификатор(Дерево, ПространствоПредопределённых,
				ТекстМеждуРазделителями(Строка, "<Item id=""", """"),
				ПутьФайла, НомерСтроки, "Item");

		ИначеЕсли СтрНайти(Строка, "<xr:GeneratedType ") > 0 Тогда
			ИмяПорождаемогоТипа = ТекстМеждуРазделителями(Строка, "name=""", """");

		ИначеЕсли СтрНайти(Строка, "<xr:TypeId>") > 0 Тогда
			ЗаписатьИдентификатор(Дерево, ПространствоТипов,
				ТекстМеждуРазделителями(Строка, "<xr:TypeId>", "<"),
				ПутьФайла, НомерСтроки, "xr:TypeId " + ИмяПорождаемогоТипа);

		ИначеЕсли СтрНайти(Строка, "<xr:ValueId>") > 0 Тогда
			ЗаписатьИдентификатор(Дерево, ПространствоТипов,
				ТекстМеждуРазделителями(Строка, "<xr:ValueId>", "<"),
				ПутьФайла, НомерСтроки, "xr:ValueId " + ИмяПорождаемогоТипа);

		ИначеЕсли СтрНайти(Строка, "<ExtendedConfigurationObject>") > 0 Тогда
			ЗаписатьСсылку(Дерево, ТекстМеждуРазделителями(Строка, "<ExtendedConfigurationObject>", "<"),
				ПутьФайла, НомерСтроки, ОписаниеОбъекта(ПоследнийОбъект));

		ИначеЕсли НосительБезИмени <> Неопределено И СтрНайти(Строка, "<Name>") > 0 Тогда
			НосительБезИмени.Описание = НосительБезИмени.Описание + " "
				+ ТекстМеждуРазделителями(Строка, "<Name>", "<");
			НосительБезИмени = Неопределено;

		КонецЕсли;

		Строка = Чтение.ПрочитатьСтроку();

	КонецЦикла;

	Чтение.Закрыть();

КонецПроцедуры

Функция ЗаписатьИдентификатор(Дерево, ИмяПространства, Значение, ПутьФайла, НомерСтроки, Описание)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Носитель = Новый Структура("Файл, Строка, Описание", ПутьФайла, НомерСтроки, СокрЛП(Описание));

	Пространство = Дерево.Идентификаторы[ИмяПространства];
	Носители = Пространство[Значение];
	Если Носители = Неопределено Тогда
		Носители = Новый Массив;
		Пространство.Вставить(Значение, Носители);
	КонецЕсли;
	Носители.Добавить(Носитель);

	Возврат Носитель;

КонецФункции

Процедура ЗаписатьСсылку(Дерево, Значение, ПутьФайла, НомерСтроки, Описание)

	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;

	Дерево.Ссылки.Добавить(Новый Структура("Файл, Строка, Описание, Значение",
		ПутьФайла, НомерСтроки, Описание, Значение));

КонецПроцедуры

Функция ОписаниеОбъекта(Носитель)

	Возврат ?(Носитель = Неопределено, "объект не определён", Носитель.Описание);

КонецФункции

Функция ТекстМеждуРазделителями(Строка, Начало, Конец)

	Позиция = СтрНайти(Строка, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Строка, Позиция + СтрДлина(Начало));
	ПозицияКонца = СтрНайти(Остаток, Конец);
	Если ПозицияКонца = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Остаток, ПозицияКонца - 1);

КонецФункции

Функция ПутьДляСообщения(ПолноеИмяФайла)

	Возврат СтрЗаменить(Сред(ПолноеИмяФайла, СтрДлина(КаталогПроекта) + 2), "\", "/");

КонецФункции

#КонецОбласти

#Область Проверки

Процедура СобратьСтолкновения(Деревья, Нарушения)

	Для Каждого Дерево Из Деревья Цикл
		Для Каждого ИмяПространства Из ИменаПространств Цикл
			Для Каждого Идентификатор Из Дерево.Идентификаторы[ИмяПространства] Цикл

				Носители = Идентификатор.Значение;
				Если Носители.Количество() = 1 Тогда
					Продолжить;
				КонецЕсли;

				Текст = СтрШаблон("%1: в пространстве «%2» значение %3 объявлено более одного раза:",
					Дерево.Путь, ИмяПространства, Идентификатор.Ключ);
				Для Каждого Носитель Из Носители Цикл
					Текст = Текст + Символы.ПС + СтрШаблон("      %1:%2 — %3",
						Носитель.Файл, Носитель.Строка, Носитель.Описание);
				КонецЦикла;
				Нарушения.Добавить(Текст);

			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура СобратьНеразрешимыеСсылки(Деревья, Нарушения)

	ИдентификаторыКонфигурации = ОбъектыКонфигурации(Деревья);
	Если ИдентификаторыКонфигурации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Дерево Из Деревья Цикл
		Для Каждого Ссылка Из Дерево.Ссылки Цикл

			Цели = ИдентификаторыКонфигурации[Ссылка.Значение];
			КоличествоЦелей = ?(Цели = Неопределено, 0, Цели.Количество());
			Если КоличествоЦелей = 1 Тогда
				Продолжить;
			КонецЕсли;

			Текст = СтрШаблон(
				"%1: ссылка ExtendedConfigurationObject %2 не разрешается ровно в один объект конфигурации (найдено объектов: %3):",
				Дерево.Путь, Ссылка.Значение, КоличествоЦелей);
			Текст = Текст + Символы.ПС + СтрШаблон("      %1:%2 — %3",
				Ссылка.Файл, Ссылка.Строка, Ссылка.Описание);
			Если Цели <> Неопределено Тогда
				Для Каждого Цель Из Цели Цикл
					Текст = Текст + Символы.ПС + СтрШаблон("      цель: %1:%2 — %3",
						Цель.Файл, Цель.Строка, Цель.Описание);
				КонецЦикла;
			КонецЕсли;
			Нарушения.Добавить(Текст);

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ОбъектыКонфигурации(Деревья)

	Для Каждого Дерево Из Деревья Цикл
		Если Дерево.Путь = "src/cf" Тогда
			Возврат Дерево.Идентификаторы[ПространствоОбъектов];
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ВыводРезультата

Процедура ВывестиСводку(Деревья)

	Сообщить("Проверка уникальности идентификаторов по файлам выгрузки:");
	Для Каждого Дерево Из Деревья Цикл
		Сообщить("   " + Дерево.Путь);
		Для Каждого ИмяПространства Из ИменаПространств Цикл
			Сообщить(СтрШаблон("      %1: %2", ИмяПространства,
				КоличествоОбъявлений(Дерево.Идентификаторы[ИмяПространства])));
		КонецЦикла;
		Если Дерево.Ссылки.Количество() > 0 Тогда
			Сообщить(СтрШаблон("      ссылки ExtendedConfigurationObject: %1", Дерево.Ссылки.Количество()));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КоличествоОбъявлений(Пространство)

	Количество = 0;
	Для Каждого Идентификатор Из Пространство Цикл
		Количество = Количество + Идентификатор.Значение.Количество();
	КонецЦикла;

	Возврат Количество;

КонецФункции

#КонецОбласти

Процедура Проверить()

	Деревья = ДеревьяВыгрузки();
	Если Деревья.Количество() = 0 Тогда
		Сообщить("Файлы выгрузки не найдены: проверять нечего.");
		Возврат;
	КонецЕсли;

	Для Каждого Дерево Из Деревья Цикл
		ПрочитатьДерево(Дерево);
	КонецЦикла;

	Нарушения = Новый Массив;
	СобратьСтолкновения(Деревья, Нарушения);
	СобратьНеразрешимыеСсылки(Деревья, Нарушения);

	ВывестиСводку(Деревья);

	Если Нарушения.Количество() = 0 Тогда
		Сообщить("Столкновений идентификаторов не обнаружено.");
		Возврат;
	КонецЕсли;

	Сообщить("");
	Для Каждого Нарушение Из Нарушения Цикл
		Сообщить(Нарушение);
	КонецЦикла;
	Сообщить(СтрШаблон("Проверка не пройдена, нарушений: %1.", Нарушения.Количество()));
	ЗавершитьРаботу(1);

КонецПроцедуры

ПространствоОбъектов = "идентификаторы объектов метаданных";
ПространствоТипов = "идентификаторы порождаемых типов";
ПространствоПредопределённых = "идентификаторы предопределённых элементов";

ИменаПространств = Новый Массив;
ИменаПространств.Добавить(ПространствоОбъектов);
ИменаПространств.Добавить(ПространствоТипов);
ИменаПространств.Добавить(ПространствоПредопределённых);

КаталогПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..")).ПолноеИмя;

Проверить();

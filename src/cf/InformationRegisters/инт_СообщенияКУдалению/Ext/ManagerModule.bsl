////////////////////////////////////////////////////////////////////////////////
// инт_СообщенияКУдалению
//  
////////////////////////////////////////////////////////////////////////////////

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
// Процедура - Зарегистрировать сообщение к удалению
// Ставит сообщение в очередь удаления.
// Параметры:
//  ИдентификаторСообщения	 - 	УникальныйИдентификатор - ИдентификаторСообщения которое необходимо удалить из очередей.
//  НаправлениеПотока		 - ПеречислениеСсылка.инт_НаправлениеПотокаДанных	 -  Направление потока данных.
//
Процедура ЗарегистрироватьСообщениеКУдалению(ИдентификаторСообщения, НаправлениеПотока) Экспорт
	Если НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		Менеджер = РегистрыСведений.инт_ОчередьИсходящихСообщений;
	ИначеЕсли НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Входящий Тогда
		Менеджер = РегистрыСведений.инт_ОчередьВходящихСообщений;
	Иначе
		ВызватьИсключение "Ошибка при попытке зарегистрировать сообщение к удалению";
	КонецЕсли;
	
	ДанныеОСообщении = Менеджер.ПолучитьДанныеОчередиПоИдентификатору(ИдентификаторСообщения, "ПотокДанных");
	ДнейДоУдаления = ДанныеОСообщении.ПотокДанных.УдалятьОбработанныеСообщенияЧерез;
	
	Если ДнейДоУдаления > 0 Тогда
		Запись = РегистрыСведений.инт_СообщенияКУдалению.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторСообщения = ИдентификаторСообщения;
		Запись.НаправлениеПотока = НаправлениеПотока;
		Запись.ДатаУдаления = ДатаУдаленияПоСрокуХранения(ДнейДоУдаления);
		Запись.Записать(Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Процедура ОчиститьОчередьИсходящихСообщений() Экспорт
	МассивИдентификаторов = ПолучитьМассивИдентификаторовКУдалению(Перечисления.инт_НаправлениеПотокаДанных.Исходящий);
	
	Для Каждого Идентификатор Из МассивИдентификаторов Цикл
		НачатьТранзакцию();
		Попытка
			РегистрыСведений.инт_ОчередьИсходящихСообщений.УдалитьСообщениеИзОчередиПоИдентификатору(Идентификатор);
			
			Запись = РегистрыСведений.инт_СообщенияКУдалению.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторСообщения = Идентификатор;
			Запись.НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий;
			Запись.Удалить();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			СообщениеОбОшибке = СтрШаблон("При попытке удаления сообщения с идентификатором <%1> из очереди исходящих, возникла ошибка!
			|
			| Информация об ошибке: %2", Идентификатор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		    ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.СообщенияКУдалению", УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке);
		КонецПопытки;
			
	КонецЦикла;
КонецПроцедуры

Процедура ОчиститьОчередьВходящихСообщений() Экспорт
	МассивИдентификаторов = ПолучитьМассивИдентификаторовКУдалению(Перечисления.инт_НаправлениеПотокаДанных.Входящий);
	
	Для Каждого Идентификатор Из МассивИдентификаторов Цикл
		НачатьТранзакцию();
		Попытка
			РегистрыСведений.инт_ОчередьВходящихСообщений.УдалитьСообщениеИзОчередиПоИдентификатору(Идентификатор);
			
			Запись = РегистрыСведений.инт_СообщенияКУдалению.СоздатьМенеджерЗаписи();
			Запись.ИдентификаторСообщения = Идентификатор;
			Запись.НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Входящий;
			Запись.Удалить();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			СообщениеОбОшибке = СтрШаблон("При попытке удаления сообщения с идентификатором <%1> из очереди входящих, возникла ошибка!
			|
			| Информация об ошибке: %2", Идентификатор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		    ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.СообщенияКУдалению", УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке);
		КонецПопытки;
			
	КонецЦикла;
КонецПроцедуры

// Процедура - Зарегистрировать обработанные сообщения потока
// Проставляет дату удаления обработанным сообщениям потока, у которых она еще не проставлена.
// Требуется, когда срок хранения задали позже, чем сообщения были обработаны: в момент обработки
// регистрировать к удалению было нечего.
// Вызывается вне явной транзакции: при конфликте ключа пачка перезаписывается остатком, а в транзакции
// после ошибки записи платформа отклоняет любые обращения к базе, и внешняя транзакция будет разрушена.
//
// Параметры:
//  ПотокДанных				 - СправочникСсылка.инт_ПотокиДанных	 - Поток данных, сообщения которого регистрируются.
//  КоличествоСообщенийВПачке	 - Число	 - Количество сообщений, записываемых одним набором записей.
//
Процедура ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных, КоличествоСообщенийВПачке = 1000) Экспорт
	НастройкиПотока = инт_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПотокДанных,
		"УдалятьОбработанныеСообщенияЧерез, НаправлениеПотока");
	
	Если НастройкиПотока.УдалятьОбработанныеСообщенияЧерез <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = ЗапросОбработанныхСообщенийБезДатыУдаления(НастройкиПотока.НаправлениеПотока);
	Запрос.УстановитьПараметр("ПотокДанных", ПотокДанных);
	ИдентификаторыСообщений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");
	
	ЗаписатьДатуУдаления(ИдентификаторыСообщений,
		НастройкиПотока.НаправлениеПотока,
		ДатаУдаленияПоСрокуХранения(НастройкиПотока.УдалятьОбработанныеСообщенияЧерез),
		КоличествоСообщенийВПачке);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция ПолучитьМассивИдентификаторовКУдалению(НаправлениеПотока)

Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
               |	инт_СообщенияКУдалению.ИдентификаторСообщения КАК ИдентификаторСообщения
               |ИЗ
               |	РегистрСведений.инт_СообщенияКУдалению КАК инт_СообщенияКУдалению
               |ГДЕ
               |	инт_СообщенияКУдалению.НаправлениеПотока = &НаправлениеПотока
               |	И инт_СообщенияКУдалению.ДатаУдаления <= &ТекущаяДата";
Запрос.УстановитьПараметр("НаправлениеПотока",НаправлениеПотока);
Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");
КонецФункции

Функция ДатаУдаленияПоСрокуХранения(СрокХраненияДней)
	СекундВСутках = 86400;
	Возврат ТекущаяДатаСеанса() + СрокХраненияДней * СекундВСутках;
КонецФункции

Функция ЗапросОбработанныхСообщенийБезДатыУдаления(НаправлениеПотока)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаправлениеПотока", НаправлениеПотока);
	
	Если НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Входящий Тогда
		Запрос.УстановитьПараметр("СтатусОбработан", Перечисления.инт_СтатусыВходящихСообщений.Обработан);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.инт_ОчередьВходящихСообщений КАК Очередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.инт_ТекущийСтатусВходящихСообщений КАК Статус
		|		ПО Очередь.ИдентификаторСообщения = Статус.ИдентификаторСообщения
		|			И Статус.СтатусСообщения = &СтатусОбработан
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.инт_СообщенияКУдалению КАК КУдалению
		|		ПО Очередь.ИдентификаторСообщения = КУдалению.ИдентификаторСообщения
		|			И КУдалению.НаправлениеПотока = &НаправлениеПотока
		|ГДЕ
		|	Очередь.ПотокДанных = &ПотокДанных
		|	И КУдалению.ИдентификаторСообщения ЕСТЬ NULL";
		
	ИначеЕсли НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		Запрос.УстановитьПараметр("СтатусОтправлен",
			Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Отправлен);
		// Сообщение считается обработанным, когда оно отправлено всем подписчикам,
		// - то же условие, по которому сообщение регистрируется к удалению при записи статуса рассылки.
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Очередь.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.инт_ОчередьИсходящихСообщений КАК Очередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.инт_ТекущийСтатусРассылкиСообщений КАК Рассылка
		|		ПО Очередь.ИдентификаторСообщения = Рассылка.ИдентификаторСообщения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.инт_СообщенияКУдалению КАК КУдалению
		|		ПО Очередь.ИдентификаторСообщения = КУдалению.ИдентификаторСообщения
		|			И КУдалению.НаправлениеПотока = &НаправлениеПотока
		|ГДЕ
		|	Очередь.ПотокДанных = &ПотокДанных
		|	И КУдалению.ИдентификаторСообщения ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	Очередь.ИдентификаторСообщения
		|
		|ИМЕЮЩИЕ
		|	МИНИМУМ(ВЫБОР
		|			КОГДА Рассылка.СтатусСообщения = &СтатусОтправлен
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) = 1";
		
	Иначе
		ВызватьИсключение "Ошибка при попытке зарегистрировать обработанные сообщения потока к удалению:
			|не задано направление потока";
	КонецЕсли;
	
	Возврат Запрос;
КонецФункции

Процедура ЗаписатьДатуУдаления(ИдентификаторыСообщений, НаправлениеПотока, ДатаУдаления, КоличествоСообщенийВПачке)
	НаборЗаписей = РегистрыСведений.инт_СообщенияКУдалению.СоздатьНаборЗаписей();
	
	Для Каждого ИдентификаторСообщения Из ИдентификаторыСообщений Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.ИдентификаторСообщения = ИдентификаторСообщения;
		Запись.НаправлениеПотока = НаправлениеПотока;
		Запись.ДатаУдаления = ДатаУдаления;
		
		Если НаборЗаписей.Количество() = КоличествоСообщенийВПачке Тогда
			ЗаписатьПачку(НаборЗаписей, НаправлениеПотока);
			НаборЗаписей.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьПачку(НаборЗаписей, НаправлениеПотока);
КонецПроцедуры

Процедура ЗаписатьПачку(НаборЗаписей, НаправлениеПотока)
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать(Ложь);
		Возврат;
	Исключение
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	СообщениеОбОшибке = СтрШаблон("При записи пачки сообщений к удалению возникла ошибка!
		|
		| Информация об ошибке: %1", ОписаниеОшибки);
	ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.СообщенияКУдалению",
		УровеньЖурналаРегистрации.Ошибка, , , СообщениеОбОшибке);
	
	// Самая ожидаемая причина отказа - сообщение пачки успел зарегистрировать штатный путь:
	// поток продолжает работать, а набор пишется без замещения и конфликтует по ключу.
	// Такие сообщения из пачки исключаются - их дата удаления проставлена законно и меняться
	// не должна, - а остаток записывается снова. Отказ по другой причине повторится и будет выброшен.
	ИсключитьЗарегистрированныеСообщения(НаборЗаписей, НаправлениеПотока);
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ИсключитьЗарегистрированныеСообщения(НаборЗаписей, НаправлениеПотока)
	ЗаписиПачки = НаборЗаписей.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	инт_СообщенияКУдалению.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.инт_СообщенияКУдалению КАК инт_СообщенияКУдалению
		|ГДЕ
		|	инт_СообщенияКУдалению.ИдентификаторСообщения В (&ИдентификаторыСообщений)
		|	И инт_СообщенияКУдалению.НаправлениеПотока = &НаправлениеПотока";
	Запрос.УстановитьПараметр("ИдентификаторыСообщений", ЗаписиПачки.ВыгрузитьКолонку("ИдентификаторСообщения"));
	Запрос.УстановитьПараметр("НаправлениеПотока", НаправлениеПотока);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Зарегистрированное = ЗаписиПачки.Найти(Выборка.ИдентификаторСообщения, "ИдентификаторСообщения");
		Если Зарегистрированное <> Неопределено Тогда
			ЗаписиПачки.Удалить(Зарегистрированное);
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Загрузить(ЗаписиПачки);
КонецПроцедуры

#КонецОбласти

#КонецЕсли

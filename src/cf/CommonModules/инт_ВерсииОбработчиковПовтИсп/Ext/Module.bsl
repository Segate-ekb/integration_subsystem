////////////////////////////////////////////////////////////////////////////////
// инт_ВерсииОбработчиковПовтИсп
//
// Признак версии обработчика, сохранённого в базе данных.
// Повторное использование возвращаемых значений: В течение вызова.
//
// Признак версии служит ключом кэша подключённых обработок (инт_ГенераторОбработокПовтИсп),
// поэтому новый текст обработчика применяется со следующего серверного вызова.
// Компиляция и подключение внешней обработки здесь не выполняются: иначе они
// повторялись бы на каждый серверный вызов.
//
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Функция - Версия обработчика потока
// Возвращает признак версии скомпилированного обработчика потока данных:
// хеш текста, из которого получен сохранённый в базе данных EPF.
//
// Параметры:
//  ПотокДанных - СправочникСсылка.инт_ПотокиДанных - Ссылка на поток данных.
//
// Возвращаемое значение:
//  Строка - Признак версии. Пустая строка, если обработчик ни разу не компилировался.
//
Функция ВерсияОбработчикаПотока(Знач ПотокДанных) Экспорт
	
	// Запросом, а не обращением через точку: обращение через точку прочитало бы объект целиком
	// вместе с реквизитом СкомпилированныйОбработчик, то есть двоичные данные EPF на каждый
	// серверный вызов. Запрос собран здесь, а не взят из инт_ОбщегоНазначения: тот модуль
	// объявлен только для сервера, а этот вызывается ещё из внешнего соединения
	// и толстого клиента обычного приложения.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПотокиДанных.ХешСкомпилированногоОбработчика КАК ХешСкомпилированногоОбработчика
		|ИЗ
		|	Справочник.инт_ПотокиДанных КАК ПотокиДанных
		|ГДЕ
		|	ПотокиДанных.Ссылка = &ПотокДанных";
	Запрос.УстановитьПараметр("ПотокДанных", ПотокДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ХешСкомпилированногоОбработчика, "");
	
КонецФункции

// Функция - Строка пост-обработки
// Возвращает номер строки и текст обработчика пост-обработки подписчика для кода состояния.
//
// Читается запросом, а не обращением через точку: обращение через точку прочитало бы
// табличную часть целиком вместе с реквизитом СкомпилированныйОбработчик, то есть двоичные
// данные всех обработчиков подписчика на каждое сообщение.
//
// Параметры:
//  Подписчик    - СправочникСсылка - Подписчик с табличной частью ПостПроцессинг.
//  КодСостояния - Число - Код состояния ответа.
//
// Возвращаемое значение:
//  Структура:
//    * НомерСтроки      - Число - Номер строки табличной части. Ноль, если строки нет.
//    * ТекстОбработчика - Строка - Текст обработчика. Пустая строка, если строки нет.
//
Функция СтрокаПостОбработки(Знач Подписчик, Знач КодСостояния) Экспорт
	
	ИмяТаблицы = Подписчик.Метаданные().ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПостПроцессинг.НомерСтроки КАК НомерСтроки,
		|	ПостПроцессинг.Обработчик КАК ТекстОбработчика
		|ИЗ
		|	%1.ПостПроцессинг КАК ПостПроцессинг
		|ГДЕ
		|	ПостПроцессинг.Ссылка = &Подписчик
		|	И ПостПроцессинг.КодСостояния = &КодСостояния", ИмяТаблицы);
	Запрос.УстановитьПараметр("Подписчик", Подписчик);
	Запрос.УстановитьПараметр("КодСостояния", КодСостояния);
	
	Строка = Новый Структура("НомерСтроки, ТекстОбработчика", 0, "");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
	КонецЕсли;
	
	Возврат Строка;
	
КонецФункции

#КонецОбласти

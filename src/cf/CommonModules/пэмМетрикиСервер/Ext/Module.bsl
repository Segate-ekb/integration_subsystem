// BSLLS-off
#Область Push

// Рассчитывает метрики регламентным заданием.
// Общий регламент рассчитывает метрики метода получения Push и отправляет их на Pushgateway.
// Персональный регламент рассчитывает одну метрику независимо от её метода получения
// и от настроек Pushgateway: результат метрики Push отправляется на Pushgateway, а значение
// метрики Pull сохраняется расчётом и выдаётся следующим ответом на опрос.
//
// Параметры:
//   Метрика - Строка, Неопределено - код метрики персонального регламентного задания;
//                                    Неопределено означает общий регламент
//
Процедура СформироватьМетрикиРегламентнымЗаданием(Метрика = Неопределено) Экспорт

	ЭтоОбщийРегламент = (Метрика = Неопределено);

	// Результат общего регламента потребляет только Pushgateway: при выключенной отправке
	// рассчитывать метрики незачем. Персональный регламент от этой настройки не зависит.
	Если ЭтоОбщийРегламент И НЕ пэмМетрикиСерверПовтИсп.РазрешеноИспользованиеМетодаPush() Тогда
		Возврат;
	КонецЕсли;

	МетодПолучения = ?(ЭтоОбщийРегламент, Перечисления.пэмМетодыПолученияМетрик.Push, Неопределено);
	Итоги = ПолучитьМетрики(МетодПолучения, Метрика);

	Если ЭтоОбщийРегламент
		ИЛИ МетодПолученияМетрикиПоКоду(Метрика) = Перечисления.пэмМетодыПолученияМетрик.Push Тогда
		ОтправитьМетрикиНаPushgateway(Итоги.Метрики);
	КонецЕсли;

КонецПроцедуры

// Отправляет рассчитанные метрики на Pushgateway. Неуспешная доставка регламентное задание
// не прерывает: её причина записывается в журнал регистрации, а следующая попытка приходится
// на следующий запуск задания.
//
// Параметры:
//   Метрики - Строка - текст метрик в формате экспозиции Prometheus
//
Процедура ОтправитьМетрикиНаPushgateway(Метрики) Экспорт

	Если НЕ пэмМетрикиСерверПовтИсп.РазрешеноИспользованиеМетодаPush() Тогда
		Возврат;
	КонецЕсли;

	// Пустое тело удаляет ранее опубликованную на Pushgateway группу метрик, что для потребителя
	// неотличимо от исчезновения источника данных.
	Если НЕ ЗначениеЗаполнено(Метрики) Тогда
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Информация,
			"Отправка на Pushgateway не выполнена: расчёт не дал ни одной метрики");
		Возврат;
	КонецЕсли;

	АдресСервера = Константы.пэмАдресСервераPushgateway.Получить();
	ПутьНаСервере = Константы.пэмПутьНаСервереPushgateway.Получить();

	НезаполненнаяКонстанта = НезаполненнаяНастройкаPushgateway(АдресСервера, ПутьНаСервере);
	Если НЕ ПустаяСтрока(НезаполненнаяКонстанта) Тогда
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка,
			"Отправка на Pushgateway не выполнена: не заполнена константа " + НезаполненнаяКонстанта);
		Возврат;
	КонецЕсли;

	ПортСервера = Константы.пэмПортСервераPushgateway.Получить();
	АдресНазначения = СтрШаблон("%1:%2%3", АдресСервера, Формат(ПортСервера, "ЧГ=0"), ПутьНаСервере);

	HTTPЗапрос = Новый HTTPЗапрос(ПутьНаСервере);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", ТипСодержимогоМетрик());
	HTTPЗапрос.УстановитьТелоИзСтроки(Метрики, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		HTTPСоединение = Новый HTTPСоединение(АдресСервера, ПортСервера, , , ,
			ТаймаутСоединенияPushgateway());
		РезультатОтправки = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	Исключение
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, СтрШаблон(
			"Метрики не отправлены на Pushgateway %1. %2", АдресНазначения, ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	Если ДоставкаНаPushgatewayУспешна(РезультатОтправки.КодСостояния) Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, СтрШаблон(
		"Pushgateway %1 не принял метрики. Код состояния %2. Тело ответа: %3",
		АдресНазначения, Формат(РезультатОтправки.КодСостояния, "ЧГ=0"),
		РезультатОтправки.ПолучитьТелоКакСтроку()));

КонецПроцедуры

// Приёмом метрик Pushgateway отвечает кодом 200 при немедленной записи и кодом 202
// при отложенной. Любой иной код состояния, включая перенаправления, означает,
// что метрики не приняты.
//
// Параметры:
//   КодСостояния - Число - код состояния ответа Pushgateway
//
// Возвращаемое значение:
//   Булево - Истина, если метрики приняты
//
Функция ДоставкаНаPushgatewayУспешна(КодСостояния) Экспорт

	Возврат КодСостояния = 200 ИЛИ КодСостояния = 202;

КонецФункции

// Возвращает тайм-аут соединения с Pushgateway. Тайм-аут ограничивает время, на которое
// недоступный сервер удерживает регламентное задание, поэтому его согласуют с интервалом
// запуска задания.
//
// Возвращаемое значение:
//   Число - тайм-аут соединения, секунд
//
Функция ТаймаутСоединенияPushgateway() Экспорт

	Таймаут = Константы.пэмТаймаутСоединенияPushgateway.Получить();

	Возврат ?(Таймаут > 0, Таймаут, ТаймаутСоединенияPushgatewayПоУмолчанию());

КонецФункции

// Возвращает тайм-аут соединения с Pushgateway, применяемый при незаполненной константе.
//
// Возвращаемое значение:
//   Число - тайм-аут соединения, секунд
//
Функция ТаймаутСоединенияPushgatewayПоУмолчанию() Экспорт

	Возврат 30;

КонецФункции

// Возвращает имя незаполненной константы, без которой отправка на Pushgateway невозможна.
//
// Параметры:
//   АдресСервера - Строка - значение константы пэмАдресСервераPushgateway
//   ПутьНаСервере - Строка - значение константы пэмПутьНаСервереPushgateway
//
// Возвращаемое значение:
//   Строка - имя незаполненной константы; пустая строка, если заполнены обе
//
Функция НезаполненнаяНастройкаPushgateway(АдресСервера, ПутьНаСервере) Экспорт

	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		Возврат "пэмАдресСервераPushgateway";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПутьНаСервере) Тогда
		Возврат "пэмПутьНаСервереPushgateway";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область Pull

// Формирует ответ HTTP-сервиса на опрос Prometheus.
// Успешно сформированный ответ имеет код 200 независимо от того, дала ли хотя бы одна метрика
// строку значения: успешным опросом Prometheus считает только код 200, а любой иной код
// обнуляет показатель up цели и делает базу без данных неотличимой от остановленного сервера.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ на опрос
//
Функция ОтветНаОпрос() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Итоги = ПолучитьМетрики(Перечисления.пэмМетодыПолученияМетрик.Pull, Неопределено);
	УстановитьПривилегированныйРежим(Ложь);

	Если Итоги.ЧислоРассчитанных = 0 И Итоги.ОшибкиРасчета.Количество() > 0 Тогда
		Возврат ОтветМетрик(500, СтрСоединить(Итоги.ОшибкиРасчета, Символы.ПС));
	КонецЕсли;

	Возврат ОтветМетрик(200,
		Итоги.Метрики + ТекстМетрикиОшибокРасчета(Итоги.ОшибкиРасчета.Количество()));

КонецФункции

#КонецОбласти


#Область Формирование_метрик

// Формирует текст метрик в формате экспозиции Prometheus.
//
// Параметры:
//   МетодПолученияМетрики - ПеречислениеСсылка.пэмМетодыПолученияМетрик, Неопределено - отбор
//       метрик по методу получения; Неопределено отменяет отбор по методу получения
//   Метрика - Строка, Неопределено - код единственной рассчитываемой метрики;
//       Неопределено означает общий цикл расчёта
//
// Возвращаемое значение:
//   Структура - итоги расчёта, см. НовыеИтогиРасчетаМетрик
//
Функция ПолучитьМетрики(МетодПолученияМетрики, Метрика) Экспорт

	Итоги = НовыеИтогиРасчетаМетрик();

	// Метрика Pull с персональным расписанием входит в ответ на опрос сохранённым значением:
	// момент её расчёта определяет расписание, а повторный расчёт при опросе удвоил бы нагрузку.
	Если Метрика = Неопределено И МетодПолученияМетрики = Перечисления.пэмМетодыПолученияМетрик.Pull Тогда
		ДобавитьЗначенияМетрикПерсональногоРасписания(Итоги);
	КонецЕсли;

	Выборка = ВыборкаРассчитываемыхМетрик(МетодПолученияМетрики, Метрика);

	Если Константы.пэмМногопоточныйРасчетМетрик.Получить() Тогда
		СформироватьМетрикиАсинхронно(Выборка, Итоги);
	Иначе
		СформироватьМетрикиСинхронно(Выборка, Итоги);
	КонецЕсли;

	Возврат Итоги;

КонецФункции

// Возвращает выборку метрик, подлежащих расчёту.
// Общий цикл исключает метрики с персональным расписанием: их рассчитывает персональное задание.
// Персональное задание отбирает свою метрику по коду независимо от метода её получения:
// метод получения определяет, куда доставляется результат, а не нужно ли его рассчитывать.
//
// Параметры:
//   МетодПолученияМетрики - ПеречислениеСсылка.пэмМетодыПолученияМетрик, Неопределено - метод получения
//   Метрика - Строка, Неопределено - код метрики персонального задания
//
// Возвращаемое значение:
//   ВыборкаИзРезультатаЗапроса - описания рассчитываемых метрик; поле СохранятьЗначение
//       повторяет условие отбора читателя сохранённых значений и отмечает метрику Pull
//       с персональным расписанием, значение которой выдаст следующий опрос
//
Функция ВыборкаРассчитываемыхМетрик(МетодПолученияМетрики, Метрика)

	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	пэмМетрики.Код КАК ИмяМетрики,
	|	пэмМетрики.Наименование КАК ПояснениеМетрики,
	|	пэмМетрики.Алгоритм КАК Алгоритм,
	|	пэмМетрики.ТипМетрики КАК ТипМетрики,
	|	пэмМетрики.Ссылка КАК Метрика,
	|	ВЫБОР
	|		КОГДА пэмМетрики.ИдентификаторРегламента <> &ПустойИдентификатор
	|				И пэмМетрики.МетодПолученияМетрики = ЗНАЧЕНИЕ(Перечисление.пэмМетодыПолученияМетрик.Pull)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СохранятьЗначение
	|ИЗ
	|	Справочник.пэмМетрики КАК пэмМетрики
	|ГДЕ
	|	пэмМетрики.Активность = ИСТИНА
	|	И %1";

	Если Метрика = Неопределено Тогда
		УсловиеОтбора = "пэмМетрики.МетодПолученияМетрики = &МетодПолученияМетрики
						|	И пэмМетрики.ИдентификаторРегламента = &ПустойИдентификатор";
	Иначе
		УсловиеОтбора = "пэмМетрики.Код = &КодМетрики";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(ШаблонЗапроса, УсловиеОтбора);
	Запрос.УстановитьПараметр("КодМетрики", Метрика);
	Запрос.УстановитьПараметр("МетодПолученияМетрики", МетодПолученияМетрики);
	Запрос.УстановитьПараметр("ПустойИдентификатор", ПустойИдентификаторРегламента());

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

// Дополняет итоги значениями метрик Pull, рассчитанных персональными регламентными заданиями.
// Метрика, которую персональное задание ещё не рассчитывало, в ответ не попадает: выдать
// вместо её значения ноль означало бы показать потребителю не наблюдение, а домысел.
//
// Параметры:
//   Итоги - Структура - итоги расчёта, см. НовыеИтогиРасчетаМетрик
//
Процедура ДобавитьЗначенияМетрикПерсональногоРасписания(Итоги)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пэмМетрики.Код КАК ИмяМетрики,
	|	пэмСостояниеМетрик.ТекстМетрики КАК ТекстМетрики
	|ИЗ
	|	Справочник.пэмМетрики КАК пэмМетрики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.пэмСостояниеМетрик КАК пэмСостояниеМетрик
	|		ПО пэмМетрики.Ссылка = пэмСостояниеМетрик.Метрика
	|ГДЕ
	|	пэмМетрики.Активность = ИСТИНА
	|	И пэмМетрики.МетодПолученияМетрики = ЗНАЧЕНИЕ(Перечисление.пэмМетодыПолученияМетрик.Pull)
	|	И пэмМетрики.ИдентификаторРегламента <> &ПустойИдентификатор";
	Запрос.УстановитьПараметр("ПустойИдентификатор", ПустойИдентификаторРегламента());

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Выборка.ТекстМетрики) Тогда
			ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Информация, "Метрика " + Выборка.ИмяМетрики
				+ ": персональное регламентное задание ещё не рассчитало значение");
			Продолжить;
		КонецЕсли;

		ДобавитьРассчитаннуюМетрику(Итоги, Выборка.ТекстМетрики);

	КонецЦикла;

КонецПроцедуры

Процедура СформироватьМетрикиАсинхронно(Выборка, Итоги)

	ОграничениеВремени = ОграничениеВремениФормированияОтвета();
	РазмерПорции = ЧислоОдновременныхЗаданийРасчетаМетрик();

	Порция = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Если ВремяФормированияОтветаИстекло(ОграничениеВремени) Тогда
			ЗаписатьПропускМетрики(Выборка.ИмяМетрики, ОграничениеВремени);
			Продолжить;
		КонецЕсли;

		Порция.Добавить(ЗапуститьРасчетМетрикиФоновымЗаданием(Выборка));

		Если Порция.Количество() = РазмерПорции Тогда
			ДополнитьИтогиРасчета(Итоги, ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени));
			Порция.Очистить();
		КонецЕсли;

	КонецЦикла;

	ДополнитьИтогиРасчета(Итоги, ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени));

КонецПроцедуры

Процедура СформироватьМетрикиСинхронно(Выборка, Итоги)

	ОграничениеВремени = ОграничениеВремениФормированияОтвета();

	Пока Выборка.Следующий() Цикл

		Если ВремяФормированияОтветаИстекло(ОграничениеВремени) Тогда
			ЗаписатьПропускМетрики(Выборка.ИмяМетрики, ОграничениеВремени);
			Продолжить;
		КонецЕсли;

		МоментНачалаРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();

		сткВозврат = СформироватьМетрику(Выборка.Алгоритм);
		Если НЕ сткВозврат.Ошибка Тогда
			сткВозврат = ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(Выборка.ИмяМетрики, Выборка.ТипМетрики,
				сткВозврат.МетрикаТаблицей, Выборка.ПояснениеМетрики);
		КонецЕсли;

		Если сткВозврат.Ошибка Тогда
			Итоги.ОшибкиРасчета.Добавить(сткВозврат.ОписаниеОшибки);
			Продолжить;
		КонецЕсли;

		ДобавитьРассчитаннуюМетрику(Итоги, сткВозврат.МетрикаСтрокой);
		ЗаписатьСостояниеРасчетаМетрики(Выборка.Метрика, Выборка.ИмяМетрики, МоментНачалаРасчета,
			?(Выборка.СохранятьЗначение, сткВозврат.МетрикаСтрокой, ""));

	КонецЦикла;

КонецПроцедуры

Процедура СформироватьМетрикуФоновымЗаданием(ИмяМетрики, ТипМетрики, Алгоритм, ИдентификаторХранилища,
	Метрика, ПояснениеМетрики = "", СохранятьЗначение = Ложь) Экспорт

	МоментНачалаРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();

	сткВозврат = СформироватьМетрику(Алгоритм);
	Если НЕ сткВозврат.Ошибка Тогда
		сткВозврат = ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики,
			сткВозврат.МетрикаТаблицей, ПояснениеМетрики);
	КонецЕсли;

	ПоместитьВоВременноеХранилище(сткВозврат, ИдентификаторХранилища);

	Если НЕ сткВозврат.Ошибка Тогда
		ЗаписатьСостояниеРасчетаМетрики(Метрика, ИмяМетрики, МоментНачалаРасчета,
			?(СохранятьЗначение, сткВозврат.МетрикаСтрокой, ""));
	КонецЕсли;

КонецПроцедуры

// Запускает расчёт метрики фоновым заданием, поместив во временное хранилище пустое значение,
// которое фоновое задание заменит результатом расчёта.
//
// Параметры:
//   Выборка - ВыборкаИзРезультатаЗапроса - текущая строка выборки метрик
//
// Возвращаемое значение:
//   Структура:
//     * ИмяМетрики - Строка - код метрики
//     * АдресВХранилище - Строка - адрес значения с результатом расчёта во временном хранилище
//     * ФоновоеЗадание - ФоновоеЗадание - запущенное задание расчёта
//
Функция ЗапуститьРасчетМетрикиФоновымЗаданием(Выборка)

	АдресВХранилище = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);

	ПараметрыРасчета = Новый Массив;
	ПараметрыРасчета.Добавить(Выборка.ИмяМетрики);
	ПараметрыРасчета.Добавить(Выборка.ТипМетрики);
	ПараметрыРасчета.Добавить(Выборка.Алгоритм);
	ПараметрыРасчета.Добавить(АдресВХранилище);
	ПараметрыРасчета.Добавить(Выборка.Метрика);
	ПараметрыРасчета.Добавить(Выборка.ПояснениеМетрики);
	ПараметрыРасчета.Добавить(Выборка.СохранятьЗначение);

	// Ключ задания отделён от адреса хранилища: адрес нужен основному потоку до освобождения
	// значения, а ключ обязан быть уникальным среди одновременно выполняющихся заданий метода.
	КлючЗадания = Выборка.ИмяМетрики + " " + Строка(Новый УникальныйИдентификатор);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("пэмМетрикиСервер.СформироватьМетрикуФоновымЗаданием",
		ПараметрыРасчета, КлючЗадания);

	Возврат Новый Структура("ИмяМетрики, АдресВХранилище, ФоновоеЗадание",
		Выборка.ИмяМетрики, АдресВХранилище, ФоновоеЗадание);

КонецФункции

// Дожидается завершения порции расчётов в пределах отведённого времени и собирает их результаты.
// Значение во временном хранилище освобождается независимо от исхода расчёта.
//
// Параметры:
//   Порция - Массив из Структура - запущенные расчёты метрик:
//     * ИмяМетрики - Строка - код метрики
//     * АдресВХранилище - Строка - адрес значения с результатом расчёта во временном хранилище
//     * ФоновоеЗадание - ФоновоеЗадание - задание расчёта
//   ОграничениеВремени - Структура - ограничение времени формирования ответа,
//                                    см. ОграничениеВремениФормированияОтвета
//
// Возвращаемое значение:
//   Структура - итоги расчёта порции, см. НовыеИтогиРасчетаМетрик
//
Функция ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени) Экспорт

	ОжидатьЗавершенияРасчетов(Порция, ОграничениеВремени);

	Итоги = НовыеИтогиРасчетаМетрик();

	Для Каждого Расчет Из Порция Цикл

		Если РасчетНеЗавершен(Расчет) Тогда
			ОтменитьРасчетМетрики(Расчет);
			ЗаписатьПропускМетрики(Расчет.ИмяМетрики, ОграничениеВремени);
		Иначе
			ДобавитьРезультатРасчета(Итоги, Расчет);
		КонецЕсли;

		УдалитьИзВременногоХранилища(Расчет.АдресВХранилище);

	КонецЦикла;

	Возврат Итоги;

КонецФункции

Процедура ОжидатьЗавершенияРасчетов(Порция, ОграничениеВремени)

	ОставшеесяВремя = ОставшеесяВремяФормированияОтветаВСекундах(ОграничениеВремени);
	Если НЕ Порция.Количество() Или ОставшеесяВремя <= 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаданияРасчета = Новый Массив;
	Для Каждого Расчет Из Порция Цикл
		ЗаданияРасчета.Добавить(Расчет.ФоновоеЗадание);
	КонецЦикла;

	ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ЗаданияРасчета, ОставшеесяВремя);

КонецПроцедуры

// Возвращает признак того, что расчёт метрики к этому моменту не завершён.
// Задание, вытесненное из списка заданий, считается завершившимся: сведений о его состоянии
// больше нет, а результат расчёта, если он был получен, уже лежит во временном хранилище.
//
// Параметры:
//   Расчет - Структура - запущенный расчёт метрики
//
// Возвращаемое значение:
//   Булево - Истина, если задание расчёта продолжает выполняться
//
Функция РасчетНеЗавершен(Расчет)

	СостояниеЗадания = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Расчет.ФоновоеЗадание.УникальныйИдентификатор);

	Если СостояниеЗадания = Неопределено Тогда
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": фоновое задание расчёта отсутствует в списке заданий, расчёт считается завершённым";
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);
		Возврат Ложь;
	КонецЕсли;

	Возврат СостояниеЗадания.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

Процедура ОтменитьРасчетМетрики(Расчет)

	Попытка
		Расчет.ФоновоеЗадание.Отменить();
	Исключение
		Комментарий = "Метрика " + Расчет.ИмяМетрики + ": не удалось отменить фоновое задание расчёта. "
			+ ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);
	КонецПопытки;

КонецПроцедуры

// Переносит результат расчёта метрики фоновым заданием в итоги расчёта.
//
// Параметры:
//   Итоги - Структура - итоги расчёта, см. НовыеИтогиРасчетаМетрик
//   Расчет - Структура - запущенный расчёт метрики
//
Процедура ДобавитьРезультатРасчета(Итоги, Расчет)

	Попытка
		РезультатРасчета = ПолучитьИзВременногоХранилища(Расчет.АдресВХранилище);
	Исключение
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": не удалось получить результат расчёта из временного хранилища. " + ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
		Итоги.ОшибкиРасчета.Добавить(Комментарий);
		Возврат;
	КонецПопытки;

	Если ТипЗнч(РезультатРасчета) <> Тип("Структура") Тогда
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": фоновое задание расчёта завершилось, не поместив результат во временное хранилище";
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
		Итоги.ОшибкиРасчета.Добавить(Комментарий);
		Возврат;
	КонецЕсли;

	Если РезультатРасчета.Ошибка Тогда
		Итоги.ОшибкиРасчета.Добавить(РезультатРасчета.ОписаниеОшибки);
		Возврат;
	КонецЕсли;

	ДобавитьРассчитаннуюМетрику(Итоги, РезультатРасчета.МетрикаСтрокой);

КонецПроцедуры

// Возвращает пустые итоги расчёта метрик.
//
// Возвращаемое значение:
//   Структура:
//     * Метрики - Строка - текст рассчитанных метрик в формате экспозиции Prometheus
//     * ЧислоРассчитанных - Число - число метрик, вошедших в текст
//     * ОшибкиРасчета - Массив из Строка - описания ошибок расчёта, по одному на метрику
//
Функция НовыеИтогиРасчетаМетрик()

	Возврат Новый Структура("Метрики, ЧислоРассчитанных, ОшибкиРасчета", "", 0, Новый Массив);

КонецФункции

Процедура ДобавитьРассчитаннуюМетрику(Итоги, ТекстМетрики)

	Итоги.Метрики = Итоги.Метрики + ТекстМетрики;
	Итоги.ЧислоРассчитанных = Итоги.ЧислоРассчитанных + 1;

КонецПроцедуры

Процедура ДополнитьИтогиРасчета(Итоги, ИтогиЧасти)

	Итоги.Метрики = Итоги.Метрики + ИтогиЧасти.Метрики;
	Итоги.ЧислоРассчитанных = Итоги.ЧислоРассчитанных + ИтогиЧасти.ЧислоРассчитанных;

	Для Каждого ОписаниеОшибки Из ИтогиЧасти.ОшибкиРасчета Цикл
		Итоги.ОшибкиРасчета.Добавить(ОписаниеОшибки);
	КонецЦикла;

КонецПроцедуры

// Возвращает ограничение времени формирования ответа с метриками.
//
// Возвращаемое значение:
//   Структура:
//     * МоментНачала - Число - момент начала формирования ответа, миллисекунды
//     * ОтведенноеВремя - Число - отведённое на формирование ответа время, миллисекунды
//     * МоментЗавершения - Число - момент, начиная с которого расчёт метрик прекращается, миллисекунды
//
Функция ОграничениеВремениФормированияОтвета()

	МиллисекундВСекунде = 1000;

	ОтведенноеВремяВСекундах = Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Получить();
	Если ОтведенноеВремяВСекундах <= 0 Тогда
		// Незаполненная константа означает 10 секунд: рекомендованное документацией
		// значение параметра опроса scrape_timeout.
		ОтведенноеВремяВСекундах = 10;
	КонецЕсли;

	ОтведенноеВремя = ОтведенноеВремяВСекундах * МиллисекундВСекунде;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Возврат Новый Структура("МоментНачала, ОтведенноеВремя, МоментЗавершения",
		МоментНачала, ОтведенноеВремя, МоментНачала + ОтведенноеВремя);

КонецФункции

Функция ЧислоОдновременныхЗаданийРасчетаМетрик()

	ЧислоЗаданий = Константы.пэмЧислоОдновременныхЗаданийРасчетаМетрик.Получить();
	Если ЧислоЗаданий <= 0 Тогда
		ЧислоЗаданий = 4; // Незаполненная константа означает четыре одновременных задания.
	КонецЕсли;

	Возврат ЧислоЗаданий;

КонецФункции

// Возвращает значение по умолчанию и допустимый диапазон окна агрегации метрик длительности.
// Нижняя граница исключает окно, которое при рекомендованном интервале опроса 30 секунд
// систематически оказывается пустым; верхняя ограничивает время, в течение которого
// единичный выброс удерживает значения метрики на плато.
//
// Возвращаемое значение:
//   Структура:
//     * ПоУмолчанию - Число - окно, применяемое при незаполненной или недопустимой настройке, секунд
//     * Минимум - Число - нижняя граница допустимого диапазона, секунд
//     * Максимум - Число - верхняя граница допустимого диапазона, секунд
//
Функция ДопустимоеОкноАгрегацииМетрикДлительности() Экспорт

	Возврат Новый Структура("ПоУмолчанию, Минимум, Максимум", 300, 60, 3600);

КонецФункции

// Возвращает общее окно агрегации метрик длительности. Значение читается при каждом расчёте:
// изменённая настройка применяется со следующего расчёта без перезапуска сеансов.
// Недопустимая настройка расчёт не прерывает — потеря наблюдаемости хуже неточного окна.
//
// Возвращаемое значение:
//   Число - окно агрегации, секунд
//
Функция ОкноАгрегацииМетрикДлительностиСек() Экспорт

	ДопустимоеОкно = ДопустимоеОкноАгрегацииМетрикДлительности();
	Окно = Константы.пэмОкноАгрегацииМетрикДлительностиСек.Получить();

	Если Окно >= ДопустимоеОкно.Минимум И Окно <= ДопустимоеОкно.Максимум Тогда
		Возврат Окно;
	КонецЕсли;

	ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение,
		"Окно агрегации метрик длительности " + Формат(Окно, "ЧГ=0") + " с вне допустимого диапазона от "
		+ Формат(ДопустимоеОкно.Минимум, "ЧГ=0") + " до " + Формат(ДопустимоеОкно.Максимум, "ЧГ=0")
		+ " с, применено " + Формат(ДопустимоеОкно.ПоУмолчанию, "ЧГ=0") + " с");

	Возврат ДопустимоеОкно.ПоУмолчанию;

КонецФункции

Функция ВремяФормированияОтветаИстекло(ОграничениеВремени)

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() >= ОграничениеВремени.МоментЗавершения;

КонецФункции

Функция ОставшеесяВремяФормированияОтветаВСекундах(ОграничениеВремени)

	МиллисекундВСекунде = 1000;

	Возврат (ОграничениеВремени.МоментЗавершения - ТекущаяУниверсальнаяДатаВМиллисекундах())
		/ МиллисекундВСекунде;

КонецФункции

Процедура ЗаписатьПропускМетрики(ИмяМетрики, ОграничениеВремени)

	ЗатраченноеВремя = ТекущаяУниверсальнаяДатаВМиллисекундах() - ОграничениеВремени.МоментНачала;

	Комментарий = "Метрика " + ИмяМетрики + ": не включена в ответ, истекло отведённое время"
		+ " формирования ответа. Отведено " + Формат(ОграничениеВремени.ОтведенноеВремя, "ЧГ=0")
		+ " мс, затрачено " + Формат(ЗатраченноеВремя, "ЧГ=0") + " мс";

	ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);

КонецПроцедуры

Функция СформироватьМетрику(Алгоритм) Экспорт
	
	сткВозврат = Новый Структура;
	сткВозврат.Вставить("МетрикаТаблицей", Новый ТаблицаЗначений);
	сткВозврат.Вставить("ОписаниеОшибки", "");
	сткВозврат.Вставить("Ошибка", Ложь);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		Выполнить(Алгоритм);
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Prometheus data exporter",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки);
		сткВозврат.Ошибка = Истина;
		сткВозврат.ОписаниеОшибки = ОписаниеОшибки;
		Возврат сткВозврат;
	КонецПопытки;
	
	сткВозврат.МетрикаТаблицей = ТаблицаЗначений;
	
	Возврат сткВозврат;
		
КонецФункции

Функция ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики, МетрикаТаблицейЗначений,
	ПояснениеМетрики = "") Экспорт

	сткВозврат = Новый Структура();
	сткВозврат.Вставить("МетрикаСтрокой", "");
	сткВозврат.Вставить("Ошибка", Ложь);
	сткВозврат.Вставить("ОписаниеОшибки", "");

	НарушениеКонтракта = НайтиНарушениеКонтрактаМетрики(ТипМетрики, МетрикаТаблицейЗначений);
	Если НЕ ПустаяСтрока(НарушениеКонтракта) Тогда
		ЗарегистрироватьОшибкуРасчетаМетрики(сткВозврат, "Метрика " + ИмяМетрики + ": " + НарушениеКонтракта);
		Возврат сткВозврат;
	КонецЕсли;

	Если НЕ МетрикаТаблицейЗначений.Количество() Тогда
		ЗаписьЖурналаРегистрации("Prometheus data exporter",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Метрика " + ИмяМетрики + ": расчёт вернул пустой результат");
	КонецЕсли;

	Попытка
		сткВозврат.МетрикаСтрокой = СформироватьТекстМетрики(ИмяМетрики, ТипМетрики,
			МетрикаТаблицейЗначений, ПояснениеМетрики);
	Исключение
		ЗарегистрироватьОшибкуРасчетаМетрики(сткВозврат, ОписаниеОшибки());
	КонецПопытки;

	Возврат сткВозврат;

КонецФункции

// Записывает состояние расчёта метрики в регистр сведений пэмСостояниеМетрик.
// Вызывается в том же потоке, что и расчёт, но вне транзакции алгоритма метрики:
// транзакция расчёта всегда отменяется, и выполненная внутри неё запись была бы потеряна.
//
// Параметры:
//   Метрика - СправочникСсылка.пэмМетрики - рассчитанная метрика
//   ИмяМетрики - Строка - код метрики, используется в сообщении журнала регистрации
//   МоментНачалаРасчета - Число - момент начала расчёта, миллисекунды универсального времени
//   ТекстМетрики - Строка - текст рассчитанной метрики в формате экспозиции Prometheus;
//       заполняется только для метрики Pull с персональным расписанием, значение которой
//       выдаёт следующий опрос. Для остальных метрик текст хранить незачем: он перезаписывался
//       бы на каждом опросе и не читался бы никогда
//
Процедура ЗаписатьСостояниеРасчетаМетрики(Метрика, ИмяМетрики, МоментНачалаРасчета, ТекстМетрики)

	Попытка
		НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Метрика.Установить(Метрика);

		СостояниеРасчета = НаборЗаписей.Добавить();
		СостояниеРасчета.Метрика = Метрика;
		СостояниеРасчета.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаРасчета;
		СостояниеРасчета.ДатаРасчета = инт_ОбщегоНазначения.ВремяБазы();
		СостояниеРасчета.ТекстМетрики = ТекстМетрики;

		НаборЗаписей.Записать();
	Исключение
		Комментарий = "Метрика " + ИмяМетрики + ": не удалось записать состояние расчёта. "
			+ ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
	КонецПопытки;

КонецПроцедуры

// Удаляет запись состояния расчёта метрики. Каждое удаление выполняется отдельным набором
// записей: повторное использование объекта после удаления делает результат зависимым
// от состояния объекта между итерациями.
//
// Параметры:
//   Метрика - СправочникСсылка.пэмМетрики - метрика, состояние расчёта которой удаляется
//
Процедура УдалитьСостояниеРасчетаМетрики(Метрика)

	НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Метрика.Установить(Метрика);
	НаборЗаписей.Записать();

КонецПроцедуры

// Маска - текстовая строка. Допустимы следующие символы:
// . - любой символ
// + - один или более раз, пример ".+" - один или более любой символ.
// * - ноль или более раз, пример ".*" - любое количество любых символов (даже ни одного).
// [n-m] - символ от m до n. Например: [a-zA-Z_:]* - строка любой длины, состоящая из больших и маленьких латинских символов, знаков "_" и ":" , Еще пример: "[0-9]+" - одна или более цифр(а).
// \d - цифра, пример 
// \d+ - одна или более цифр(а).
// \D - не цифра.
// \s - пробельный символ - ТАБ, пробел, перенос строки, возврат каретки и т.п.
// \S - непробельный символ.
// \w - буква, цифра, подчеркивание.
// \W - не буква, не цифра и не подчеркивание соответственно.
// ^ - начало текста, например "^\d+" - строка начинается с цифры.
// $ - конец текста, например "\D+$" - строка заканчивается НЕ цифрой.
// {m,n} - шаблон для от m до n символов, например "\d{2,4}" - от двух до четырех цифр. Можно указать одну и всего цифру для строгого соответвия.
// \ - экранирует спецсимволы. Например, "\." - символ точки.
Функция ПроверитьСтрокуНаСоответствиеМаске(Строка, Маска) Экспорт
	
	сткВозврат = Новый Структура;
	сткВозврат.Вставить("ЕстьОшибка", Истина);
	сткВозврат.Вставить("ОписаниеОшибки", "Ошибка в коде");
	сткВозврат.Вставить("Результат", Неопределено);
		
    Чтение = Новый ЧтениеXML;
    Чтение.УстановитьСтроку(
                "<Model xmlns=""http://v8.1c.ru/8.1/xdto"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xsi:type=""Model"">
                |<package targetNamespace=""sample-my-package"">
                |<valueType name=""testtypes"" base=""xs:string"">
                |<pattern>" + Маска + "</pattern>
                |</valueType>
                |<objectType name=""TestObj"">
                |<property xmlns:d4p1=""sample-my-package"" name=""TestItem"" type=""d4p1:testtypes""/>
                |</objectType>
                |</package>
                |</Model>");

    Модель = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Попытка
    	МояФабрикаXDTO = Новый ФабрикаXDTO(Модель);
	Исключение
		сткВозврат.ЕстьОшибка = Истина;
		сткВозврат.ОписаниеОшибки = "Ошибка маски";
		Возврат сткВозврат;
	КонецПопытки;
		
    Пакет = МояФабрикаXDTO.Пакеты.Получить("sample-my-package");
    Тест = МояФабрикаXDTO.Создать(Пакет.Получить("TestObj"));

    Попытка
        Тест.TestItem = Строка;
    Исключение
        сткВозврат.ЕстьОшибка = Истина;
		сткВозврат.ОписаниеОшибки = "Строка не соответствует маске";
		сткВозврат.Результат = Ложь;
		Возврат сткВозврат;
	КонецПопытки;
	
	сткВозврат.ЕстьОшибка = Ложь;
	сткВозврат.ОписаниеОшибки = "";
	сткВозврат.Результат = Истина;
    Возврат сткВозврат;
   
КонецФункции

#КонецОбласти

#Область Служебный_программный_интерфейс

// Приводит настройки и состав рассчитываемых метрик к состоянию текущей версии конфигурации.
// Выполняется первоначальным заполнением и регламентными операциями: собственного механизма
// обработчиков обновления в конфигурации нет.
Процедура ВыполнитьОбновлениеИнформационнойБазы() Экспорт

	ЗаполнитьОкноАгрегацииМетрикДлительности();
	ПогаситьУпраздненныеМетрики();

КонецПроцедуры

Процедура ЗаполнитьОкноАгрегацииМетрикДлительности()

	Если ЗначениеЗаполнено(Константы.пэмОкноАгрегацииМетрикДлительностиСек.Получить()) Тогда
		Возврат;
	КонецЕсли;

	Константы.пэмОкноАгрегацииМетрикДлительностиСек.Установить(
		ДопустимоеОкноАгрегацииМетрикДлительности().ПоУмолчанию);

КонецПроцедуры

// Гасит метрики, упразднённые в конфигурации. Удаления макета и записи из индекса метрик
// для этого недостаточно: текст алгоритма и признак активности хранятся в элементе
// справочника, и метрика продолжила бы рассчитываться по сохранённому тексту.
Процедура ПогаситьУпраздненныеМетрики()

	Для Каждого КодМетрики Из УпраздненныеМетрики() Цикл

		ОписаниеМетрики = Справочники.пэмМетрики[КодМетрики].ПолучитьОбъект();
		Если ОписаниеМетрики = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ОписаниеМетрики.Активность И НЕ ЗначениеЗаполнено(ОписаниеМетрики.Алгоритм) Тогда
			Продолжить;
		КонецЕсли;

		ОписаниеМетрики.Активность = Ложь;
		ОписаниеМетрики.Алгоритм = "";
		ОписаниеМетрики.Записать();

	КонецЦикла;

КонецПроцедуры

// Возвращает коды упразднённых метрик. Предопределённые элементы этих метрик остаются
// в конфигурации: удаление превратило бы их в существующих базах в обычные элементы
// справочника, которые продолжили бы рассчитываться, уже не будучи видны в конфигурации.
//
// Возвращаемое значение:
//   Массив из Строка - имена предопределённых элементов справочника пэмМетрики
//
Функция УпраздненныеМетрики() Экспорт

	Коды = Новый Массив;
	Коды.Добавить("pde_sync_incoming_duration_seconds");
	Коды.Добавить("pde_messages_per_minute");
	Коды.Добавить("pde_error_count");
	Коды.Добавить("pde_retry_count");
	Коды.Добавить("pde_last_refresh");
	Коды.Добавить("pde_scrape_duration");

	Возврат Коды;

КонецФункции

// Возвращает условия отбора операций очередей для алгоритмов метрик, построенных на регистрах
// текущего статуса. Определение ожидающей выполнения операции едино для метрик pde_queue_length,
// pde_oldest_pending_age_seconds и pde_operations_awaiting_retry, а метрика
// pde_operations_awaiting_intervention отбирает операции по строгому отрицанию того же условия.
// Единый источник условий не даёт изменить определение в одной метрике, не изменив его в остальных.
//
// Условия рассчитаны на запрос, в котором регистр текущего статуса имеет псевдоним «Статус»,
// а справочник потоков данных - псевдоним «Поток». Псевдонимы входят в контракт: их изменение
// требует увеличить версию всех метрик очередей в индексе, иначе сохранённый в базе текст
// алгоритма перестанет соответствовать условиям.
//
// Возвращаемое значение:
//   Структура:
//     * Входящие - Структура - условия по регистру инт_ТекущийСтатусВходящихСообщений
//     * Исходящие - Структура - условия по регистру инт_ТекущийСтатусИсходящихСообщений
//     * Рассылка - Структура - условия по регистру инт_ТекущийСтатусРассылкиСообщений
//   Каждая из трёх структур:
//     * Ожидающие - Строка - операция ожидает выполнения
//     * Ошибочные - Строка - операция завершилась ошибкой
//     * ПопыткиОстались - Строка - подсистема возьмёт операцию в работу снова
//     * ПопыткиИсчерпаны - Строка - строгое отрицание условия ПопыткиОстались
//   Условия заключены в скобки, поэтому соединяются операторами без оглядки на приоритет.
//
Функция УсловияОтбораОперацийОчередей() Экспорт

	ПопыткиОбработки = ПопыткиОбработкиОстались();
	ПопыткиОтправки = ПопыткиОтправкиОстались();

	Входящие = УсловияОчереди(
		"Статус.СтатусСообщения = ЗНАЧЕНИЕ(Перечисление.инт_СтатусыВходящихСообщений.Новый)",
		"Статус.СтатусСообщения = ЗНАЧЕНИЕ(Перечисление.инт_СтатусыВходящихСообщений.ОшибкаОбработки)",
		ПопыткиОбработки);

	Исходящие = УсловияОчереди(
		"Статус.СтатусСообщения = ЗНАЧЕНИЕ(Перечисление.инт_СтатусыИсходящихСообщений.Новый)",
		"Статус.СтатусСообщения В (
		|		ЗНАЧЕНИЕ(Перечисление.инт_СтатусыИсходящихСообщений.ОшибкаФормирования),
		|		ЗНАЧЕНИЕ(Перечисление.инт_СтатусыИсходящихСообщений.ОшибкаОтправки))",
		ПопыткиОбработки);

	Рассылка = УсловияОчереди(
		"Статус.СтатусСообщения В (
		|		ЗНАЧЕНИЕ(Перечисление.инт_СтатусыРассылкиИсходящихСообщений.Новый),
		|		ЗНАЧЕНИЕ(Перечисление.инт_СтатусыРассылкиИсходящихСообщений.Сформирован),
		|		ЗНАЧЕНИЕ(Перечисление.инт_СтатусыРассылкиИсходящихСообщений.ВПроцессеОтправки))",
		"Статус.СтатусСообщения = ЗНАЧЕНИЕ(Перечисление.инт_СтатусыРассылкиИсходящихСообщений.ОшибкаОбработки)",
		ПопыткиОтправки);

	Возврат Новый Структура("Входящие, Исходящие, Рассылка", Входящие, Исходящие, Рассылка);

КонецФункции

Процедура ВыполнитьПервоначальноеЗаполнение() Экспорт

	ВыполнитьОбновлениеИнформационнойБазы();

	// Читаем индекс метрик из макета
	ИндексМетрик = ПолучитьИндексМетрикИзМакета();
	Если ИндексМетрик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЕстьОшибки = Ложь;
	МассивМетрикДляЗаписи = ПодготовитьМетрикиПоИндексу(ИндексМетрик, ЕстьОшибки);

	НачатьТранзакцию();
	Попытка
		Если НЕ ЕстьОшибки Тогда
			Константы.пэмПервоначальноеЗаполнениеВыполнено.Установить(Истина);
		КонецЕсли;
		Для Каждого Метрика Из МассивМетрикДляЗаписи Цикл
			Метрика.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Готовит объекты метрик к записи по описаниям из индекса метрик.
// Запись индекса, обработать которую не удалось, пропускается с сообщением в журнале
// регистрации; остальные записи индекса обрабатываются.
//
// Параметры:
//   ИндексМетрик - Массив из Структура - описания метрик из индекса
//   ЕстьОшибки - Булево - возвращаемый признак того, что хотя бы одна запись индекса пропущена
//
// Возвращаемое значение:
//   Массив из СправочникОбъект.пэмМетрики - метрики, подготовленные к записи
//
Функция ПодготовитьМетрикиПоИндексу(ИндексМетрик, ЕстьОшибки) Экспорт

	ЕстьОшибки = Ложь;
	МетрикиДляЗаписи = Новый Массив;

	Для Каждого ОписаниеИзИндекса Из ИндексМетрик Цикл

		Попытка
			ОписаниеМетрики = ПодготовитьМетрикуПоОписаниюИзИндекса(ОписаниеИзИндекса);
		Исключение
			ЕстьОшибки = Истина;
			ЗаписьЖурналаРегистрации("Prometheus data exporter",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если ОписаниеМетрики <> Неопределено Тогда
			МетрикиДляЗаписи.Добавить(ОписаниеМетрики);
		КонецЕсли;

	КонецЦикла;

	Возврат МетрикиДляЗаписи;

КонецФункции

// Готовит объект метрики по описанию из индекса метрик.
//
// Параметры:
//   ОписаниеИзИндекса - Структура - описание метрики из индекса
//
// Возвращаемое значение:
//   СправочникОбъект.пэмМетрики, Неопределено - Неопределено, если запись индекса
//                                               не требует обновления метрики
//
Функция ПодготовитьМетрикуПоОписаниюИзИндекса(ОписаниеИзИндекса)

	КодМетрики = ОписаниеИзИндекса.код;
	ПредопределенныйЭлемент = Справочники.пэмМетрики[КодМетрики];

	Если ПредопределенныйЭлемент.Пустая() Тогда
		Возврат Неопределено; // Предопределённый элемент не найден
	КонецЕсли;

	ОписаниеМетрики = ПредопределенныйЭлемент.ПолучитьОбъект();

	// Обновляем только если версия в макете выше
	НоваяВерсия = ОписаниеИзИндекса.версия;
	Если ОписаниеМетрики.Версия >= НоваяВерсия И ЗначениеЗаполнено(ОписаниеМетрики.Алгоритм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Алгоритм = ПолучитьАлгоритмМетрикиИзМакета(ОписаниеИзИндекса.макет);
	Если НЕ ЗначениеЗаполнено(Алгоритм) Тогда
		Возврат Неопределено; // Макет не найден или пустой
	КонецЕсли;

	ТипМетрики = ПолучитьТипМетрикиПоИмени(ОписаниеИзИндекса.типМетрики);
	Если ТипМетрики = Неопределено Тогда
		ВызватьИсключение "Метрика " + КодМетрики + ": недопустимое значение типа метрики """
			+ ОписаниеИзИндекса.типМетрики + """";
	КонецЕсли;

	МетодПолученияМетрики = ПолучитьМетодПолученияПоИмени(ОписаниеИзИндекса.методПолучения);
	Если МетодПолученияМетрики = Неопределено Тогда
		ВызватьИсключение "Метрика " + КодМетрики + ": недопустимое значение метода получения """
			+ ОписаниеИзИндекса.методПолучения + """";
	КонецЕсли;

	ОписаниеМетрики.Наименование = ОписаниеИзИндекса.наименование;
	ОписаниеМетрики.ТипМетрики = ТипМетрики;
	ОписаниеМетрики.МетодПолученияМетрики = МетодПолученияМетрики;
	ОписаниеМетрики.Активность = ОписаниеИзИндекса.активность;
	ОписаниеМетрики.ИдентификаторРегламента = ПустойИдентификаторРегламента();
	ОписаниеМетрики.Алгоритм = Алгоритм;
	ОписаниеМетрики.Версия = НоваяВерсия;

	Возврат ОписаниеМетрики;

КонецФункции

// Получает индекс метрик из JSON-макета пэмМетрикиИндекс
//
// Возвращаемое значение:
//   Массив из Структура - массив описаний метрик из индекса, или Неопределено при ошибке
//
Функция ПолучитьИндексМетрикИзМакета()
	
	Попытка
		Макет = ПолучитьОбщийМакет("пэмМетрикиИндекс");
		ТекстJSON = Макет.ПолучитьТекст();
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь); // Ложь = читать в Структуру, не в Соответствие
		ЧтениеJSON.Закрыть();
		
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получает алгоритм метрики из текстового макета
//
// Параметры:
//   ИмяМакета - Строка - имя макета с алгоритмом
//
// Возвращаемое значение:
//   Строка - текст алгоритма BSL, или пустая строка при ошибке
//
Функция ПолучитьАлгоритмМетрикиИзМакета(ИмяМакета) Экспорт
	
	Попытка
		Макет = ПолучитьОбщийМакет(ИмяМакета);
		Возврат Макет.ПолучитьТекст();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Получает описание метрики из JSON-индекса макета по коду метрики
//
// Параметры:
//   КодМетрики - Строка - код метрики (например, "pde_queue_length")
//
// Возвращаемое значение:
//   Структура, Неопределено - описание метрики из индекса или Неопределено если не найдена
//
Функция ПолучитьОписаниеМетрикиИзМакета(КодМетрики) Экспорт
	
	ИндексМетрик = ПолучитьИндексМетрикИзМакета();
	Если ИндексМетрик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ОписаниеМетрики Из ИндексМетрик Цикл
		Если ОписаниеМетрики.код = КодМетрики Тогда
			Возврат ОписаниеМетрики;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает значение перечисления типа метрики по строковому имени
//
// Параметры:
//   ИмяТипа - Строка - имя типа: "Gauge", "Counter", "Histogram", "Summary"
//
// Возвращаемое значение:
//   ПеречислениеСсылка.пэмТипыМетрик, Неопределено - значение перечисления,
//       Неопределено, если имя типа недопустимо
//
Функция ПолучитьТипМетрикиПоИмени(ИмяТипа) Экспорт

	Если ИмяТипа = "Gauge" Тогда
		Возврат Перечисления.пэмТипыМетрик.Gauge;
	ИначеЕсли ИмяТипа = "Counter" Тогда
		Возврат Перечисления.пэмТипыМетрик.Counter;
	ИначеЕсли ИмяТипа = "Histogram" Тогда
		Возврат Перечисления.пэмТипыМетрик.Histogram;
	ИначеЕсли ИмяТипа = "Summary" Тогда
		Возврат Перечисления.пэмТипыМетрик.Summary;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает значение перечисления метода получения метрики по строковому имени
//
// Параметры:
//   ИмяМетода - Строка - имя метода: "Pull", "Push"
//
// Возвращаемое значение:
//   ПеречислениеСсылка.пэмМетодыПолученияМетрик, Неопределено - значение перечисления,
//       Неопределено, если имя метода недопустимо
//
Функция ПолучитьМетодПолученияПоИмени(ИмяМетода) Экспорт

	Если ИмяМетода = "Pull" Тогда
		Возврат Перечисления.пэмМетодыПолученияМетрик.Pull;
	ИначеЕсли ИмяМетода = "Push" Тогда
		Возврат Перечисления.пэмМетодыПолученияМетрик.Push;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Процедура РегламентныеОперации() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ Константы.пэмПервоначальноеЗаполнениеВыполнено.Получить() Тогда
		ВыполнитьПервоначальноеЗаполнение();
	Иначе
		ВыполнитьОбновлениеИнформационнойБазы();
	КонецЕсли;

	УдалитьСостояниеРасчетаМетрики(Справочники.пэмМетрики.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	пэмСостояниеМетрик.Метрика КАК Метрика
	               |ИЗ
	               |	РегистрСведений.пэмСостояниеМетрик КАК пэмСостояниеМетрик
	               |ГДЕ
	               |	пэмСостояниеМетрик.Метрика.Активность = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УдалитьСостояниеРасчетаМетрики(Выборка.Метрика);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	           	
КонецПроцедуры

Функция ПолучитьПараметрыРегламентногоЗадания(Идентификатор = Неопределено) Экспорт

	ОписаниеРегламентногоЗадания = ПолучитьОписаниеПараметровРегламентногоЗадания();
	РегламентноеЗадание = ПолучитьРегламентноеЗаданиеПоИдентификатору(Идентификатор);
			
	ЗаполнитьЗначенияСвойств(ОписаниеРегламентногоЗадания, РегламентноеЗадание);
	          	
	Возврат ОписаниеРегламентногоЗадания;
	
КонецФункции

Процедура ОбновитьРегламентноеЗадание(ПараметрыРегламентногоЗадания) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если
		(ПараметрыРегламентногоЗадания.Предопределенное
		И ЗначениеЗаполнено(ПараметрыРегламентногоЗадания.УникальныйИдентификатор))
		ИЛИ
		(НЕ ПараметрыРегламентногоЗадания.Предопределенное
		И ЗначениеЗаполнено(ПараметрыРегламентногоЗадания.УникальныйИдентификатор)
		И НЕ ПараметрыРегламентногоЗадания.Использование)
		Тогда
		УдалитьРегламентноеЗаданиеПоИдентификатору(ПараметрыРегламентногоЗадания.УникальныйИдентификатор);
		ПараметрыРегламентногоЗадания.УникальныйИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	КонецЕсли;
	
	Если НЕ ПараметрыРегламентногоЗадания.Предопределенное И НЕ ПараметрыРегламентногоЗадания.Использование Тогда
		ПараметрыРегламентногоЗадания.УникальныйИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		Возврат;
	КонецЕсли;
				  
	Если ПараметрыРегламентногоЗадания.Предопределенное Тогда
		РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.пэмВыполнитьРасчетМетрик);
	Иначе
		Попытка
			РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(ПараметрыРегламентногоЗадания.УникальныйИдентификатор);
			Если РегламентноеЗадание.Предопределенное Тогда
				РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.пэмВыполнитьРасчетМетрик);
			КонецЕсли;
		Исключение
			РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.пэмВыполнитьРасчетМетрик);
		КонецПопытки;
	КонецЕсли;
		 			
	ЗаполнитьЗначенияСвойств(РегламентноеЗадание, ПараметрыРегламентногоЗадания,,"УникальныйИдентификатор");
	РегламентноеЗадание.Записать();
	
	Если ПараметрыРегламентногоЗадания.Предопределенное Тогда
		ПараметрыРегламентногоЗадания.УникальныйИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Иначе
		ПараметрыРегламентногоЗадания.УникальныйИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьРегламентноеЗаданиеПоИдентификатору(Идентификатор = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Попытка
			РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
		Исключение
			РегламентноеЗадание = РегламентныеЗадания.СоздатьРегламентноеЗадание(Метаданные.РегламентныеЗадания.пэмВыполнитьРасчетМетрик);
		КонецПопытки;
	Иначе
		РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.пэмВыполнитьРасчетМетрик);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РегламентноеЗадание;
	
КонецФункции

Функция УдалитьРегламентноеЗаданиеПоИдентификатору(Идентификатор)
	
	Результат = Ложь;
	
	Попытка
		РегламентноеЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Идентификатор);
		РегламентноеЗадание.Удалить();
		Результат = Истина;
	Исключение
		Результат = Истина;
	КонецПопытки;
	
	Возврат Результат;
	                  	
КонецФункции

#КонецОбласти

#Область Служебные_процедуры_и_функции

Функция ПолучитьОписаниеПараметровРегламентногоЗадания()
	
	сткПараметрыЗадания = Новый Структура;
	сткПараметрыЗадания.Вставить("Использование", Ложь);
	сткПараметрыЗадания.Вставить("Предопределенное", Ложь);
	сткПараметрыЗадания.Вставить("Расписание", Новый РасписаниеРегламентногоЗадания);
	сткПараметрыЗадания.Вставить("Наименование", "");
	сткПараметрыЗадания.Вставить("Ключ", "");
	сткПараметрыЗадания.Вставить("Параметры", Неопределено);
	сткПараметрыЗадания.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	  	
	Возврат сткПараметрыЗадания;

КонецФункции

Процедура ЗаписатьВЖурналМетрик(Уровень, Комментарий)

	ЗаписьЖурналаРегистрации("Prometheus data exporter", Уровень, , , Комментарий);

КонецПроцедуры

// Возвращает значение заголовка Content-Type для текстового формата экспозиции Prometheus.
// Значение общее для ответа на опрос и для запроса к Pushgateway: формат тела у них один,
// и расходиться в его объявлении два пути доставки не должны. Формат OpenMetrics
// заголовок не объявляет: разделитель меток ответа ему пока не соответствует.
//
// Возвращаемое значение:
//   Строка - значение заголовка Content-Type
//
Функция ТипСодержимогоМетрик() Экспорт

	Возврат "text/plain; version=0.0.4; charset=utf-8";

КонецФункции

// Возвращает ответ HTTP-сервиса с телом в текстовом формате экспозиции Prometheus.
//
// Параметры:
//   КодСостояния - Число - код состояния ответа
//   ТелоОтвета - Строка - тело ответа
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ HTTP-сервиса
//
Функция ОтветМетрик(КодСостояния, ТелоОтвета)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимогоМетрик());
	Ответ.УстановитьТелоИзСтроки(ЗавершитьПереводомСтроки(ТелоОтвета),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

// Формат экспозиции требует, чтобы последняя строка ответа была завершена переводом строки.
Функция ЗавершитьПереводомСтроки(Текст)

	Возврат ?(СтрЗаканчиваетсяНа(Текст, Символы.ПС), Текст, Текст + Символы.ПС);

КонецФункции

// Возвращает текст служебной метрики, показывающей число метрик, расчёт которых завершился
// ошибкой. Метрика выводится и при отсутствии ошибок: пропуск ряда потребитель не отличает
// от остановки сбора, а нулевое значение прямо говорит, что ответ полон.
//
// Параметры:
//   ЧислоОшибок - Число - число метрик, расчёт которых завершился ошибкой
//
// Возвращаемое значение:
//   Строка - текст метрики в формате экспозиции Prometheus
//
Функция ТекстМетрикиОшибокРасчета(ЧислоОшибок)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));
	Таблица.Добавить().value = ЧислоОшибок;

	сткВозврат = ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus("pde_metric_calculation_errors",
		Перечисления.пэмТипыМетрик.Gauge, Таблица, "Метрики, расчёт которых завершился ошибкой");

	Возврат сткВозврат.МетрикаСтрокой;

КонецФункции

// Возвращает метод получения метрики по её коду.
//
// Параметры:
//   КодМетрики - Строка - код метрики
//
// Возвращаемое значение:
//   ПеречислениеСсылка.пэмМетодыПолученияМетрик - метод получения; пустая ссылка,
//       если метрики с таким кодом нет
//
Функция МетодПолученияМетрикиПоКоду(КодМетрики)

	Возврат Справочники.пэмМетрики.НайтиПоКоду(КодМетрики).МетодПолученияМетрики;

КонецФункции

// Возвращает значение реквизита ИдентификаторРегламента метрики без персонального расписания.
//
// Возвращаемое значение:
//   УникальныйИдентификатор - пустой идентификатор регламентного задания
//
Функция ПустойИдентификаторРегламента()

	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");

КонецФункции


Процедура ЗарегистрироватьОшибкуРасчетаМетрики(сткВозврат, ОписаниеОшибки)

	ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, ОписаниеОшибки);

	сткВозврат.Ошибка = Истина;
	сткВозврат.ОписаниеОшибки = ОписаниеОшибки;

КонецПроцедуры

// Формирует текст метрики в текстовом формате экспозиции Prometheus.
//
// Параметры:
//   ИмяМетрики - Строка - базовое имя метрики
//   ТипМетрики - ПеречислениеСсылка.пэмТипыМетрик - объявленный тип метрики
//   Таблица - ТаблицаЗначений - результат расчёта метрики
//   ПояснениеМетрики - Строка - пояснение метрики; пустая строка отменяет вывод строки # HELP
//
// Возвращаемое значение:
//   Строка - строки пояснения, объявления типа и значений метрики
//
Функция СформироватьТекстМетрики(ИмяМетрики, ТипМетрики, Таблица, ПояснениеМетрики)

	Строки = Новый Массив;

	Если НЕ ПустаяСтрока(ПояснениеМетрики) Тогда
		Строки.Добавить("# HELP " + ИмяМетрики + " " + ЭкранироватьТекстЭкспозиции(ПояснениеМетрики));
	КонецЕсли;

	Если ЗначениеЗаполнено(ТипМетрики) Тогда
		Строки.Добавить("# TYPE " + ИмяМетрики + " " + ИмяТипаМетрикиВФорматеЭкспозиции(ТипМетрики));
	КонецЕсли;

	Если ТипМетрики = Перечисления.пэмТипыМетрик.Histogram Тогда
		ДобавитьСтрокиГистограммы(Строки, ИмяМетрики, Таблица);
	ИначеЕсли ТипМетрики = Перечисления.пэмТипыМетрик.Summary Тогда
		ДобавитьСтрокиСводки(Строки, ИмяМетрики, Таблица);
	Иначе
		ДобавитьСтрокиПростойМетрики(Строки, ИмяМетрики, ТипМетрики, Таблица);
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС) + Символы.ПС;

КонецФункции

// Возвращает имя типа метрики, допустимое в строке # TYPE формата экспозиции.
// Соответствие задаётся значением перечисления, а не синонимом из метаданных:
// синоним доступен для изменения администратором и формат ответа от него не зависит.
Функция ИмяТипаМетрикиВФорматеЭкспозиции(ТипМетрики)

	Если ТипМетрики = Перечисления.пэмТипыМетрик.Counter Тогда
		Возврат "counter";
	ИначеЕсли ТипМетрики = Перечисления.пэмТипыМетрик.Histogram Тогда
		Возврат "histogram";
	ИначеЕсли ТипМетрики = Перечисления.пэмТипыМетрик.Summary Тогда
		Возврат "summary";
	Иначе
		Возврат "gauge";
	КонецЕсли;

КонецФункции

Процедура ДобавитьСтрокиПростойМетрики(Строки, ИмяМетрики, ТипМетрики, Таблица)

	ИменаМеток = ИменаКолонокМеток(Таблица, ТипМетрики);

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики,
			МеткиСтрокой(СтрокаТаблицы, ИменаМеток), СтрокаТаблицы["value"]));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокиГистограммы(Строки, ИмяМетрики, Таблица)

	ИменаМеток = ИменаКолонокМеток(Таблица, Перечисления.пэмТипыМетрик.Histogram);

	Для Каждого Сочетание Из СочетанияМеток(Таблица, ИменаМеток) Цикл

		НакопленноеКоличество = 0;
		Для Каждого Корзина Из УпорядоченныеКорзины(Сочетание.Строки) Цикл
			НакопленноеКоличество = НакопленноеКоличество + Корзина.Значение;
			Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики + "_bucket",
				ДополнитьМетки(Сочетание.Метки, "le", Корзина.Граница), НакопленноеКоличество));
		КонецЦикла;

		Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики + "_sum",
			Сочетание.Метки, ЗначениеРядаСочетания(Сочетание.Строки, "sum")));
		Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики + "_count",
			Сочетание.Метки, НакопленноеКоличество));

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокиСводки(Строки, ИмяМетрики, Таблица)

	ИменаМеток = ИменаКолонокМеток(Таблица, Перечисления.пэмТипыМетрик.Summary);

	Для Каждого Сочетание Из СочетанияМеток(Таблица, ИменаМеток) Цикл

		Для Каждого Квантиль Из УпорядоченныеКвантили(Сочетание.Строки) Цикл
			Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики,
				ДополнитьМетки(Сочетание.Метки, "quantile", Квантиль.Уровень), Квантиль.Значение));
		КонецЦикла;

		Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики + "_sum",
			Сочетание.Метки, ЗначениеРядаСочетания(Сочетание.Строки, "sum")));
		Строки.Добавить(СтрокаЗначенияМетрики(ИмяМетрики + "_count",
			Сочетание.Метки, ЗначениеРядаСочетания(Сочетание.Строки, "count")));

	КонецЦикла;

КонецПроцедуры

// Возвращает имена колонок-меток таблицы расчёта: всех колонок, кроме value
// и служебных колонок объявленного типа метрики.
Функция ИменаКолонокМеток(Таблица, ТипМетрики)

	СлужебныеКолонки = СлужебныеКолонкиТипаМетрики(ТипМетрики);
	Имена = Новый Массив;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.Имя = "value" ИЛИ СлужебныеКолонки.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Возвращает имена служебных колонок таблицы расчёта, которые потребляются
// механизмом преобразования и метками в ответ не выводятся.
Функция СлужебныеКолонкиТипаМетрики(ТипМетрики)

	Колонки = Новый Массив;

	Если ТипМетрики = Перечисления.пэмТипыМетрик.Histogram Тогда
		Колонки.Добавить("__series");
		Колонки.Добавить("le");
	ИначеЕсли ТипМетрики = Перечисления.пэмТипыМетрик.Summary Тогда
		Колонки.Добавить("__series");
		Колонки.Добавить("quantile");
	КонецЕсли;

	Возврат Колонки;

КонецФункции

// Группирует строки таблицы расчёта по сочетанию значений колонок-меток
// с сохранением порядка появления сочетаний в таблице.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Метки - Строка - пары меток сочетания в формате экспозиции
//     * Строки - Массив из СтрокаТаблицыЗначений - строки таблицы этого сочетания
//
Функция СочетанияМеток(Таблица, ИменаМеток)

	Сочетания = Новый Массив;
	ИндексыСочетаний = Новый Соответствие;

	Для Каждого СтрокаТаблицы Из Таблица Цикл

		Метки = МеткиСтрокой(СтрокаТаблицы, ИменаМеток);
		Индекс = ИндексыСочетаний[Метки];

		Если Индекс = Неопределено Тогда
			Сочетание = Новый Структура("Метки, Строки", Метки, Новый Массив);
			Сочетания.Добавить(Сочетание);
			ИндексыСочетаний.Вставить(Метки, Сочетания.ВГраница());
		Иначе
			Сочетание = Сочетания[Индекс];
		КонецЕсли;

		Сочетание.Строки.Добавить(СтрокаТаблицы);

	КонецЦикла;

	Возврат Сочетания;

КонецФункции

Функция МеткиСтрокой(СтрокаТаблицы, ИменаМеток)

	Пары = Новый Массив;
	Для Каждого ИмяМетки Из ИменаМеток Цикл
		Пары.Добавить(ПараМетки(ИмяМетки, СтрокаТаблицы[ИмяМетки]));
	КонецЦикла;

	Возврат СтрСоединить(Пары, ",");

КонецФункции

Функция ДополнитьМетки(Метки, ИмяМетки, ЗначениеМетки)

	Пара = ПараМетки(ИмяМетки, ЗначениеМетки);
	Возврат ?(ПустаяСтрока(Метки), Пара, Метки + "," + Пара);

КонецФункции

Функция ПараМетки(ИмяМетки, ЗначениеМетки)

	Представление = ПредставлениеЗначенияМетки(ЗначениеМетки);

	Возврат ИмяМетки + "=""" + ЭкранироватьТекстЭкспозиции(Представление) + """";

КонецФункции

// Возвращает представление значения метки до экранирования.
// Значение NULL выводится пустой строкой: формат экспозиции текста NULL не допускает,
// а по смыслу такое значение неотличимо от незаполненного.
//
// Параметры:
//   ЗначениеМетки - Произвольный - значение колонки-метки строки таблицы расчёта
//
// Возвращаемое значение:
//   Строка - представление значения метки
//
Функция ПредставлениеЗначенияМетки(ЗначениеМетки)

	Возврат ?(ТипЗнч(ЗначениеМетки) = Тип("NULL"), "", Строка(ЗначениеМетки));

КонецФункции

// Экранирует текст по правилам текстового формата экспозиции. Возврат каретки удаляется:
// формат допускает только перевод строки, и то в экранированном виде.
//
// Параметры:
//   Текст - Строка - значение метки либо пояснение метрики
//
// Возвращаемое значение:
//   Строка - текст, пригодный для подстановки в ответ
//
Функция ЭкранироватьТекстЭкспозиции(Текст)

	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");

	Возврат СтрЗаменить(Результат, Символы.ПС, "\n");

КонецФункции

Функция СтрокаЗначенияМетрики(ИмяМетрики, Метки, Значение)

	Возврат ИмяМетрики + "{" + Метки + "} " + ЧисловоеЗначениеСтрокой(Значение);

КонецФункции

// Возвращает корзины сочетания меток, упорядоченные по возрастанию границы,
// с корзиной +Inf в конце.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Бесконечность - Булево - признак корзины с границей +Inf
//     * Порядок - Число - конечная граница корзины либо ноль для корзины +Inf
//     * Граница - Строка - представление границы для метки le
//     * Значение - Произвольный - ненакопленное количество наблюдений корзины
//
Функция УпорядоченныеКорзины(СтрокиСочетания)

	Корзины = Новый ТаблицаЗначений;
	Корзины.Колонки.Добавить("Бесконечность", Новый ОписаниеТипов("Булево"));
	Корзины.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Корзины.Колонки.Добавить("Граница", Новый ОписаниеТипов("Строка"));
	Корзины.Колонки.Добавить("Значение");

	Для Каждого СтрокаТаблицы Из СтрокиСочетания Цикл

		Если СтрокаТаблицы["__series"] <> "bucket" Тогда
			Продолжить;
		КонецЕсли;

		ГраницаКорзины = СтрокаТаблицы["le"];
		Корзина = Корзины.Добавить();
		Корзина.Бесконечность = ЭтоБесконечнаяГраница(ГраницаКорзины);
		Корзина.Порядок = ?(Корзина.Бесконечность, 0, ГраницаКорзины);
		Корзина.Граница = ПредставлениеГраницыКорзины(ГраницаКорзины);
		Корзина.Значение = СтрокаТаблицы["value"];

	КонецЦикла;

	Корзины.Сортировать("Бесконечность Возр, Порядок Возр");

	Возврат Корзины;

КонецФункции

// Возвращает квантили сочетания меток, упорядоченные по возрастанию уровня.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Порядок - Число - уровень квантиля
//     * Уровень - Строка - представление уровня для метки quantile
//     * Значение - Произвольный - значение наблюдения на этом уровне
//
Функция УпорядоченныеКвантили(СтрокиСочетания)

	Квантили = Новый ТаблицаЗначений;
	Квантили.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Квантили.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Строка"));
	Квантили.Колонки.Добавить("Значение");

	Для Каждого СтрокаТаблицы Из СтрокиСочетания Цикл

		Если СтрокаТаблицы["__series"] <> "quantile" Тогда
			Продолжить;
		КонецЕсли;

		Квантиль = Квантили.Добавить();
		Квантиль.Порядок = СтрокаТаблицы["quantile"];
		Квантиль.Уровень = ЧисловоеЗначениеСтрокой(СтрокаТаблицы["quantile"]);
		Квантиль.Значение = СтрокаТаблицы["value"];

	КонецЦикла;

	Квантили.Сортировать("Порядок Возр");

	Возврат Квантили;

КонецФункции

Функция ЗначениеРядаСочетания(СтрокиСочетания, ИмяРяда)

	Для Каждого СтрокаТаблицы Из СтрокиСочетания Цикл
		Если СтрокаТаблицы["__series"] = ИмяРяда Тогда
			Возврат СтрокаТаблицы["value"];
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция ЭтоБесконечнаяГраница(ГраницаКорзины)

	Возврат ТипЗнч(ГраницаКорзины) = Тип("Строка") И СокрЛП(ГраницаКорзины) = "+Inf";

КонецФункции

Функция ПредставлениеГраницыКорзины(ГраницаКорзины)

	Возврат ?(ЭтоБесконечнаяГраница(ГраницаКорзины), "+Inf", ЧисловоеЗначениеСтрокой(ГраницаКорзины));

КонецФункции

// Возвращает представление числа в формате экспозиции: точка как разделитель дробной части,
// без разделителей групп разрядов и без экспоненциальной записи. Целое значение выводится
// без дробной части, дробное округляется до микросекунд: этого хватает для длительностей
// в секундах и не отбрасывает значащих цифр у меток времени.
//
// Параметры:
//   Значение - Число - значение метрики, граница корзины либо уровень квантиля
//
// Возвращаемое значение:
//   Строка - представление числа
//
Функция ЧисловоеЗначениеСтрокой(Значение)

	ЗнаковДробнойЧасти = 6;

	Возврат Формат(Окр(Значение, ЗнаковДробнойЧасти), "ЧРД=.; ЧРГ=; ЧН=0; ЧГ=;");

КонецФункции

// Проверяет таблицу расчёта на соответствие объявленному типу метрики.
// Состав колонок проверяется независимо от числа строк таблицы.
//
// Параметры:
//   ТипМетрики - ПеречислениеСсылка.пэмТипыМетрик - объявленный тип метрики
//   Таблица - ТаблицаЗначений - результат расчёта метрики
//
// Возвращаемое значение:
//   Строка - описание нарушенного правила контракта либо пустая строка
//
Функция НайтиНарушениеКонтрактаМетрики(ТипМетрики, Таблица)

	Если Таблица.Колонки.Найти("value") = Неопределено Тогда
		Возврат "не содержит колонки value";
	КонецЕсли;

	Нарушение = НайтиНечисловоеЗначениеМетрики(Таблица);

	Если ПустаяСтрока(Нарушение) Тогда
		Нарушение = НайтиНарушениеКонтрактаТипаМетрики(ТипМетрики, Таблица);
	КонецЕсли;

	Если ПустаяСтрока(Нарушение) Тогда
		Нарушение = НайтиНедопустимоеИмяМетки(Таблица, ТипМетрики);
	КонецЕсли;

	Возврат Нарушение;

КонецФункции

Функция НайтиНарушениеКонтрактаТипаМетрики(ТипМетрики, Таблица)

	Если ТипМетрики = Перечисления.пэмТипыМетрик.Histogram Тогда
		Возврат НайтиНарушениеКонтрактаГистограммы(Таблица);
	КонецЕсли;

	Если ТипМетрики = Перечисления.пэмТипыМетрик.Summary Тогда
		Возврат НайтиНарушениеКонтрактаСводки(Таблица);
	КонецЕсли;

	Если Таблица.Колонки.Найти("__series") <> Неопределено Тогда
		Возврат "тип " + ИмяТипаМетрикиВФорматеЭкспозиции(ТипМетрики)
			+ " не допускает служебную колонку __series";
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение метрики выводится числом всегда: строка без числа обрывает набор меток,
// и Prometheus отбраковывает ответ целиком, а не отдельную строку.
//
// Параметры:
//   Таблица - ТаблицаЗначений - результат расчёта метрики
//
// Возвращаемое значение:
//   Строка - описание первой строки с нечисловым значением либо пустая строка
//
Функция НайтиНечисловоеЗначениеМетрики(Таблица)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ТипЗнч(СтрокаТаблицы["value"]) <> Тип("Число") Тогда
			Возврат "строка " + (Таблица.Индекс(СтрокаТаблицы) + 1)
				+ ": значение колонки value не является числом";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Имя метки берётся из имени колонки таблицы расчёта, которое в 1С допускает кириллицу,
// а формат экспозиции не допускает. Недопустимое имя выводит из строя весь ответ,
// поэтому метрика с таким именем метки не выводится.
//
// Параметры:
//   Таблица - ТаблицаЗначений - результат расчёта метрики
//   ТипМетрики - ПеречислениеСсылка.пэмТипыМетрик - объявленный тип метрики
//
// Возвращаемое значение:
//   Строка - описание первого недопустимого имени метки либо пустая строка
//
Функция НайтиНедопустимоеИмяМетки(Таблица, ТипМетрики)

	МаскаИмениМетки = "[a-zA-Z_][a-zA-Z0-9_]*";

	Для Каждого ИмяМетки Из ИменаКолонокМеток(Таблица, ТипМетрики) Цикл
		Если ПроверитьСтрокуНаСоответствиеМаске(ИмяМетки, МаскаИмениМетки).ЕстьОшибка Тогда
			Возврат "имя метки " + ИмяМетки + " не соответствует маске " + МаскаИмениМетки;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НайтиНарушениеКонтрактаГистограммы(Таблица)

	Нарушение = НайтиНедостающуюСлужебнуюКолонку(Таблица, Перечисления.пэмТипыМетрик.Histogram);
	Если НЕ ПустаяСтрока(Нарушение) Тогда
		Возврат Нарушение;
	КонецЕсли;

	ИменаМеток = ИменаКолонокМеток(Таблица, Перечисления.пэмТипыМетрик.Histogram);
	ЭталонныеГраницы = Неопределено;

	Для Каждого Сочетание Из СочетанияМеток(Таблица, ИменаМеток) Цикл

		Нарушение = НайтиНарушениеСтрокГистограммы(Сочетание.Строки);
		Если НЕ ПустаяСтрока(Нарушение) Тогда
			Возврат НарушениеСочетания(Сочетание, Нарушение);
		КонецЕсли;

		Границы = СтрСоединить(УпорядоченныеКорзины(Сочетание.Строки).ВыгрузитьКолонку("Граница"), " ");
		Если ЭталонныеГраницы = Неопределено Тогда
			ЭталонныеГраницы = Границы;
		ИначеЕсли Границы <> ЭталонныеГраницы Тогда
			Возврат НарушениеСочетания(Сочетание,
				"набор границ корзин в колонке le отличается от набора первого сочетания меток");
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

Функция НайтиНарушениеСтрокГистограммы(СтрокиСочетания)

	Границы = Новый Массив;
	ЕстьКорзинаБесконечности = Ложь;
	КоличествоСумм = 0;

	Для Каждого СтрокаТаблицы Из СтрокиСочетания Цикл

		Ряд = СтрокаТаблицы["__series"];

		Если Ряд = "sum" Тогда
			КоличествоСумм = КоличествоСумм + 1;
			Продолжить;
		КонецЕсли;

		Если Ряд <> "bucket" Тогда
			Возврат "недопустимое значение колонки __series: """ + Строка(Ряд) + """";
		КонецЕсли;

		ГраницаКорзины = СтрокаТаблицы["le"];
		Если НЕ ЭтоБесконечнаяГраница(ГраницаКорзины) И ТипЗнч(ГраницаКорзины) <> Тип("Число") Тогда
			Возврат "значение колонки le не является числом или строкой +Inf";
		КонецЕсли;

		Граница = ПредставлениеГраницыКорзины(ГраницаКорзины);
		Если Границы.Найти(Граница) <> Неопределено Тогда
			Возврат "граница корзины " + Граница + " в колонке le повторяется";
		КонецЕсли;
		Границы.Добавить(Граница);
		ЕстьКорзинаБесконечности = ЕстьКорзинаБесконечности ИЛИ ЭтоБесконечнаяГраница(ГраницаКорзины);

		Если НЕ ЭтоЦелоеНеотрицательное(СтрокаТаблицы["value"]) Тогда
			Возврат "значение корзины " + Граница
				+ " в колонке value не является целым неотрицательным числом";
		КонецЕсли;

	КонецЦикла;

	Если КоличествоСумм <> 1 Тогда
		Возврат "ожидается ровно одна строка sum в колонке __series, найдено " + КоличествоСумм;
	КонецЕсли;

	Если НЕ ЕстьКорзинаБесконечности Тогда
		Возврат "отсутствует корзина с границей +Inf в колонке le";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция НайтиНарушениеКонтрактаСводки(Таблица)

	Нарушение = НайтиНедостающуюСлужебнуюКолонку(Таблица, Перечисления.пэмТипыМетрик.Summary);
	Если НЕ ПустаяСтрока(Нарушение) Тогда
		Возврат Нарушение;
	КонецЕсли;

	ИменаМеток = ИменаКолонокМеток(Таблица, Перечисления.пэмТипыМетрик.Summary);

	Для Каждого Сочетание Из СочетанияМеток(Таблица, ИменаМеток) Цикл
		Нарушение = НайтиНарушениеСтрокСводки(Сочетание.Строки);
		Если НЕ ПустаяСтрока(Нарушение) Тогда
			Возврат НарушениеСочетания(Сочетание, Нарушение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НайтиНарушениеСтрокСводки(СтрокиСочетания)

	Уровни = Новый Массив;
	КоличествоСумм = 0;
	КоличествоСтрокCount = 0;

	Для Каждого СтрокаТаблицы Из СтрокиСочетания Цикл

		Ряд = СтрокаТаблицы["__series"];

		Если Ряд = "sum" Тогда
			КоличествоСумм = КоличествоСумм + 1;
			Продолжить;
		КонецЕсли;

		Если Ряд = "count" Тогда
			КоличествоСтрокCount = КоличествоСтрокCount + 1;
			Если НЕ ЭтоЦелоеНеотрицательное(СтрокаТаблицы["value"]) Тогда
				Возврат "значение строки count в колонке value не является целым неотрицательным числом";
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Ряд <> "quantile" Тогда
			Возврат "недопустимое значение колонки __series: """ + Строка(Ряд) + """";
		КонецЕсли;

		УровеньКвантиля = СтрокаТаблицы["quantile"];
		Если ТипЗнч(УровеньКвантиля) <> Тип("Число") ИЛИ УровеньКвантиля < 0 ИЛИ УровеньКвантиля > 1 Тогда
			Возврат "значение колонки quantile не является числом от 0 до 1 включительно";
		КонецЕсли;

		Уровень = ЧисловоеЗначениеСтрокой(УровеньКвантиля);
		Если Уровни.Найти(Уровень) <> Неопределено Тогда
			Возврат "уровень квантиля " + Уровень + " в колонке quantile повторяется";
		КонецЕсли;
		Уровни.Добавить(Уровень);

	КонецЦикла;

	Если КоличествоСумм <> 1 Тогда
		Возврат "ожидается ровно одна строка sum в колонке __series, найдено " + КоличествоСумм;
	КонецЕсли;

	Если КоличествоСтрокCount <> 1 Тогда
		Возврат "ожидается ровно одна строка count в колонке __series, найдено " + КоличествоСтрокCount;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция НайтиНедостающуюСлужебнуюКолонку(Таблица, ТипМетрики)

	Для Каждого ИмяКолонки Из СлужебныеКолонкиТипаМетрики(ТипМетрики) Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Возврат "тип " + ИмяТипаМетрикиВФорматеЭкспозиции(ТипМетрики)
				+ " требует колонку " + ИмяКолонки;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НарушениеСочетания(Сочетание, Нарушение)

	Возврат "сочетание меток {" + Сочетание.Метки + "}: " + Нарушение;

КонецФункции

// Собирает условия отбора операций одной очереди. Ожидающей выполнения считается операция,
// которая ещё не завершилась, либо завершилась ошибкой, но попытки у неё остались.
//
// Параметры:
//   НеЗавершенные - Строка - условие «операция ещё не завершилась»
//   Ошибочные - Строка - условие «операция завершилась ошибкой»
//   ПопыткиОстались - Строка - условие «подсистема возьмёт операцию в работу снова»
//
// Возвращаемое значение:
//   Структура - условия отбора очереди, см. УсловияОтбораОперацийОчередей
//
Функция УсловияОчереди(НеЗавершенные, Ошибочные, ПопыткиОстались)

	ЗавершилисьОшибкой = "(" + Ошибочные + ")";
	ЕстьПопытки = "(" + ПопыткиОстались + ")";
	ПопыткиИсчерпаны = "(НЕ " + ЕстьПопытки + ")";

	Ожидающие = СтрШаблон("((%1)
		|	ИЛИ (%2
		|		И %3))", НеЗавершенные, ЗавершилисьОшибкой, ЕстьПопытки);

	Условия = Новый Структура;
	Условия.Вставить("Ожидающие", Ожидающие);
	Условия.Вставить("Ошибочные", ЗавершилисьОшибкой);
	Условия.Вставить("ПопыткиОстались", ЕстьПопытки);
	Условия.Вставить("ПопыткиИсчерпаны", ПопыткиИсчерпаны);

	Возврат Условия;

КонецФункции

// Предел попыток обработки хранится в потоке данных сообщения. Незаполненный предел означает,
// что попытки исчерпаны: поток данных сообщения не определён и брать его в работу некому.
//
// Возвращаемое значение:
//   Строка - условие «подсистема возьмёт операцию в работу снова»
//
Функция ПопыткиОбработкиОстались()

	Возврат "ЕСТЬNULL(Поток.КоличествоПопытокОбработки, 0) > Статус.КоличествоПопыток";

КонецФункции

// Предел попыток отправки хранится в справочнике подписчика, а измерение регистра рассылки имеет
// составной тип, поэтому значение читается тем справочником, которому подписчик принадлежит.
// Незаполненный предел означает, что попытки исчерпаны.
//
// Возвращаемое значение:
//   Строка - условие «подсистема возьмёт операцию в работу снова»
//
Функция ПопыткиОтправкиОстались()

	ПределПопыток = "0";

	Для Каждого ИмяСправочника Из инт_ПодписчикиОбщийПовтИсп.СписокТиповПодписчиков() Цикл
		ПределПопыток = СтрШаблон(
			"ЕСТЬNULL(ВЫРАЗИТЬ(Статус.Подписчик КАК Справочник.%1).КоличествоПопытокОтправки, %2)",
			ИмяСправочника, ПределПопыток);
	КонецЦикла;

	Возврат "Статус.КоличествоПопыток < " + ПределПопыток;

КонецФункции

Функция ЭтоЦелоеНеотрицательное(Значение)

	Возврат ТипЗнч(Значение) = Тип("Число") И Значение >= 0 И Цел(Значение) = Значение;

КонецФункции

#КонецОбласти

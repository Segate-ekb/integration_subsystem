// BSLLS-off
#Область Push

Процедура СформироватьМетрикиРегламентнымЗаданием(Метрика = Неопределено) Экспорт
					
	Если НЕ пэмМетрикиСерверПовтИсп.РазрешеноИспользованиеМетодаPush() Тогда
		Возврат;
	КонецЕсли;
			
	АдресСервера = Константы.пэмАдресСервераPushgateway.Получить();
	ПортСервера = Константы.пэмПортСервераPushgateway.Получить();
	ПутьНаСервере = Константы.пэмПутьНаСервереPushgateway.Получить();
			    			
	Метрики = ПолучитьМетрики(Перечисления.пэмМетодыПолученияМетрик.Push, Метрика);
	HTTPСоединение = Новый HTTPСоединение(АдресСервера, ПортСервера, , , , 30);
	HTTPЗапрос = Новый HTTPЗапрос(ПутьНаСервере);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "text/plain; version=0.0.4");
		
	HTTPЗапрос.УстановитьТелоИзСтроки(Метрики, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Результат = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	
	Если Результат.КодСостояния > 300 Тогда
		ЗаписьЖурналаРегистрации("Prometheus data exporter",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		"Ошибка отправки метрик. Код ответа Pushgateway: " + Результат.КодСостояния);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область Pull

Функция СформироватьМетрикиПоЗапросу() Экспорт
	
	Возврат ПолучитьМетрики(Перечисления.пэмМетодыПолученияМетрик.Pull, Неопределено);
	
КонецФункции

#КонецОбласти

#Область Описание_сервиса

Функция ВернутьОписаниеСервиса() Экспорт
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	Ответ.Заголовки.Вставить("Content-Type", "text/html;charset=UTF-8");
	Ответ.Заголовки.Вставить("Pragma", "no-cache");
	Ответ.Заголовки.Вставить("Cache-Control", "no-cache");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("Content-Language", "en");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пэмМетрики.Ссылка КАК Ссылка,
	|	пэмМетрики.МетодПолученияМетрики КАК МетодПолученияМетрики,
	|	пэмМетрики.Активность КАК Активность
	|ПОМЕСТИТЬ втСправочникМетрик
	|ИЗ
	|	Справочник.пэмМетрики КАК пэмМетрики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втСправочникМетрик.МетодПолученияМетрики КАК Type,
	|	""Active"" КАК State,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втСправочникМетрик.Ссылка) КАК Count
	|ИЗ
	|	втСправочникМетрик КАК втСправочникМетрик
	|ГДЕ
	|	втСправочникМетрик.Активность = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	втСправочникМетрик.МетодПолученияМетрики
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	втСправочникМетрик.МетодПолученияМетрики,
	|	""Inactive"",
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ втСправочникМетрик.Ссылка)
	|ИЗ
	|	втСправочникМетрик КАК втСправочникМетрик
	|ГДЕ
	|	втСправочникМетрик.Активность = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	втСправочникМетрик.МетодПолученияМетрики";
	Результат = Запрос.Выполнить().Выгрузить();

	СтрокаHTML =
	"<p><h1>Prometheus data exporter</h1></p>
	|%1
	|<p>&nbsp;</p>";
	
	Если Результат.Количество() Тогда
		Данные =
		"<h2>Metrics information:</h2>
		|<table border=""1"" cellpadding=""2"" cellspacing=""0"" >
		|<tbody>
		|	<tr>";
		Для Каждого Колонка Из Результат.Колонки Цикл
			Данные = Данные + Символы.ПС + "<td><h4>" + Колонка.Заголовок + "</h4></td>";
		КонецЦикла;
		Данные = Данные + Символы.ПС + "</tr>";
		Для Каждого Строка Из Результат Цикл
			Данные = Данные + Символы.ПС + "<tr>";
			Для Каждого КолонкаСтроки Из Строка Цикл
				Данные = Данные + Символы.ПС + "<td>" + КолонкаСтроки + "</td>";
			КонецЦикла;
			Данные = Данные + Символы.ПС + "</tr>";
		КонецЦикла;
		Данные = Данные + "
		|</tbody>
		|</table>";
	Иначе
		Данные = "<p><h2>Metrics is not set yet</h2></p>";
	КонецЕсли;
	
	СтрокаHTML = СтрЗаменить(СтрокаHTML, "%1", Данные);
	
	Ответ.УстановитьТелоИзСтроки(СтрокаHTML);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область Формирование_метрик

Функция ПолучитьМетрики(МетодПолученияМетрики, Метрика) Экспорт
	
	Метрики = "";
	Асинхронно = Константы.пэмМногопоточныйРасчетМетрик.Получить();
				
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	пэмМетрики.Код КАК ИмяМетрики,
	|	пэмМетрики.Наименование КАК ПояснениеМетрики,
	|	пэмМетрики.Алгоритм КАК Алгоритм,
	|	пэмМетрики.ТипМетрики КАК ТипМетрики,
	|	пэмМетрики.Ссылка КАК Метрика
	|ИЗ
	|	Справочник.пэмМетрики КАК пэмМетрики
	|ГДЕ
	|	ИСТИНА=ИСТИНА";

	Если Метрика = Неопределено Тогда
		УсловиеЗапроса = "пэмМетрики.Активность = ИСТИНА
						 |	И пэмМетрики.МетодПолученияМетрики = &МетодПолученияМетрики
						 |	И пэмМетрики.ИдентификаторРегламента = &ПустойИдентификатор";
	Иначе
		УсловиеЗапроса = "пэмМетрики.Активность = ИСТИНА
						 |	И пэмМетрики.МетодПолученияМетрики = &МетодПолученияМетрики
						 |  И пэмМетрики.Код = &КодМетрики";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"ИСТИНА=ИСТИНА",УсловиеЗапроса);
	Запрос.УстановитьПараметр("КодМетрики",Метрика);
	Запрос.УстановитьПараметр("МетодПолученияМетрики", МетодПолученияМетрики);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПустойИдентификатор",Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Асинхронно Тогда
		Метрики = СформироватьМетрикиАсинхронно(Выборка, МетодПолученияМетрики);
	Иначе
		Метрики = СформироватьМетрикиСинхронно(Выборка, МетодПолученияМетрики);
	КонецЕсли;
	
	Возврат Метрики;
		
КонецФункции

Функция СформироватьМетрикиАсинхронно(Выборка, МетодПолученияМетрики)

	ОграничениеВремени = ОграничениеВремениФормированияОтвета();
	РазмерПорции = ЧислоОдновременныхЗаданийРасчетаМетрик();

	ЧастиОтвета = Новый Массив;
	Порция = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Если ВремяФормированияОтветаИстекло(ОграничениеВремени) Тогда
			ЗаписатьПропускМетрики(Выборка.ИмяМетрики, ОграничениеВремени);
			Продолжить;
		КонецЕсли;

		Порция.Добавить(ЗапуститьРасчетМетрикиФоновымЗаданием(Выборка));

		Если Порция.Количество() = РазмерПорции Тогда
			ЧастиОтвета.Добавить(ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени));
			Порция.Очистить();
		КонецЕсли;

	КонецЦикла;

	ЧастиОтвета.Добавить(ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени));

	Возврат СтрСоединить(ЧастиОтвета, "");

КонецФункции

Функция СформироватьМетрикиСинхронно(Выборка, МетодПолученияМетрики)

	ОграничениеВремени = ОграничениеВремениФормированияОтвета();
	ЧастиОтвета = Новый Массив;

	Пока Выборка.Следующий() Цикл

		Если ВремяФормированияОтветаИстекло(ОграничениеВремени) Тогда
			ЗаписатьПропускМетрики(Выборка.ИмяМетрики, ОграничениеВремени);
			Продолжить;
		КонецЕсли;

		МоментНачалаРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();

		сткВозврат = СформироватьМетрику(Выборка.Алгоритм);
		Если сткВозврат.Ошибка Тогда
			Продолжить;
		КонецЕсли;

		сткВозврат = ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(Выборка.ИмяМетрики, Выборка.ТипМетрики,
			сткВозврат.МетрикаТаблицей, Выборка.ПояснениеМетрики);
		Если сткВозврат.Ошибка Тогда
			Продолжить;
		КонецЕсли;

		ЧастиОтвета.Добавить(сткВозврат.МетрикаСтрокой);
		ЗаписатьСостояниеРасчетаМетрики(Выборка.Метрика, Выборка.ИмяМетрики, МоментНачалаРасчета);

	КонецЦикла;

	Возврат СтрСоединить(ЧастиОтвета, "");

КонецФункции

Процедура СформироватьМетрикуФоновымЗаданием(ИмяМетрики, ТипМетрики, Алгоритм, ИдентификаторХранилища,
	Метрика, ПояснениеМетрики = "") Экспорт

	МоментНачалаРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();

	сткВозврат = СформироватьМетрику(Алгоритм);
	Если НЕ сткВозврат.Ошибка Тогда
		сткВозврат = ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики,
			сткВозврат.МетрикаТаблицей, ПояснениеМетрики);
	КонецЕсли;

	ПоместитьВоВременноеХранилище(сткВозврат, ИдентификаторХранилища);

	Если НЕ сткВозврат.Ошибка Тогда
		ЗаписатьСостояниеРасчетаМетрики(Метрика, ИмяМетрики, МоментНачалаРасчета);
	КонецЕсли;

КонецПроцедуры

// Запускает расчёт метрики фоновым заданием, поместив во временное хранилище пустое значение,
// которое фоновое задание заменит результатом расчёта.
//
// Параметры:
//   Выборка - ВыборкаИзРезультатаЗапроса - текущая строка выборки метрик
//
// Возвращаемое значение:
//   Структура:
//     * ИмяМетрики - Строка - код метрики
//     * АдресВХранилище - Строка - адрес значения с результатом расчёта во временном хранилище
//     * ФоновоеЗадание - ФоновоеЗадание - запущенное задание расчёта
//
Функция ЗапуститьРасчетМетрикиФоновымЗаданием(Выборка)

	АдресВХранилище = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);

	ПараметрыРасчета = Новый Массив;
	ПараметрыРасчета.Добавить(Выборка.ИмяМетрики);
	ПараметрыРасчета.Добавить(Выборка.ТипМетрики);
	ПараметрыРасчета.Добавить(Выборка.Алгоритм);
	ПараметрыРасчета.Добавить(АдресВХранилище);
	ПараметрыРасчета.Добавить(Выборка.Метрика);
	ПараметрыРасчета.Добавить(Выборка.ПояснениеМетрики);

	// Ключ задания отделён от адреса хранилища: адрес нужен основному потоку до освобождения
	// значения, а ключ обязан быть уникальным среди одновременно выполняющихся заданий метода.
	КлючЗадания = Выборка.ИмяМетрики + " " + Строка(Новый УникальныйИдентификатор);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("пэмМетрикиСервер.СформироватьМетрикуФоновымЗаданием",
		ПараметрыРасчета, КлючЗадания);

	Возврат Новый Структура("ИмяМетрики, АдресВХранилище, ФоновоеЗадание",
		Выборка.ИмяМетрики, АдресВХранилище, ФоновоеЗадание);

КонецФункции

// Дожидается завершения порции расчётов в пределах отведённого времени и собирает их результаты.
// Значение во временном хранилище освобождается независимо от исхода расчёта.
//
// Параметры:
//   Порция - Массив из Структура - запущенные расчёты метрик:
//     * ИмяМетрики - Строка - код метрики
//     * АдресВХранилище - Строка - адрес значения с результатом расчёта во временном хранилище
//     * ФоновоеЗадание - ФоновоеЗадание - задание расчёта
//   ОграничениеВремени - Структура - ограничение времени формирования ответа,
//                                    см. ОграничениеВремениФормированияОтвета
//
// Возвращаемое значение:
//   Строка - тексты рассчитанных метрик
//
Функция ЗавершитьПорциюРасчетов(Порция, ОграничениеВремени) Экспорт

	ОжидатьЗавершенияРасчетов(Порция, ОграничениеВремени);

	ЧастиОтвета = Новый Массив;

	Для Каждого Расчет Из Порция Цикл

		Если РасчетНеЗавершен(Расчет) Тогда
			ОтменитьРасчетМетрики(Расчет);
			ЗаписатьПропускМетрики(Расчет.ИмяМетрики, ОграничениеВремени);
		Иначе
			ЧастиОтвета.Добавить(ТекстРассчитаннойМетрики(Расчет));
		КонецЕсли;

		УдалитьИзВременногоХранилища(Расчет.АдресВХранилище);

	КонецЦикла;

	Возврат СтрСоединить(ЧастиОтвета, "");

КонецФункции

Процедура ОжидатьЗавершенияРасчетов(Порция, ОграничениеВремени)

	ОставшеесяВремя = ОставшеесяВремяФормированияОтветаВСекундах(ОграничениеВремени);
	Если НЕ Порция.Количество() Или ОставшеесяВремя <= 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаданияРасчета = Новый Массив;
	Для Каждого Расчет Из Порция Цикл
		ЗаданияРасчета.Добавить(Расчет.ФоновоеЗадание);
	КонецЦикла;

	ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ЗаданияРасчета, ОставшеесяВремя);

КонецПроцедуры

// Возвращает признак того, что расчёт метрики к этому моменту не завершён.
// Задание, вытесненное из списка заданий, считается завершившимся: сведений о его состоянии
// больше нет, а результат расчёта, если он был получен, уже лежит во временном хранилище.
//
// Параметры:
//   Расчет - Структура - запущенный расчёт метрики
//
// Возвращаемое значение:
//   Булево - Истина, если задание расчёта продолжает выполняться
//
Функция РасчетНеЗавершен(Расчет)

	СостояниеЗадания = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Расчет.ФоновоеЗадание.УникальныйИдентификатор);

	Если СостояниеЗадания = Неопределено Тогда
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": фоновое задание расчёта отсутствует в списке заданий, расчёт считается завершённым";
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);
		Возврат Ложь;
	КонецЕсли;

	Возврат СостояниеЗадания.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

Процедура ОтменитьРасчетМетрики(Расчет)

	Попытка
		Расчет.ФоновоеЗадание.Отменить();
	Исключение
		Комментарий = "Метрика " + Расчет.ИмяМетрики + ": не удалось отменить фоновое задание расчёта. "
			+ ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);
	КонецПопытки;

КонецПроцедуры

Функция ТекстРассчитаннойМетрики(Расчет)

	Попытка
		РезультатРасчета = ПолучитьИзВременногоХранилища(Расчет.АдресВХранилище);
	Исключение
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": не удалось получить результат расчёта из временного хранилища. " + ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(РезультатРасчета) <> Тип("Структура") Тогда
		Комментарий = "Метрика " + Расчет.ИмяМетрики
			+ ": фоновое задание расчёта завершилось, не поместив результат во временное хранилище";
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
		Возврат "";
	КонецЕсли;

	Возврат ?(РезультатРасчета.Ошибка, "", РезультатРасчета.МетрикаСтрокой);

КонецФункции

// Возвращает ограничение времени формирования ответа с метриками.
//
// Возвращаемое значение:
//   Структура:
//     * МоментНачала - Число - момент начала формирования ответа, миллисекунды
//     * ОтведенноеВремя - Число - отведённое на формирование ответа время, миллисекунды
//     * МоментЗавершения - Число - момент, начиная с которого расчёт метрик прекращается, миллисекунды
//
Функция ОграничениеВремениФормированияОтвета()

	МиллисекундВСекунде = 1000;

	ОтведенноеВремяВСекундах = Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Получить();
	Если ОтведенноеВремяВСекундах <= 0 Тогда
		// Незаполненная константа означает 10 секунд: рекомендованное документацией
		// значение параметра опроса scrape_timeout.
		ОтведенноеВремяВСекундах = 10;
	КонецЕсли;

	ОтведенноеВремя = ОтведенноеВремяВСекундах * МиллисекундВСекунде;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Возврат Новый Структура("МоментНачала, ОтведенноеВремя, МоментЗавершения",
		МоментНачала, ОтведенноеВремя, МоментНачала + ОтведенноеВремя);

КонецФункции

Функция ЧислоОдновременныхЗаданийРасчетаМетрик()

	ЧислоЗаданий = Константы.пэмЧислоОдновременныхЗаданийРасчетаМетрик.Получить();
	Если ЧислоЗаданий <= 0 Тогда
		ЧислоЗаданий = 4; // Незаполненная константа означает четыре одновременных задания.
	КонецЕсли;

	Возврат ЧислоЗаданий;

КонецФункции

Функция ВремяФормированияОтветаИстекло(ОграничениеВремени)

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() >= ОграничениеВремени.МоментЗавершения;

КонецФункции

Функция ОставшеесяВремяФормированияОтветаВСекундах(ОграничениеВремени)

	МиллисекундВСекунде = 1000;

	Возврат (ОграничениеВремени.МоментЗавершения - ТекущаяУниверсальнаяДатаВМиллисекундах())
		/ МиллисекундВСекунде;

КонецФункции

Процедура ЗаписатьПропускМетрики(ИмяМетрики, ОграничениеВремени)

	ЗатраченноеВремя = ТекущаяУниверсальнаяДатаВМиллисекундах() - ОграничениеВремени.МоментНачала;

	Комментарий = "Метрика " + ИмяМетрики + ": не включена в ответ, истекло отведённое время"
		+ " формирования ответа. Отведено " + Формат(ОграничениеВремени.ОтведенноеВремя, "ЧГ=0")
		+ " мс, затрачено " + Формат(ЗатраченноеВремя, "ЧГ=0") + " мс";

	ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Предупреждение, Комментарий);

КонецПроцедуры

Функция СформироватьМетрику(Алгоритм) Экспорт
	
	сткВозврат = Новый Структура;
	сткВозврат.Вставить("МетрикаТаблицей", Новый ТаблицаЗначений);
	сткВозврат.Вставить("ОписаниеОшибки", "");
	сткВозврат.Вставить("Ошибка", Ложь);
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		
		Выполнить(Алгоритм);
		ОтменитьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Prometheus data exporter",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки);
		сткВозврат.Ошибка = Истина;
		сткВозврат.ОписаниеОшибки = ОписаниеОшибки;
		Возврат сткВозврат;
	КонецПопытки;
	
	сткВозврат.МетрикаТаблицей = ТаблицаЗначений;
	
	Возврат сткВозврат;
		
КонецФункции

Функция ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики, МетрикаТаблицейЗначений,
	ПояснениеМетрики = "") Экспорт

	сткВозврат = Новый Структура();
	сткВозврат.Вставить("МетрикаСтрокой", "");
	сткВозврат.Вставить("Ошибка", Ложь);
	сткВозврат.Вставить("ОписаниеОшибки", "");

	НарушениеКонтракта = НайтиНарушениеКонтрактаМетрики(ТипМетрики, МетрикаТаблицейЗначений);
	Если НЕ ПустаяСтрока(НарушениеКонтракта) Тогда
		ЗарегистрироватьОшибкуРасчетаМетрики(сткВозврат, "Метрика " + ИмяМетрики + ": " + НарушениеКонтракта);
		Возврат сткВозврат;
	КонецЕсли;

	Если НЕ МетрикаТаблицейЗначений.Количество() Тогда
		ЗаписьЖурналаРегистрации("Prometheus data exporter",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Метрика " + ИмяМетрики + ": расчёт вернул пустой результат");
	КонецЕсли;

	Попытка
		сткВозврат.МетрикаСтрокой = СформироватьТекстМетрики(ИмяМетрики, ТипМетрики,
			МетрикаТаблицейЗначений, ПояснениеМетрики);
	Исключение
		ЗарегистрироватьОшибкуРасчетаМетрики(сткВозврат, ОписаниеОшибки());
	КонецПопытки;

	Возврат сткВозврат;

КонецФункции

// Таймаут - число. Квант равен 1 секунде
Процедура Пауза(Знач Таймаут) Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация();
	ЭтоWindows = (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86)
	Или (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64);
	
	Таймаут = Таймаут + 1;

	Если ЭтоWindows Тогда
		ШаблонКоманды = "ping localhost -n " + Таймаут + " -w 1000";
	Иначе
		ШаблонКоманды = "ping -c " + Таймаут + " -w 1000 localhost";
	КонецЕсли;
	
	ЗапуститьПриложение(ШаблонКоманды, , Истина);
	
КонецПроцедуры

// Записывает состояние расчёта метрики в регистр сведений пэмСостояниеМетрик.
// Вызывается в том же потоке, что и расчёт, но вне транзакции алгоритма метрики:
// транзакция расчёта всегда отменяется, и выполненная внутри неё запись была бы потеряна.
//
// Параметры:
//   Метрика - СправочникСсылка.пэмМетрики - рассчитанная метрика
//   ИмяМетрики - Строка - код метрики, используется в сообщении журнала регистрации
//   МоментНачалаРасчета - Число - момент начала расчёта, миллисекунды универсального времени
//
Процедура ЗаписатьСостояниеРасчетаМетрики(Метрика, ИмяМетрики, МоментНачалаРасчета)

	Попытка
		НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Метрика.Установить(Метрика);

		СостояниеРасчета = НаборЗаписей.Добавить();
		СостояниеРасчета.Метрика = Метрика;
		СостояниеРасчета.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаРасчета;
		СостояниеРасчета.ДатаРасчета = ТекущаяУниверсальнаяДата();

		НаборЗаписей.Записать();
	Исключение
		Комментарий = "Метрика " + ИмяМетрики + ": не удалось записать состояние расчёта. "
			+ ОписаниеОшибки();
		ЗаписатьВЖурналМетрик(УровеньЖурналаРегистрации.Ошибка, Комментарий);
	КонецПопытки;

КонецПроцедуры

// Удаляет запись состояния расчёта метрики. Каждое удаление выполняется отдельным набором
// записей: повторное использование объекта после удаления делает результат зависимым
// от состояния объекта между итерациями.
//
// Параметры:
//   Метрика - СправочникСсылка.пэмМетрики - метрика, состояние расчёта которой удаляется
//
Процедура УдалитьСостояниеРасчетаМетрики(Метрика)

	НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Метрика.Установить(Метрика);
	НаборЗаписей.Записать();

КонецПроцедуры

// Маска - текстовая строка. Допустимы следующие символы:
// . - любой символ
// + - один или более раз, пример ".+" - один или более любой символ.
// * - ноль или более раз, пример ".*" - любое количество любых символов (даже ни одного).
// [n-m] - символ от m до n. Например: [a-zA-Z_:]* - строка любой длины, состоящая из больших и маленьких латинских символов, знаков "_" и ":" , Еще пример: "[0-9]+" - одна или более цифр(а).
// \d - цифра, пример 
// \d+ - одна или более цифр(а).
// \D - не цифра.
// \s - пробельный символ - ТАБ, пробел, перенос строки, возврат каретки и т.п.
// \S - непробельный символ.
// \w - буква, цифра, подчеркивание.
// \W - не буква, не цифра и не подчеркивание соответственно.
// ^ - начало текста, например "^\d+" - строка начинается с цифры.
// $ - конец текста, например "\D+$" - строка заканчивается НЕ цифрой.
// {m,n} - шаблон для от m до n символов, например "\d{2,4}" - от двух до четырех цифр. Можно указать одну и всего цифру для строгого соответвия.
// \ - экранирует спецсимволы. Например, "\." - символ точки.
Функция ПроверитьСтрокуНаСоответствиеМаске(Строка, Маска) Экспорт
	
	сткВозврат = Новый Структура;
	сткВозврат.Вставить("ЕстьОшибка", Истина);
	сткВозврат.Вставить("ОписаниеОшибки", "Ошибка в коде");
	сткВозврат.Вставить("Результат", Неопределено);
		
    Чтение = Новый ЧтениеXML;
    Чтение.УстановитьСтроку(
                "<Model xmlns=""http://v8.1c.ru/8.1/xdto"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xsi:type=""Model"">
                |<package targetNamespace=""sample-my-package"">
                |<valueType name=""testtypes"" base=""xs:string"">
                |<pattern>" + Маска + "</pattern>
                |</valueType>
                |<objectType name=""TestObj"">
                |<property xmlns:d4p1=""sample-my-package"" name=""TestItem"" type=""d4p1:testtypes""/>
                |</objectType>
                |</package>
                |</Model>");

    Модель = ФабрикаXDTO.ПрочитатьXML(Чтение);
	
	Попытка
    	МояФабрикаXDTO = Новый ФабрикаXDTO(Модель);
	Исключение
		сткВозврат.ЕстьОшибка = Истина;
		сткВозврат.ОписаниеОшибки = "Ошибка маски";
		Возврат сткВозврат;
	КонецПопытки;
		
    Пакет = МояФабрикаXDTO.Пакеты.Получить("sample-my-package");
    Тест = МояФабрикаXDTO.Создать(Пакет.Получить("TestObj"));

    Попытка
        Тест.TestItem = Строка;
    Исключение
        сткВозврат.ЕстьОшибка = Истина;
		сткВозврат.ОписаниеОшибки = "Строка не соответствует маске";
		сткВозврат.Результат = Ложь;
		Возврат сткВозврат;
	КонецПопытки;
	
	сткВозврат.ЕстьОшибка = Ложь;
	сткВозврат.ОписаниеОшибки = "";
	сткВозврат.Результат = Истина;
    Возврат сткВозврат;
   
КонецФункции

#КонецОбласти

#Область Служебный_программный_интерфейс

Процедура ВыполнитьПервоначальноеЗаполнение() Экспорт

	// Читаем индекс метрик из макета
	ИндексМетрик = ПолучитьИндексМетрикИзМакета();
	Если ИндексМетрик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЕстьОшибки = Ложь;
	МассивМетрикДляЗаписи = ПодготовитьМетрикиПоИндексу(ИндексМетрик, ЕстьОшибки);

	НачатьТранзакцию();
	Попытка
		Если НЕ ЕстьОшибки Тогда
			Константы.пэмПервоначальноеЗаполнениеВыполнено.Установить(Истина);
		КонецЕсли;
		Для Каждого Метрика Из МассивМетрикДляЗаписи Цикл
			Метрика.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Готовит объекты метрик к записи по описаниям из индекса метрик.
// Запись индекса, обработать которую не удалось, пропускается с сообщением в журнале
// регистрации; остальные записи индекса обрабатываются.
//
// Параметры:
//   ИндексМетрик - Массив из Структура - описания метрик из индекса
//   ЕстьОшибки - Булево - возвращаемый признак того, что хотя бы одна запись индекса пропущена
//
// Возвращаемое значение:
//   Массив из СправочникОбъект.пэмМетрики - метрики, подготовленные к записи
//
Функция ПодготовитьМетрикиПоИндексу(ИндексМетрик, ЕстьОшибки) Экспорт

	ЕстьОшибки = Ложь;
	МетрикиДляЗаписи = Новый Массив;

	Для Каждого ОписаниеИзИндекса Из ИндексМетрик Цикл

		Попытка
			ОписаниеМетрики = ПодготовитьМетрикуПоОписаниюИзИндекса(ОписаниеИзИндекса);
		Исключение
			ЕстьОшибки = Истина;
			ЗаписьЖурналаРегистрации("Prometheus data exporter",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если ОписаниеМетрики <> Неопределено Тогда
			МетрикиДляЗаписи.Добавить(ОписаниеМетрики);
		КонецЕсли;

	КонецЦикла;

	Возврат МетрикиДляЗаписи;

КонецФункции

// Готовит объект метрики по описанию из индекса метрик.
//
// Параметры:
//   ОписаниеИзИндекса - Структура - описание метрики из индекса
//
// Возвращаемое значение:
//   СправочникОбъект.пэмМетрики, Неопределено - Неопределено, если запись индекса
//                                               не требует обновления метрики
//
Функция ПодготовитьМетрикуПоОписаниюИзИндекса(ОписаниеИзИндекса)

	КодМетрики = ОписаниеИзИндекса.код;
	ПредопределенныйЭлемент = Справочники.пэмМетрики[КодМетрики];

	Если ПредопределенныйЭлемент.Пустая() Тогда
		Возврат Неопределено; // Предопределённый элемент не найден
	КонецЕсли;

	ОписаниеМетрики = ПредопределенныйЭлемент.ПолучитьОбъект();

	// Обновляем только если версия в макете выше
	НоваяВерсия = ОписаниеИзИндекса.версия;
	Если ОписаниеМетрики.Версия >= НоваяВерсия И ЗначениеЗаполнено(ОписаниеМетрики.Алгоритм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Алгоритм = ПолучитьАлгоритмМетрикиИзМакета(ОписаниеИзИндекса.макет);
	Если НЕ ЗначениеЗаполнено(Алгоритм) Тогда
		Возврат Неопределено; // Макет не найден или пустой
	КонецЕсли;

	ТипМетрики = ПолучитьТипМетрикиПоИмени(ОписаниеИзИндекса.типМетрики);
	Если ТипМетрики = Неопределено Тогда
		ВызватьИсключение "Метрика " + КодМетрики + ": недопустимое значение типа метрики """
			+ ОписаниеИзИндекса.типМетрики + """";
	КонецЕсли;

	МетодПолученияМетрики = ПолучитьМетодПолученияПоИмени(ОписаниеИзИндекса.методПолучения);
	Если МетодПолученияМетрики = Неопределено Тогда
		ВызватьИсключение "Метрика " + КодМетрики + ": недопустимое значение метода получения """
			+ ОписаниеИзИндекса.методПолучения + """";
	КонецЕсли;

	ОписаниеМетрики.Наименование = ОписаниеИзИндекса.наименование;
	ОписаниеМетрики.ТипМетрики = ТипМетрики;
	ОписаниеМетрики.МетодПолученияМетрики = МетодПолученияМетрики;
	ОписаниеМетрики.Активность = ОписаниеИзИндекса.активность;
	ОписаниеМетрики.ИдентификаторРегламента = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ОписаниеМетрики.Алгоритм = Алгоритм;
	ОписаниеМетрики.Версия = НоваяВерсия;

	Возврат ОписаниеМетрики;

КонецФункции

// Получает индекс метрик из JSON-макета пэмМетрикиИндекс
//
// Возвращаемое значение:
//   Массив из Структура - массив описаний метрик из индекса, или Неопределено при ошибке
//
Функция ПолучитьИндексМетрикИзМакета()
	
	Попытка
		Макет = ПолучитьОбщийМакет("пэмМетрикиИндекс");
		ТекстJSON = Макет.ПолучитьТекст();
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		
		Результат = ПрочитатьJSON(ЧтениеJSON, Ложь); // Ложь = читать в Структуру, не в Соответствие
		ЧтениеJSON.Закрыть();
		
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Получает алгоритм метрики из текстового макета
//
// Параметры:
//   ИмяМакета - Строка - имя макета с алгоритмом
//
// Возвращаемое значение:
//   Строка - текст алгоритма BSL, или пустая строка при ошибке
//
Функция ПолучитьАлгоритмМетрикиИзМакета(ИмяМакета) Экспорт
	
	Попытка
		Макет = ПолучитьОбщийМакет(ИмяМакета);
		Возврат Макет.ПолучитьТекст();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Получает описание метрики из JSON-индекса макета по коду метрики
//
// Параметры:
//   КодМетрики - Строка - код метрики (например, "pde_queue_length")
//
// Возвращаемое значение:
//   Структура, Неопределено - описание метрики из индекса или Неопределено если не найдена
//
Функция ПолучитьОписаниеМетрикиИзМакета(КодМетрики) Экспорт
	
	ИндексМетрик = ПолучитьИндексМетрикИзМакета();
	Если ИндексМетрик = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого ОписаниеМетрики Из ИндексМетрик Цикл
		Если ОписаниеМетрики.код = КодМетрики Тогда
			Возврат ОписаниеМетрики;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает значение перечисления типа метрики по строковому имени
//
// Параметры:
//   ИмяТипа - Строка - имя типа: "Gauge", "Counter", "Histogram", "Summary"
//
// Возвращаемое значение:
//   ПеречислениеСсылка.пэмТипыМетрик, Неопределено - значение перечисления,
//       Неопределено, если имя типа недопустимо
//
Функция ПолучитьТипМетрикиПоИмени(ИмяТипа) Экспорт

	Если ИмяТипа = "Gauge" Тогда
		Возврат Перечисления.пэмТипыМетрик.Gauge;
	ИначеЕсли ИмяТипа = "Counter" Тогда
		Возврат Перечисления.пэмТипыМетрик.Counter;
	ИначеЕсли ИмяТипа = "Histogram" Тогда
		Возврат Перечисления.пэмТипыМетрик.Histogram;
	ИначеЕсли ИмяТипа = "Summary" Тогда
		Возврат Перечисления.пэмТипыМетрик.Summary;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

// Возвращает значение перечисления метода получения метрики по строковому имени
//
// Параметры:
//   ИмяМетода - Строка - имя метода: "Pull", "Push"
//
// Возвращаемое значение:
//   ПеречислениеСсылка.пэмМетодыПолученияМетрик, Неопределено - значение перечисления,
//       Неопределено, если имя метода недопустимо
//
Функция ПолучитьМетодПолученияПоИмени(ИмяМетода) Экспорт

	Если ИмяМетода = "Pull" Тогда
		Возврат Перечисления.пэмМетодыПолученияМетрик.Pull;
	ИначеЕсли ИмяМетода = "Push" Тогда
		Возврат Перечисления.пэмМетодыПолученияМетрик.Push;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции


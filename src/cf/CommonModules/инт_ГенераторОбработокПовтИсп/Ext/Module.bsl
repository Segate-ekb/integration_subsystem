////////////////////////////////////////////////////////////////////////////////
// инт_ГенераторОбработокПовтИсп
//
// Кэш подключённых внешних обработок.
// Повторное использование возвращаемых значений: В течение сеанса.
//
// Ключ кэша включает признак версии обработчика, поэтому одна версия подключается
// в сеансе один раз, а смена версии даёт промах кэша и подключение новой обработки
// без перезапуска сеанса. Признак версии готовит инт_ВерсииОбработчиковПовтИсп.
//
// Здесь же пишутся записи журнала о компиляции и подключении: это единственное место
// на пути обработки сообщения, где они происходят на самом деле. В инт_ВерсииОбработчиковПовтИсп,
// работающем на каждый серверный вызов, записей уровня "Информация" нет.
//
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Функция - Имя подключённой обработки потока
// Подключает EPF обработчика потока и возвращает имя подключённой обработки.
// Сохранённый в базе данных EPF используется, если он получен из текущего текста
// обработчика, иначе обработка компилируется заново.
//
// Параметры:
//  ПотокДанных       - СправочникСсылка.инт_ПотокиДанных - Ссылка на поток данных.
//  ВерсияОбработчика - Строка - Признак версии, полученный функцией
//    инт_ВерсииОбработчиковПовтИсп.ВерсияОбработчикаПотока.
//
// Возвращаемое значение:
//  Строка - Имя подключённой обработки. Пустая строка, если обработчик не задан.
//
Функция ИмяПодключеннойОбработкиПотока(Знач ПотокДанных, Знач ВерсияОбработчика) Экспорт
	
	ТекстОбработчика = ПотокДанных.ТекстОбработчика;
	Если Не ЗначениеЗаполнено(ТекстОбработчика) Тогда
		инт_ГенераторОбработок.ВызватьИсключениеОбработчикНеЗаполнен(ПотокДанных, "текст обработчика пуст");
	КонецЕсли;
	
	ВерсияТекста = инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика);
	
	СохраненныйEPF = ПотокДанных.СкомпилированныйОбработчик.Получить();
	Скомпилирована = Не инт_ГенераторОбработок.СохраненнаяОбработкаПотокаПригодна(
		ТекстОбработчика, СохраненныйEPF, ВерсияОбработчика);
	
	НачалоКомпиляции = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ДвоичныеДанныеEPF = инт_ГенераторОбработок.РазрешитьEPF(
			ТекстОбработчика, СохраненныйEPF, ВерсияОбработчика);
	Исключение
		ЗаписатьОшибкуЭтапа("ОшибкаКомпиляции", ПотокДанных, ВерсияТекста, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Если Скомпилирована Тогда
		ЗаписатьЭтап("Компиляция", ПотокДанных, ВерсияТекста,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКомпиляции);
	КонецЕсли;
	
	// Имя строится по хешу текущего текста, а не по переданному признаку версии: у элементов
	// с незаполненным признаком EPF собран заново, и имя обязано соответствовать этому коду.
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(ПотокДанных, ВерсияТекста);
	
	Возврат ПодключитьИЗаписать(ДвоичныеДанныеEPF, ИмяРегистрации, ПотокДанных, ВерсияТекста);
	
КонецФункции

// Функция - Имя подключённой обработки подписчика
// Подключает обработчик пост-обработки подписчика и возвращает имя подключённой обработки.
// Сохранённая при записи подписчика обработка используется без повторной компиляции,
// если она собрана из этого текста и с этим набором переменных.
//
// Текст обработчика служит частью ключа кэша, поэтому его правка даёт промах кэша
// и подключение новой обработки без перезапуска сеанса.
//
// Параметры:
//  Подписчик        - СправочникСсылка - Подписчик, которому принадлежит обработчик.
//  НомерСтроки      - Число - Номер строки табличной части ПостПроцессинг.
//    Ноль означает обработчик по умолчанию: он формируется в коде и в базе не хранится.
//  ТекстОбработчика - Строка - Текст обработчика.
//
// Возвращаемое значение:
//  Строка - Имя подключённой обработки.
//
Функция ИмяПодключеннойОбработкиПодписчика(Знач Подписчик, Знач НомерСтроки, Знач ТекстОбработчика) Экспорт
	
	ВерсияТекста = инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика);
	ПредставлениеСтроки = Формат(НомерСтроки, "ЧГ=0");
	ОписаниеВерсии = СтрШаблон("%1, строка пост-процессинга %2", ВерсияТекста, ПредставлениеСтроки);
	
	Сохраненная = СохраненнаяОбработкаПодписчика(Подписчик, НомерСтроки);
	Скомпилирована = Не инт_ГенераторОбработок.СохраненнаяОбработкаПригодна(
		Сохраненная, ТекстОбработчика, , Истина);
	
	НачалоКомпиляции = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ДвоичныеДанныеEPF = инт_ГенераторОбработок.РазрешитьСохраненнуюОбработку(
			ТекстОбработчика, Сохраненная, , Истина);
	Исключение
		ЗаписатьОшибкуЭтапа("ОшибкаКомпиляции", Подписчик, ОписаниеВерсии, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	Если Скомпилирована Тогда
		ЗаписатьЭтап("Компиляция", Подписчик, ОписаниеВерсии,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКомпиляции);
	КонецЕсли;
	
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(Подписчик, ВерсияТекста, НомерСтроки);
	
	Возврат ПодключитьИЗаписать(ДвоичныеДанныеEPF, ИмяРегистрации, Подписчик, ОписаниеВерсии);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция - Подключить и записать
// Подключает внешнюю обработку и записывает событие подключения. Отказ записывается
// отдельным событием и передаётся вызывающему коду без подмены.
//
// Параметры:
//  ДвоичныеДанныеEPF - ДвоичныеДанные - Скомпилированная внешняя обработка.
//  ИмяРегистрации    - Строка - Имя, под которым обработка регистрируется.
//  Владелец          - СправочникСсылка - Владелец обработчика.
//  ОписаниеВерсии    - Строка - Признак версии для записи журнала.
//
// Возвращаемое значение:
//  Строка - Имя подключённой обработки.
//
Функция ПодключитьИЗаписать(Знач ДвоичныеДанныеEPF, Знач ИмяРегистрации, Знач Владелец, Знач ОписаниеВерсии)
	
	НачалоПодключения = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		ИмяПодключенной = инт_ГенераторОбработок.ПодключитьОбработку(ДвоичныеДанныеEPF, ИмяРегистрации);
	Исключение
		ЗаписатьОшибкуЭтапа("ОшибкаПодключения", Владелец, ОписаниеВерсии, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	
	ЗаписатьЭтап("Подключение", Владелец, ОписаниеВерсии,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПодключения);
	
	Возврат ИмяПодключенной;
	
КонецФункции

// Процедура - Записать этап
// Записывает успешно пройденный этап с уровнем "Информация".
//
// Параметры:
//  Этап           - Строка - Компиляция или Подключение.
//  Владелец       - СправочникСсылка - Владелец обработчика.
//  ОписаниеВерсии - Строка - Признак версии обработчика.
//  ДлительностьМс - Число - Длительность этапа в миллисекундах.
//
Процедура ЗаписатьЭтап(Знач Этап, Знач Владелец, Знач ОписаниеВерсии, Знач ДлительностьМс)
	
	ПредставлениеДлительности = Формат(ДлительностьМс, "ЧГ=0");
	
	Комментарий = СтрШаблон("Владелец обработчика: %1.
		|Признак версии: %2.
		|Длительность, мс: %3",
		Владелец, ОписаниеВерсии, ПредставлениеДлительности);
	
	инт_ГенераторОбработок.ЗаписатьВЖурнал("ПодсистемаИнтеграции.ГенераторОбработок." + Этап,
		УровеньЖурналаРегистрации.Информация, Владелец, Комментарий);
	
КонецПроцедуры

// Процедура - Записать ошибку этапа
// Записывает отказ этапа с уровнем "Ошибка" и отдельным именем события.
//
// Параметры:
//  Этап             - Строка - ОшибкаКомпиляции или ОшибкаПодключения.
//  Владелец         - СправочникСсылка - Владелец обработчика.
//  ОписаниеВерсии   - Строка - Признак версии обработчика.
//  ИнформацияОшибки - ИнформацияОбОшибке - Ошибка платформы.
//
Процедура ЗаписатьОшибкуЭтапа(Знач Этап, Знач Владелец, Знач ОписаниеВерсии, Знач ИнформацияОшибки)
	
	ОписаниеОшибки = ИнформацияОшибки.Описание;
	
	Комментарий = СтрШаблон("Владелец обработчика: %1.
		|Признак версии: %2.
		|Информация об ошибке: %3",
		Владелец, ОписаниеВерсии, ОписаниеОшибки);
	
	инт_ГенераторОбработок.ЗаписатьВЖурнал("ПодсистемаИнтеграции.ГенераторОбработок." + Этап,
		УровеньЖурналаРегистрации.Ошибка, Владелец, Комментарий);
	
КонецПроцедуры

// Функция - Сохранённая обработка подписчика
// Читается запросом: обращение через точку прочитало бы двоичные данные всех
// обработчиков подписчика вместо одного нужного.
//
// Параметры:
//  Подписчик   - СправочникСсылка - Подписчик с табличной частью ПостПроцессинг.
//  НомерСтроки - Число - Номер строки табличной части. Ноль означает обработчик
//    по умолчанию, который в базе не хранится.
//
// Возвращаемое значение:
//  Произвольный - Сохранённая обработка (см. инт_ГенераторОбработок.СохраняемаяОбработка)
//    или Неопределено, если её нет.
//
Функция СохраненнаяОбработкаПодписчика(Знач Подписчик, Знач НомерСтроки)
	
	Если НомерСтроки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТаблицы = Подписчик.Метаданные().ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПостПроцессинг.СкомпилированныйОбработчик КАК СкомпилированныйОбработчик
		|ИЗ
		|	%1.ПостПроцессинг КАК ПостПроцессинг
		|ГДЕ
		|	ПостПроцессинг.Ссылка = &Подписчик
		|	И ПостПроцессинг.НомерСтроки = &НомерСтроки", ИмяТаблицы);
	Запрос.УстановитьПараметр("Подписчик", Подписчик);
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.СкомпилированныйОбработчик.Получить(), Неопределено);
	
КонецФункции

#КонецОбласти

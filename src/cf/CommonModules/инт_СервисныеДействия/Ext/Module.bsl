#Область ПрограммныйИнтерфейс

// Процедура - Инт очистка устаревших сообщений
Процедура инт_ОчисткаУстаревшихСообщений() Экспорт
	// Первым шагом удаляем осиротевшие статусы входящих сообщений. Ошибка санитарной очистки не должна ломать основную очистку.
	Попытка
		УдалитьОсиротевшиеСтатусыВходящихСообщений();
	Исключение
		СообщениеОбОшибке = СтрШаблон("При удалении осиротевших статусов входящих сообщений произошла ошибка!
			| Сведения об ошибке: %1", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.ОчисткаУстаревшихСообщений",УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке);
	КонецПопытки;

	МассивФоновыхЗаданий = Новый массив;
	МассивФоновыхЗаданий.Добавить(ФоновыеЗадания.Выполнить("инт_СервисныеДействия.ОчиститьОчередьИсходящихСообщений",,,"Фоновая очистка очереди исходящих сообщений."));
	МассивФоновыхЗаданий.Добавить(ФоновыеЗадания.Выполнить("инт_СервисныеДействия.ОчиститьОчередьВходящихСообщений",,,"Фоновая очистка очереди входящих сообщений."));
	
	МассивФоновыхЗаданий = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивФоновыхЗаданий);
	
	Для Каждого ФоновоеЗадание Из МассивФоновыхЗаданий Цикл
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно ИЛИ ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			 СообщениеОбОшибке = СтрШаблон("В процессе очистки очередей от устаревших данных произошла ошибка!
				| В фоновое задание <%1> завершено с ошибкой
				| Сведения об ошибке: %2", ФоновоеЗадание.Наименование, ФоновоеЗадание.ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.ОчисткаУстаревшихСообщений",УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке);
			ВызватьИсключение СообщениеОбОшибке;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Очищает устаревшую статистику обработки сообщений.
// Вызывается регламентным заданием инт_ОчисткаСтатистикиОбработкиСообщений.
//
Процедура инт_ОчисткаСтатистикиОбработкиСообщений() Экспорт
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ОчиститьУстаревшуюСтатистику();
КонецПроцедуры

// Процедура - Удалить осиротевшие статусы входящих сообщений
// Удаляет записи регистра инт_ТекущийСтатусВходящихСообщений (вместе с историей статусов), для которых
// отсутствует запись в очереди инт_ОчередьВходящихСообщений или не заполнен идентификатор сообщения.
// Такие записи не могут быть обработаны и блокируют обработку очереди входящих сообщений.
// Вызывается первым шагом регламентного задания инт_ОчисткаУстаревшихСообщений.
//
Процедура УдалитьОсиротевшиеСтатусыВходящихСообщений() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	инт_ТекущийСтатусВходящихСообщений.ИдентификаторСообщения КАК ИдентификаторСообщения
	               |ИЗ
	               |	РегистрСведений.инт_ТекущийСтатусВходящихСообщений КАК инт_ТекущийСтатусВходящихСообщений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.инт_ОчередьВходящихСообщений КАК инт_ОчередьВходящихСообщений
	               |		ПО инт_ТекущийСтатусВходящихСообщений.ИдентификаторСообщения = инт_ОчередьВходящихСообщений.ИдентификаторСообщения
	               |ГДЕ
	               |	инт_ОчередьВходящихСообщений.ИдентификаторСообщения ЕСТЬ NULL
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	инт_ТекущийСтатусВходящихСообщений.ИдентификаторСообщения
	               |ИЗ
	               |	РегистрСведений.инт_ТекущийСтатусВходящихСообщений КАК инт_ТекущийСтатусВходящихСообщений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.инт_ОчередьВходящихСообщений КАК инт_ОчередьВходящихСообщений
	               |		ПО инт_ТекущийСтатусВходящихСообщений.ИдентификаторСообщения = инт_ОчередьВходящихСообщений.ИдентификаторСообщения
	               |ГДЕ
	               |	инт_ТекущийСтатусВходящихСообщений.ИдентификаторСообщения = &ПустойИдентификатор";
	Запрос.УстановитьПараметр("ПустойИдентификатор", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	МассивИдентификаторов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторСообщения");

	КоличествоУдаленных = 0;
	КоличествоОшибок = 0;
	Для Каждого Идентификатор Из МассивИдентификаторов Цикл
		Попытка
			РегистрыСведений.инт_ОчередьВходящихСообщений.УдалитьОсиротевшийСтатусПоИдентификатору(Идентификатор);
			КоличествоУдаленных = КоличествоУдаленных + 1;
		Исключение
			// Подробности ошибки записаны в журнал в УдалитьОсиротевшийСтатусПоИдентификатору.
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецПопытки;
	КонецЦикла;

	Если МассивИдентификаторов.Количество() > 0 Тогда
		СообщениеВЖурнал = СтрШаблон("Осиротевших статусов входящих сообщений найдено: %1, удалено: %2, не удалось удалить: %3.",
			МассивИдентификаторов.Количество(), КоличествоУдаленных, КоличествоОшибок);
		ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.ОчисткаУстаревшихСообщений", УровеньЖурналаРегистрации.Информация,,,СообщениеВЖурнал);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Процедура ОчиститьОчередьИсходящихСообщений() Экспорт
		РегистрыСведений.инт_СообщенияКУдалению.ОчиститьОчередьИсходящихСообщений();
КонецПроцедуры

Процедура ОчиститьОчередьВходящихСообщений() Экспорт
		РегистрыСведений.инт_СообщенияКУдалению.ОчиститьОчередьВходящихСообщений();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции // BSLLS:EmptyRegion-off

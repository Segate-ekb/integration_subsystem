////////////////////////////////////////////////////////////////////////////////
// инт_СервисныеДействия
//  
////////////////////////////////////////////////////////////////////////////////
#Область ПрограммныйИнтерфейс

// Процедура - Инт очистка устаревших сообщений
Процедура инт_ОчисткаУстаревшихСообщений() Экспорт
	МассивФоновыхЗаданий = Новый массив;
	МассивФоновыхЗаданий.Добавить(ФоновыеЗадания.Выполнить("инт_СервисныеДействия.ОчиститьОчередьИсходящихСообщений",,,"Фоновая очистка очереди исходящих сообщений."));
	МассивФоновыхЗаданий.Добавить(ФоновыеЗадания.Выполнить("инт_СервисныеДействия.ОчиститьОчередьВходящихСообщений",,,"Фоновая очистка очереди входящих сообщений."));
	
	МассивФоновыхЗаданий = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(МассивФоновыхЗаданий);
	
	Для Каждого ФоновоеЗадание Из МассивФоновыхЗаданий Цикл
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно ИЛИ ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
			 СообщениеОбОшибке = СтрШаблон("В процессе очистки очередей от устаревших данных произошла ошибка!
				| В фоновое задание <%1> завершено с ошибкой
				| Сведения об ошибке: %2", ФоновоеЗадание.Наименование, ФоновоеЗадание.ИнформацияОбОшибке);
			ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.ОчисткаУстаревшихСообщений",УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке);
			ВызватьИсключение СообщениеОбОшибке;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Очищает устаревшую статистику обработки сообщений.
// Вызывается регламентным заданием инт_ОчисткаСтатистикиОбработкиСообщений.
//
Процедура инт_ОчисткаСтатистикиОбработкиСообщений() Экспорт
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ОчиститьУстаревшуюСтатистику();
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс
Процедура ОчиститьОчередьИсходящихСообщений() Экспорт
		РегистрыСведений.инт_СообщенияКУдалению.ОчиститьОчередьИсходящихСообщений();
КонецПроцедуры

Процедура ОчиститьОчередьВходящихСообщений() Экспорт
		РегистрыСведений.инт_СообщенияКУдалению.ОчиститьОчередьВходящихСообщений();
КонецПроцедуры

// Процедура - Зарегистрировать обработанные сообщения потока
// Точка входа фонового задания, которое проставляет дату удаления сообщениям потока,
// обработанным до того, как в потоке задали срок хранения.
//
// Параметры:
//  ПотокДанных	 - СправочникСсылка.инт_ПотокиДанных	 - Поток данных.
//
Процедура ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных) Экспорт
	РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);
КонецПроцедуры

// Процедура - Запустить регистрацию обработанных сообщений потока
// Запускает фоновую регистрацию обработанных сообщений потока к удалению.
// Вызывается после записи потока, в котором изменили срок хранения обработанных сообщений.
// Неудачный запуск не отменяет запись потока. Чтобы повторить регистрацию, срок хранения нужно
// изменить: на запись потока с прежним значением срока задание не запускается.
//
// Параметры:
//  ПотокДанных	 - СправочникСсылка.инт_ПотокиДанных	 - Поток данных.
//
Процедура ЗапуститьРегистрациюОбработанныхСообщенийПотока(ПотокДанных) Экспорт
	КлючЗадания = "инт_РегистрацияСообщенийКУдалению_" + ПотокДанных.УникальныйИдентификатор();
	Если РегистрацияСообщенийКУдалениюВыполняется(КлючЗадания) Тогда
		// Запущенное задание зарегистрирует сообщения потока целиком, второе запускать незачем.
		Возврат;
	КонецЕсли;
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПотокДанных);
	
	Попытка
		ФоновыеЗадания.Выполнить("инт_СервисныеДействия.ЗарегистрироватьОбработанныеСообщенияПотока",
			ПараметрыЗадания,
			КлючЗадания,
			"Регистрация обработанных сообщений потока к удалению.");
	Исключение
		ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СообщениеОбОшибке = СтрШаблон("Не удалось запустить регистрацию обработанных сообщений
			|потока <%1> к удалению!
			|
			| Информация об ошибке: %2", ПотокДанных, ОписаниеОшибки);
		ЗаписьЖурналаРегистрации("ПодсистемаИнтеграции.СообщенияКУдалению",
			УровеньЖурналаРегистрации.Ошибка, , ПотокДанных, СообщениеОбОшибке);
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РегистрацияСообщенийКУдалениюВыполняется(КлючЗадания)
	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания, СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;
КонецФункции

#КонецОбласти

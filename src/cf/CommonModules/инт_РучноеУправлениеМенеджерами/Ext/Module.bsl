// Приостанавливает выполнение на заданное время.
// Ожидание опирается на тайм-аут метода ФоновыеЗадания.ОжидатьЗавершенияВыполнения: в списке
// ожидания стоит фоновое задание, состояние которого за время ожидания измениться не может,
// поэтому ожидание длится ровно отведённое время, не нагружает процессор и не запускает
// приложений операционной системы. Вне фонового задания ожидание передаётся отдельному заданию:
// собственного задания, пригодного для ожидания, у такого сеанса нет.
//
// Параметры:
//  ДлительностьСекунд - Число - Длительность паузы в секундах
//
Процедура Пауза(Знач ДлительностьСекунд) Экспорт
	
	ОжидаемоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	
	Если ОжидаемоеЗадание = Неопределено Тогда
		ПараметрыПаузы = Новый Массив;
		ПараметрыПаузы.Добавить(ДлительностьСекунд);
		ОжидаемоеЗадание = ФоновыеЗадания.Выполнить("инт_РучноеУправлениеМенеджерами.Пауза",
			ПараметрыПаузы, Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	
	ЗаданияОжидания = Новый Массив;
	ЗаданияОжидания.Добавить(ОжидаемоеЗадание);
	ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ЗаданияОжидания, ДлительностьСекунд);
	
КонецПроцедуры

#КонецОбласти

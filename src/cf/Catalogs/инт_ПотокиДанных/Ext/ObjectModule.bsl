#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если Валидация Тогда
		ПроверяемыеРеквизиты.Добавить("СхемаДанных");
		ПроверяемыеРеквизиты.Добавить("ИмяСхемыПакета");
	КонецЕсли;
	
	Если НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		ПроверяемыеРеквизиты.Добавить("Пример");
		ПроверяемыеРеквизиты.Добавить("ОтслеживаемыеРеквизиты");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		ПроверитьОтслеживаемыеРеквизиты(Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтслеживаемыеРеквизиты) И ЗначениеЗаполнено(Пример) Тогда
		ПримерСсылка = ЗначениеИзСтрокиВнутр(Пример);
		ОтслеживаемыеРеквизиты = ЗначениеВСтрокуВнутр(Справочники.инт_ПотокиДанных.ЗаполнитьДеревоРеквизитовПоСсылке(ПримерСсылка, Неопределено));
	КонецЕсли;
	
	ОбеспечитьСкомпилированныйОбработчик();
	
	ОтметитьУстановкуСрокаХраненияОбработанныхСообщений();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура - Обеспечить скомпилированный обработчик
// Приводит скомпилированный обработчик и признак его версии в соответствие тексту обработчика.
// Оба реквизита записываются вместе, поэтому по признаку версии всегда известно,
// из какого текста получен сохранённый EPF.
//
// Совпадение признака версии означает, что EPF уже собран из текущего текста —
// в том числе формой элемента, до записи.
//
Процедура ОбеспечитьСкомпилированныйОбработчик()
	
	Если Не ЗначениеЗаполнено(ТекстОбработчика) Тогда
		СкомпилированныйОбработчик = Новый ХранилищеЗначения(Неопределено);
		ХешСкомпилированногоОбработчика = "";
		Возврат;
	КонецЕсли;
	
	ХешТекста = инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика);
	Если ХешСкомпилированногоОбработчика = ХешТекста Тогда
		Возврат;
	КонецЕсли;
	
	СкомпилированныйОбработчик = Новый ХранилищеЗначения(
		инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика));
	ХешСкомпилированногоОбработчика = ХешТекста;
	
КонецПроцедуры

// Процедура - Отметить установку срока хранения обработанных сообщений
// Отмечает в дополнительных свойствах, что в потоке задали новый срок хранения обработанных сообщений:
// сообщениям, обработанным до этого момента, дату удаления не проставляли.
// Регистрацию таких сообщений запускает форма потока после записи - в транзакции записи
// платформа не разрешает запускать фоновые задания.
//
Процедура ОтметитьУстановкуСрокаХраненияОбработанныхСообщений()
	Если ЭтоНовый() Или УдалятьОбработанныеСообщенияЧерез <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПрежниеЗначения = инт_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "УдалятьОбработанныеСообщенияЧерез");
	Если ПрежниеЗначения.УдалятьОбработанныеСообщенияЧерез <> УдалятьОбработанныеСообщенияЧерез Тогда
		ДополнительныеСвойства.Вставить("ЗарегистрироватьОбработанныеСообщенияКУдалению", Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтслеживаемыеРеквизиты(Отказ)
	Дерево = ЗначениеИзСтрокиВнутр(ОтслеживаемыеРеквизиты);
	
	Если Дерево.Строки.Найти(1, "ОтслеживатьИзменения", Истина) = Неопределено Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка! Не отслеживается изменение ни одного поля!";
		Сообщение.Поле = "ОпределитьОтслеживаемыеРеквизиты"; //имя реквизита
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

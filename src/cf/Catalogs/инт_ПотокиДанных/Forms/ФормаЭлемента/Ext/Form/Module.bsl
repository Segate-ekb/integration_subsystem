&НаКлиенте
Процедура ОбновитьКонтекстРедактора()
	ДобавитьПеременные();
	УстановитьСхему();
	конс_ПодключаемаяКонсольКлиент.ЗагрузитьПользовательскийКонтекст(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ДобавитьПеременные()

	// Очищаем предыдущие переменные — при смене направления набор переменных меняется
	ОчиститьПеременныеКонтекста();
	
	// Имена и назначения берутся из общего контракта: подсказки редактора, объявления
	// сформированного модуля и документация должны совпадать (см. ТР-Ф-060).
	Для Каждого ОписаниеПеременной Из инт_ГенераторОбработок.ПеременныеКонтекста(ВидОбработчикаПотока()) Цикл
		конс_ПодключаемаяКонсольСервер.ДобавитьПеременную(ЭтотОбъект,
			ОписаниеПеременной.Имя,
			ЗначениеПодсказкиПеременной(ОписаниеПеременной.Имя),
			ОписаниеПеременной.Назначение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПеременныеКонтекста()
	Попытка
		ПараметрыРедактора = ЭтотОбъект.конс_СтруктураПараметровРедактораКода;
		ПараметрыРедактора.JSONПеременных = "";
		Если ЗначениеЗаполнено(ПараметрыРедактора.АдресЗначенийПеременных) Тогда
			ПоместитьВоВременноеХранилище(Новый Соответствие, ПараметрыРедактора.АдресЗначенийПеременных);
		КонецЕсли;
		// Необходимо переприсвоить реквизит формы, чтобы платформа зафиксировала изменения
		ЭтотОбъект.конс_СтруктураПараметровРедактораКода = ПараметрыРедактора;
	Исключение
		// Структура параметров ещё не инициализирована
	КонецПопытки;
КонецПроцедуры 


&НаКлиенте
Процедура УстановитьСхему()
	Если Не ЗначениеЗаполнено(Объект.СхемаДанных) или Не ЗначениеЗаполнено(Объект.ИмяСхемыПакета) Тогда 
		Возврат;
	КонецЕсли;     
	Схема = ПолучитьТекстСхемы(); 
	конс_ПодключаемаяКонсольКлиент.ЗагрузитьФайлСхемы(ЭтаФорма, Схема);
	
	Если Объект.НаправлениеПотока = ПредопределенноеЗначение("Перечисление.инт_НаправлениеПотокаДанных.Исходящий") Тогда
		конс_ПодключаемаяКонсольКлиент.ЗагрузитьСхемуПеременной(ЭтаФорма, "Результат", Схема, Объект.ИмяСхемыПакета);
	Иначе
		конс_ПодключаемаяКонсольКлиент.ЗагрузитьСхемуПеременной(ЭтаФорма, "ИсходныеДанные", Схема, Объект.ИмяСхемыПакета);
	КонецЕсли;

КонецПроцедуры   


&НаКлиенте
Процедура ИмяСхемыПакетаПриИзменении(Элемент)
	РедакторКодаДокументСформирован(Неопределено);
КонецПроцедуры


&НаСервере
Функция ПолучитьТекстСхемы()

	Возврат Справочники.инт_Схемы.ПолучитьOpenApiСхему(Объект.СхемаДанных);

КонецФункции 

// Показать ошибку в редакторе кода с подсветкой строки.
// Извлекает номер строки и колонки из текста ошибки,
// очищает текст от внутренних путей модулей {Модуль.Путь(N,M)}:
// и вызывает подсветку соответствующей строки в Monaco-редакторе.
//
// Параметры:
//  ТекстОшибки        - Строка - Текст ошибки (из КраткоеПредставлениеОшибки или лога).
//  ЭтоОшибкаВыполнения - Булево - Истина если ошибка runtime (нужен перевод строки по карте),
//                                  Ложь если ошибка компиляции (строки уже пересчитаны).
//  СтрокаОбработчика  - Число - Номер строки текста обработчика, если он известен заранее:
//                                  так приходят проблемы разбора, в тексте которых координат нет.
&НаКлиенте
Процедура ПоказатьОшибкуВРедакторе(Знач ТекстОшибки, Знач ЭтоОшибкаВыполнения = Ложь,
	Знач СтрокаОбработчика = 0)
	
	НомерСтроки = СтрокаОбработчика;
	НомерКолонки = 1;

	// Очищаем текст от блоков {Модуль.Путь(N,M)}: — они не информативны для пользователя.
	// Координаты извлекаем из самого внутреннего (последнего) блока.
	Пока Истина Цикл
		ПозФигОткр = СтрНайти(ТекстОшибки, "{");
		Если ПозФигОткр = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозФигЗакр = СтрНайти(ТекстОшибки, "}", , ПозФигОткр);
		Если ПозФигЗакр = 0 Тогда
			Прервать;
		КонецЕсли;
		Суффикс = Сред(ТекстОшибки, ПозФигЗакр + 1);
		Если Не СтрНачинаетсяС(Суффикс, ": ") Тогда
			Прервать;
		КонецЕсли;
		
		// Извлекаем координаты (N,M) из содержимого блока.
		СодержимоеБлока = Сред(ТекстОшибки, ПозФигОткр + 1, ПозФигЗакр - ПозФигОткр - 1);
		ПозОткрСк = СтрНайти(СодержимоеБлока, "(");
		Если ПозОткрСк > 0 Тогда
			ПозЗакрСк = СтрНайти(СодержимоеБлока, ")", , ПозОткрСк);
			Если ПозЗакрСк > 0 Тогда
				Координаты = Сред(СодержимоеБлока, ПозОткрСк + 1, ПозЗакрСк - ПозОткрСк - 1);
				Части = СтрРазделить(Координаты, ",");
				Если Части.Количество() >= 2 Тогда
					Попытка
						ВозможнаяСтрока = Число(СокрЛП(Части[0]));
						ВозможнаяКолонка = Число(СокрЛП(Части[1]));
						Если ВозможнаяСтрока > 0 Тогда
							НомерСтроки = ВозможнаяСтрока;
							НомерКолонки = ВозможнаяКолонка;
						КонецЕсли;
					Исключение
						// Не числовые координаты.
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Убираем блок {…}: из текста.
		ТекстОшибки = СокрЛ(Лев(ТекстОшибки, ПозФигОткр - 1) + Сред(ТекстОшибки, ПозФигЗакр + 3));
	КонецЦикла;
	ТекстОшибки = СокрЛП(ТекстОшибки);
	
	// Для ошибок выполнения переводим номер строки модуля EPF в строку исходного текста.
	Если ЭтоОшибкаВыполнения И НомерСтроки > 0 Тогда
		ИсходнаяСтрока = ИсходнаяСтрокаОбработчика(НомерСтроки);
		Если ИсходнаяСтрока = 0 Тогда
			// Строке модуля не соответствует ни одна строка исходного текста:
			// ошибка в служебной части сформированного модуля.
			ТекстОшибки = ТекстОшибки + Символы.ПС
				+ "Ошибка возникла вне текста обработчика, в служебной части сформированного модуля.";
			НомерСтроки = 0;
			НомерКолонки = 1;
		Иначе
			НомерСтроки = ИсходнаяСтрока;
		КонецЕсли;
	КонецЕсли;
	
	конс_ПодключаемаяКонсольКлиент.ПоказатьОшибку(ЭтаФорма, ТекстОшибки, НомерСтроки, НомерКолонки, "РедакторКода");
	
КонецПроцедуры

// Вид обработчика для контракта переменных контекста, см. инт_ГенераторОбработок.ПеременныеКонтекста.
//
// Возвращаемое значение:
//  Строка - Вид обработчика по направлению потока.
//
&НаСервере
Функция ВидОбработчикаПотока()

	Если Объект.НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		Возврат "ПотокДанныхИсходящий";
	КонецЕсли;

	Возврат "ПотокДанныхВходящий";

КонецФункции

// Образец значения переменной контекста для подсказок редактора кода.
// Имя и назначение задаёт контракт, а образец значения зависит от состояния формы.
//
// Параметры:
//  ИмяПеременной - Строка - Имя переменной контекста.
//
// Возвращаемое значение:
//  Произвольный - Образец значения либо его тип.
//
&НаСервере
Функция ЗначениеПодсказкиПеременной(Знач ИмяПеременной)

	Если ИмяПеременной = "Результат" Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Если Объект.НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
		Возврат ПримерСсылка;
	КонецЕсли;

	Возврат Справочники.инт_ПотокиДанных.ИсходныеДанныеДляОтладчика(ТестовыеДанные);

КонецФункции

// Первая проблема, обнаруженная разбором текста обработчика.
//
// Параметры:
//  ТекстОбработчика - Строка - Проверяемый текст обработчика.
//
// Возвращаемое значение:
//  Структура:
//   * Строка - Число - Номер строки текста обработчика. Ноль, если проблем нет.
//   * Текст  - Строка - Описание проблемы. Пустая строка, если проблем нет.
//
&НаСервереБезКонтекста
Функция ПерваяПроблемаРазбора(Знач ТекстОбработчика)

	Проблема = Новый Структура("Строка, Текст", 0, "");

	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(ТекстОбработчика);
	Если Блоки.Проблемы.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Проблема, Блоки.Проблемы[0]);
	КонецЕсли;

	Возврат Проблема;

КонецФункции

// Номер строки исходного текста обработчика по номеру строки сформированного модуля.
// Ноль означает, что строке модуля не соответствует ни одна строка исходного текста.
//
// Параметры:
//  НомерСтрокиМодуля - Число - Номер строки сформированного модуля.
//
// Возвращаемое значение:
//  Число - Номер строки исходного текста обработчика или ноль.
//
&НаКлиенте
Функция ИсходнаяСтрокаОбработчика(Знач НомерСтрокиМодуля)

	Если Не ЗначениеЗаполнено(СоответствиеСтрокМодуля) Тогда
		Возврат 0;
	КонецЕсли;

	НомераСтрок = СтрРазделить(СоответствиеСтрокМодуля, ",");
	Если НомерСтрокиМодуля < 1 Или НомерСтрокиМодуля > НомераСтрок.Количество() Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(НомераСтрок[НомерСтрокиМодуля - 1]);

КонецФункции

// Карта строк модуля в виде строки: номера строк исходного текста через запятую,
// позиция в списке соответствует номеру строки сформированного модуля.
// Соответствие реквизитом формы быть не может, а строка может.
//
// Параметры:
//  ТекстОбработчика - Строка - Исходный текст обработчика.
//
// Возвращаемое значение:
//  Строка - Номера строк исходного текста через запятую.
//
&НаСервереБезКонтекста
Функция СтрокаСоответствияСтрок(Знач ТекстОбработчика)

	Соответствие = инт_ГенераторОбработок.СоответствиеСтрокМодуля(ТекстОбработчика);

	ПоследняяСтрока = 0;
	Для Каждого КлючИЗначение Из Соответствие Цикл
		ПоследняяСтрока = Макс(ПоследняяСтрока, КлючИЗначение.Ключ);
	КонецЦикла;

	НомераСтрок = Новый Массив;
	Для НомерСтроки = 1 По ПоследняяСтрока Цикл
		ИсходнаяСтрока = Соответствие[НомерСтроки];
		НомераСтрок.Добавить(Формат(?(ИсходнаяСтрока = Неопределено, 0, ИсходнаяСтрока), "ЧГ=0"));
	КонецЦикла;

	Возврат СтрСоединить(НомераСтрок, ",");

КонецФункции

#КонецОбласти

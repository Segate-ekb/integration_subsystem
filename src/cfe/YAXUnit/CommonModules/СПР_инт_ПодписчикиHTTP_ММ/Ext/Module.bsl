// {{{ Набор: ПостОбработкаHTTP

// Обработчик из табличной части исполняется и меняет ответ так, как задано его текстом.
Процедура ПостОбработкаHTTP_ОбработчикТабличнойЧастиИсполняется() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("http"));
	Ответ = ГенераторТестовыхДанных.ОтветПодписчика(200);
	
	// Act
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ);
	
	// Assert
	ЮТест.ОжидаетЧто(Ответ, "Ответ после пост-обработки").Свойство("метка").Равно("http");
	
КонецПроцедуры

// Обработчику доступны обе переменные под прежними именами. ИсходныеДанные объявляет
// сам генератор, поэтому из набора дополнительных переменных они убраны, а не переименованы.
Процедура ПостОбработкаHTTP_ОбработчикуДоступныОтветИИсходныеДанные() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		"Ответ.Вставить(""исходные"", ИсходныеДанные);");
	Ответ = ГенераторТестовыхДанных.ОтветПодписчика(200);
	ИсходныеДанные = ГенераторТестовыхДанных.демо_Документ();
	
	// Act
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ, ИсходныеДанные);
	
	// Assert
	ЮТест.ОжидаетЧто(Ответ, "Ответ после пост-обработки")
		.Свойство("исходные").Равно(ИсходныеДанные);
	
КонецПроцедуры

// Обработчик по умолчанию сообщает и код состояния, и тело ответа: по одному телу
// причину отказа не восстановить.
Процедура ПостОбработкаHTTP_ОбработчикПоУмолчаниюСообщаетКодИТело() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикHTTP();
	Ответ = ГенераторТестовыхДанных.ОтветПодписчика(503, "сервис недоступен");
	
	// Act
	ТекстОшибки = "";
	Попытка
		Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(ТекстОшибки, "Текст исключения обработчика по умолчанию")
		.Содержит("503")
		.Содержит("сервис недоступен");
	
КонецПроцедуры

// Набор дополнительных переменных берётся у рабочего кода подменой зависимости, а не
// составляется тестом: иначе проверка не заметила бы возврата задвоенного объявления.
// Наблюдается запись подписчика: с ТР-Ф-051 обработка собирается там, а не при пост-обработке.
Процедура ПостОбработкаHTTP_МодульОбъявляетИсходныеДанныеОднократно() Экспорт
	
	// Arrange
	Мокито.Обучение(инт_ГенераторОбработок)
		.Наблюдать("СкомпилироватьОбработку")
		.Прогон();
	
	// Act
	ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("объявления"));
	
	// Assert
	Вызовы = Мокито.Проверить(инт_ГенераторОбработок).Вызовы("СкомпилироватьОбработку");
	ЮТест.ОжидаетЧто(Вызовы, "Вызовы компиляции обработчика пост-обработки").ИмеетДлину(1);
	
	РезультатГенерации = инт_ГенераторОбработок.СформироватьМодульОбъекта(
		Вызовы[0].Параметры[0], Вызовы[0].Параметры[1], Вызовы[0].Параметры[2]);
	
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(РезультатГенерации.ТекстМодуля, "Перем ИсходныеДанные;"),
			"Объявлений переменной ИсходныеДанные в модуле обработчика")
		.Равно(1);
	
КонецПроцедуры

// Отказ пост-обработки журналируется собственным событием: по журналу его отличают
// от ошибки отправки сообщения, которую пишет менеджер потоков отправки.
Процедура ПостОбработкаHTTP_ОтказЖурналируетсяСвоимСобытием() Экспорт
	
	// Arrange
	Метка = "ТР-Ф-062-" + Строка(Новый УникальныйИдентификатор);
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		СтрШаблон("ВызватьИсключение ""%1"";", Метка));
	Ответ = ГенераторТестовыхДанных.ОтветПодписчика(200);
	НачалоПроверки = ТекущаяДатаСеанса();
	
	// Act
	Попытка
		Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ);
	Исключение
		// Исключение поднимается вызывающей стороне намеренно, проверяется запись журнала.
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(СобытияЖурналаСТекстом(НачалоПроверки, Метка),
			"События журнала регистрации с текстом отказа пост-обработки")
		.Равно("ПодсистемаИнтеграции.Подписчики.ПостОбработкаОтвета");
	
КонецПроцедуры

// }}}

// {{{ Набор: КешированиеПостОбработкиHTTP

// Обработка собирается при записи подписчика, поэтому пост-обработка сообщения
// компиляции уже не требует.
Процедура КешированиеHTTP_ЗаписьПодписчикаЗаполняетСохраненнуюОбработку() Экспорт
	
	// Arrange + Act
	ТекстОбработчика = ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("запись");
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(), 200, ТекстОбработчика);
	
	// Assert
	ЮТест.ОжидаетЧто(Подписчик.ПостПроцессинг[0].СкомпилированныйОбработчик.Получить(),
			"Сохранённая обработка строки пост-процессинга")
		.ИмеетТип("Структура")
		.Свойство("Версия").Равно(инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика))
		.Свойство("ПостОбработка").Равно(Истина)
		.Свойство("ДвоичныеДанные").ИмеетТип("ДвоичныеДанные");
	
КонецПроцедуры

// Пустой текст обработчика оставлять собранную обработку не должен: она относилась
// бы к тексту, которого больше нет.
Процедура КешированиеHTTP_ОчисткаТекстаОчищаетСохраненнуюОбработку() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("очистка"));
	
	// Act
	ОбъектПодписчика = Подписчик.ПолучитьОбъект();
	ОбъектПодписчика.ПостПроцессинг[0].Обработчик = "";
	ОбъектПодписчика.Записать();
	
	// Assert
	ЮТест.ОжидаетЧто(Подписчик.ПостПроцессинг[0].СкомпилированныйОбработчик.Получить(),
			"Сохранённая обработка после очистки текста")
		.Равно(Неопределено);
	
КонецПроцедуры

// Пачка сообщений одной версии обработчика обходится сохранённой обработкой и одним
// подключением на сеанс. Число подключений проверяется наравне с числом компиляций:
// нулевая статистика сама по себе неотличима от неработающей подмены.
Процедура КешированиеHTTP_ПачкаСообщенийНеКомпилируетИНеПодключаетПовторно() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("пачка"));
	
	Мокито.Обучение(инт_ГенераторОбработок)
		.Наблюдать("СкомпилироватьОбработку")
		.Наблюдать("ПодключитьОбработку")
		.Прогон();
	
	// Act
	Для НомерСообщения = 1 По 100 Цикл
		Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(
			Подписчик, ГенераторТестовыхДанных.ОтветПодписчика(200, Формат(НомерСообщения, "ЧГ=0")));
	КонецЦикла;
	
	// Assert
	Мокито.Проверить(инт_ГенераторОбработок, "Подключений на пачку из 100 сообщений")
		.КоличествоВызовов("ПодключитьОбработку")
		.Равно(1);
	Мокито.Проверить(инт_ГенераторОбработок, "Компиляций на пачку из 100 сообщений")
		.КоличествоВызовов("СкомпилироватьОбработку")
		.Равно(0);
	
КонецПроцедуры

// Обработка, собранная без переменной Ответ, собрана и без точки входа пост-обработки.
// Текст при этом совпадает, поэтому одной сверки версии для отказа от неё не хватает.
Процедура КешированиеHTTP_СохраненнаяБезТочкиВходаНеИспользуется() Экспорт
	
	// Arrange
	ТекстОбработчика = ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой("свежая");
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(), 200, ТекстОбработчика);
	
	// Запись в режиме загрузки: иначе обработка была бы пересобрана рабочим кодом.
	ОбъектПодписчика = Подписчик.ПолучитьОбъект();
	ОбъектПодписчика.ПостПроцессинг[0].СкомпилированныйОбработчик = Новый ХранилищеЗначения(
		инт_ГенераторОбработок.СохраняемаяОбработка(ТекстОбработчика));
	// СохраняемаяОбработка без признака точки входа собирает модуль без ОбработатьПостПроцессинг.
	ОбъектПодписчика.ОбменДанными.Загрузка = Истина;
	ОбъектПодписчика.Записать();
	
	Ответ = ГенераторТестовыхДанных.ОтветПодписчика(200);
	Мокито.Обучение(инт_ГенераторОбработок)
		.Наблюдать("СкомпилироватьОбработку")
		.Прогон();
	
	// Act
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ);
	
	// Assert
	Мокито.Проверить(инт_ГенераторОбработок, "Компиляций при непригодной сохранённой обработке")
		.КоличествоВызовов("СкомпилироватьОбработку")
		.Равно(1);
	ЮТест.ОжидаетЧто(Ответ, "Ответ после пост-обработки").Свойство("метка").Равно("свежая");
	
КонецПроцедуры

// Обработчик по умолчанию в базе не хранится, поэтому его собирает кэш сеанса:
// на подписчика приходится одна компиляция и одно подключение, а не по одному на сообщение.
Процедура КешированиеHTTP_ОбработчикПоУмолчаниюСобираетсяОдинРаз() Экспорт
	
	// Arrange
	Подписчик = ГенераторТестовыхДанных.ПодписчикHTTP();
	
	Мокито.Обучение(инт_ГенераторОбработок)
		.Наблюдать("СкомпилироватьОбработку")
		.Наблюдать("ПодключитьОбработку")
		.Прогон();
	
	// Act
	Для НомерСообщения = 1 По 10 Цикл
		Попытка
			Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(
				Подписчик, ГенераторТестовыхДанных.ОтветПодписчика(503, Формат(НомерСообщения, "ЧГ=0")));
		Исключение
			// Обработчик по умолчанию возбуждает исключение, здесь проверяется не оно.
		КонецПопытки;
	КонецЦикла;
	
	// Assert
	Мокито.Проверить(инт_ГенераторОбработок, "Компиляций обработчика по умолчанию на 10 сообщений")
		.КоличествоВызовов("СкомпилироватьОбработку")
		.Равно(1);
	Мокито.Проверить(инт_ГенераторОбработок, "Подключений обработчика по умолчанию на 10 сообщений")
		.КоличествоВызовов("ПодключитьОбработку")
		.Равно(1);
	
КонецПроцедуры

// }}}

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает события журнала регистрации, в комментарии которых встретилась метка.
//
// Параметры:
//  НачалоПроверки - Дата - Момент, начиная с которого просматривается журнал.
//  Метка          - Строка - Текст, по которому отбираются записи журнала.
//
// Возвращаемое значение:
//  Строка - Имена событий через запятую в порядке записей журнала.
//
Функция СобытияЖурналаСТекстом(Знач НачалоПроверки, Знач Метка)
	
	Журнал = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Журнал, Новый Структура("ДатаНачала", НачалоПроверки));
	
	События = Новый Массив;
	Для Каждого Запись Из Журнал Цикл
		Если СтрНайти(Запись.Комментарий, Метка) > 0 Тогда
			События.Добавить(Запись.Событие);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(События, ", ");
	
КонецФункции

#КонецОбласти

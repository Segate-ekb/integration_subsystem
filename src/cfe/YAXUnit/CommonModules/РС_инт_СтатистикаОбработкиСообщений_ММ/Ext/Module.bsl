Функция ЧислоЗаписейСтатистики(ПотокДанных)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.инт_СтатистикаОбработкиСообщений КАК Статистика
	|ГДЕ
	|	Статистика.ПотокДанных = &ПотокДанных");
	Запрос.УстановитьПараметр("ПотокДанных", ПотокДанных);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

Функция РезультатыЗаписейСтатистики(ПотокДанных)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Статистика.Успешно КАК Успешно
	|ИЗ
	|	РегистрСведений.инт_СтатистикаОбработкиСообщений КАК Статистика
	|ГДЕ
	|	Статистика.ПотокДанных = &ПотокДанных");
	Запрос.УстановитьПараметр("ПотокДанных", ПотокДанных);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Успешно");


Процедура ТестЗначениеРавноСуммеЗаписейИНакопленныхУдалений() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Формирование, Истина, 2);
	УдалитьТестовуюУстаревшуюСтатистику();

	Для Счетчик = 1 По 3 Цикл
		РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
			Новый УникальныйИдентификатор, ПотокДанных, 3, Истина);
	КонецЦикла;
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		Новый УникальныйИдентификатор, ПотокДанных, 3, Ложь);

	Значения = ЗначенияСчетчика(ПотокДанных);
	ЮТест.ОжидаетЧто(Значения.Получить("formation/success"), "Успешные операции формирования")
		.Равно(5);
	ЮТест.ОжидаетЧто(Значения.Получить("formation/error"), "Операции формирования с ошибкой")
		.Равно(1);

КонецПроцедуры

Процедура ТестОчисткаНеИзменяетЗначениеСчетчика() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Отправка, Истина, 4);
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОтправки(

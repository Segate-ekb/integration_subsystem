// BSLLS-off
// @strict-types
////////////////////////////////////////////////////////////////////////////////
// РС_инт_СтатистикаОбработкиСообщений_ММ
// Юнит-тесты модуля менеджера регистра сведений инт_СтатистикаОбработкиСообщений
// и построенного на нём счётчика pde_messages_processed_total: независимость записей
// об операциях (ТР-Ф-018), единая шкала времени записи и измерения длительности
// (ТР-Ф-018), порционная очистка устаревшей статистики в отдельных транзакциях
// (ТР-Ф-018), накопленное число удалённых записей и его согласованность с очисткой
// (ТР-Ф-009), значение счётчика и объявление метрик в индексе (ТР-Ф-009).
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.УдалениеТестовыхДанных()
		.ДобавитьТестовыйНабор("НезависимостьЗаписейСтатистики")
			.ДобавитьТест("ТестОтправкаТремПодписчикамСоздаетТриЗаписи")
			.ДобавитьТест("ТестДвеПопыткиОбработкиСоздаютДвеЗаписиСРазнымРезультатом")
			.ДобавитьТест("ТестЧислоЗаписейРавноЧислуВызововЗаписиСтатистики")
		.ДобавитьТестовыйНабор("ШкалаВремениЗаписиСтатистики")
			.ДобавитьТест("ТестПериодЗаписиВзятИзУниверсальногоВремени")
		.ДобавитьТестовыйНабор("ПорционнаяОчисткаУстаревшейСтатистики")
			.ДобавитьТест("ТестПорцияУдаляетНеБолееЗаданногоЧислаЗаписей")
			.ДобавитьТест("ТестОчисткаУдаляетУстаревшуюСтатистикуИСохраняетСвежую")
		.ДобавитьТестовыйНабор("НакопленноеЧислоУдаленныхЗаписей")
			.ДобавитьТест("ТестУдаленныеЗаписиУчитываютсяВРазрезеИзмерений")
			.ДобавитьТест("ТестЗаписьСтатистикиНеИзменяетНакопленныйИтог")
			.ДобавитьТест("ТестПрерываниеТранзакцииПорцииНеИзменяетНиОдинИзРегистров")
		.ДобавитьТестовыйНабор("СчетчикВыполненныхОпераций")
			.ДобавитьТест("ТестЗначениеРавноСуммеЗаписейИНакопленныхУдалений")
			.ДобавитьТест("ТестОчисткаНеИзменяетЗначениеСчетчика")
			.ДобавитьТест("ТестПрерываниеОчисткиМеждуПорциямиНеИзменяетЗначениеСчетчика")
			.ДобавитьТест("ТестПовторнаяОбработкаУвеличиваетСчетчикЗаКаждуюПопытку")
			.ДобавитьТест("ТестБезОперацийСчетчикВыгружаетсяСНулем")
			.ДобавитьТест("ТестСчетчикВыгружаетсяТипомCounterСТремяМетками")
		.ДобавитьТестовыйНабор("ОбъявлениеМетрикВИндексе")
			.ДобавитьТест("ТестИндексОбъявляетСчетчикВыполненныхОпераций")
			.ДобавитьТест("ТестМетрикаПропускнойСпособностиВМинутуОбъявленаНеактивной");

КонецПроцедуры

Процедура ПередКаждымТестом() Экспорт

	ЮТест.КонтекстТеста().Вставить("ТестовыеПотоки", Новый Массив);

КонецПроцедуры

// Удаляет записи обоих регистров по потокам данных, созданным тестом: удаление тестовых
// данных YAXUnit снимает только объекты, созданные конструктором тестовых данных.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст = Неопределено Или НЕ Контекст.Свойство("ТестовыеПотоки") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ПотокДанных Из Контекст.ТестовыеПотоки Цикл
		УдалитьЗаписиПотока(ПотокДанных);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Тесты

// {{{ Набор: НезависимостьЗаписейСтатистики

Процедура ТестОтправкаТремПодписчикамСоздаетТриЗаписи() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ИдентификаторСообщения = Новый УникальныйИдентификатор;

	Для Счетчик = 1 По 3 Цикл
		РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОтправки(
			ИдентификаторСообщения, ПотокДанных, 10, Истина, ГенераторТестовыхДанных.Подписчик());
	КонецЦикла;

	ЮТест.ОжидаетЧто(ЧислоЗаписейСтатистики(ПотокДанных), "Число записей статистики")
		.Равно(3);

КонецПроцедуры

Процедура ТестДвеПопыткиОбработкиСоздаютДвеЗаписиСРазнымРезультатом() Экспорт

	ПотокДанных = ВходящийПотокДанных();
	ИдентификаторСообщения = Новый УникальныйИдентификатор;

	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОбработкиВходящего(
		ИдентификаторСообщения, ПотокДанных, 12, Ложь);
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОбработкиВходящего(
		ИдентификаторСообщения, ПотокДанных, 15, Истина);

	ЮТест.ОжидаетЧто(ЧислоЗаписейСтатистики(ПотокДанных), "Число записей статистики")
		.Равно(2);
	ЮТест.ОжидаетЧто(РезультатыЗаписейСтатистики(ПотокДанных), "Признаки успешности записей")
		.Содержит(Истина)
		.Содержит(Ложь);

КонецПроцедуры

Процедура ТестЧислоЗаписейРавноЧислуВызововЗаписиСтатистики() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ИдентификаторСообщения = Новый УникальныйИдентификатор;

	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		ИдентификаторСообщения, ПотокДанных, 5, Ложь);
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		ИдентификаторСообщения, ПотокДанных, 6, Истина);

	Для Счетчик = 1 По 3 Цикл
		РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОтправки(
			ИдентификаторСообщения, ПотокДанных, 7, Истина, ГенераторТестовыхДанных.Подписчик());
	КонецЦикла;

	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОбработкиВходящего(
		ИдентификаторСообщения, ПотокДанных, 8, Истина);
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОбработкиВходящего(
		ИдентификаторСообщения, ПотокДанных, 9, Истина);

	ЮТест.ОжидаетЧто(ЧислоЗаписейСтатистики(ПотокДанных), "Число записей статистики")
		.Равно(7);

КонецПроцедуры

// {{{ Набор: ШкалаВремениЗаписиСтатистики

Процедура ТестПериодЗаписиВзятИзУниверсальногоВремени() Экспорт

	ПотокДанных = ИсходящийПотокДанных();

	МоментДоЗаписи = ТекущаяУниверсальнаяДата();
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		Новый УникальныйИдентификатор, ПотокДанных, 3, Истина);
	МоментПослеЗаписи = ТекущаяУниверсальнаяДата();

	ЮТест.ОжидаетЧто(ПериодПервойЗаписиСтатистики(ПотокДанных), "Период записи статистики")
		.МеждуВключаяГраницы(МоментДоЗаписи, МоментПослеЗаписи);

КонецПроцедуры

// {{{ Набор: ПорционнаяОчисткаУстаревшейСтатистики


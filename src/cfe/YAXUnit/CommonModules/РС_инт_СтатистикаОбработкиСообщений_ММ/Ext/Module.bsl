КонецПроцедуры

Процедура ПередКаждымТестом() Экспорт

	ЮТест.КонтекстТеста().Вставить("ТестовыеПотоки", Новый Массив);

КонецПроцедуры

// Удаляет записи обоих регистров по потокам данных, созданным тестом: удаление тестовых
// данных YAXUnit снимает только объекты, созданные конструктором тестовых данных.
Процедура ПослеКаждогоТеста() Экспорт

	Мокито.Сбросить();

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Свойство("ИсходноеОкноАгрегации") Тогда
		Константы.пэмОкноАгрегацииМетрикДлительностиСек.Установить(Контекст.ИсходноеОкноАгрегации);
	КонецЕсли;

	Если НЕ Контекст.Свойство("ТестовыеПотоки") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ПотокДанных Из Контекст.ТестовыеПотоки Цикл
		УдалитьЗаписиПотока(ПотокДанных);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


Процедура ТестОтправкаТремПодписчикамСоздаетТриЗаписи() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ИдентификаторСообщения = Новый УникальныйИдентификатор;

	Для Счетчик = 1 По 3 Цикл
		РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуОтправки(
			ИдентификаторСообщения, ПотокДанных, 10, Истина, ГенераторТестовыхДанных.Подписчик());
	КонецЦикла;

	ЮТест.ОжидаетЧто(ЧислоЗаписейСтатистики(ПотокДанных), "Число записей статистики")
		.Равно(3);

КонецПроцедуры


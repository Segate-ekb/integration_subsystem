КонецПроцедуры

// Записывает успешную операцию заданным моментом универсального времени: менеджер записи
// регистра пишет операцию текущим моментом, а окно агрегации проверяется на прошлом.
Процедура ЗаписатьСтатистикуСПериодом(ПотокДанных, ТипОперации, Период, Подписчик = Неопределено)

	Запись = РегистрыСведений.инт_СтатистикаОбработкиСообщений.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.ИдентификаторОперации = Новый УникальныйИдентификатор;
	Запись.ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Запись.ТипОперации = ТипОперации;
	Запись.ПотокДанных = ПотокДанных;
	Запись.ДлительностьМс = 30;
	Запись.Успешно = Истина;

	Если Подписчик <> Неопределено Тогда
		Запись.Подписчик = Подписчик;
	КонецЕсли;

	Запись.Записать();

КонецПроцедуры

// Задаёт окно агрегации метрик длительности на время теста и запоминает исходное значение,
// по которому обработчик ПослеКаждогоТеста возвращает настройку базы.
Процедура ЗадатьОкноАгрегации(Окно)

	Контекст = ЮТест.КонтекстТеста();
	Если НЕ Контекст.Свойство("ИсходноеОкноАгрегации") Тогда
		Контекст.Вставить("ИсходноеОкноАгрегации",
			Константы.пэмОкноАгрегацииМетрикДлительностиСек.Получить());
	КонецЕсли;

	Константы.пэмОкноАгрегацииМетрикДлительностиСек.Установить(Окно);

КонецПроцедуры


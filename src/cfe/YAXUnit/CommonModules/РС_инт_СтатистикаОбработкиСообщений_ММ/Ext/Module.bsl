// Создаёт активный поток данных с уникальным наименованием: значение метки flow_name
// счётчика берётся из наименования, и по нему тест отбирает свои ряды метрики.
//
// Параметры:
//   Исходящий - Булево - создать исходящий поток данных, иначе входящий
//
// Возвращаемое значение:
//   СправочникСсылка.инт_ПотокиДанных - созданный поток данных
//
Функция ТестовыйПотокДанных(Исходящий)

	Если Исходящий Тогда
		ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий();
	Иначе
		ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
	КонецЕсли;

	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.Наименование = "Поток " + Строка(Новый УникальныйИдентификатор);
	ОбъектПотока.Записать();

	ЮТест.КонтекстТеста().ТестовыеПотоки.Добавить(ПотокДанных);

	Возврат ПотокДанных;

КонецФункции

// Записывает статистику с периодом, заведомо более ранним, чем граница тестового
// устаревания: очистка теста не затрагивает записей, накопленных базой ранее.
Процедура ЗаписатьУстаревшуюСтатистику(ПотокДанных, ТипОперации, Успешно, Количество)

	Для Счетчик = 1 По Количество Цикл
		Запись = РегистрыСведений.инт_СтатистикаОбработкиСообщений.СоздатьМенеджерЗаписи();
		Запись.Период = НачалоТестовогоУстаревания() + Счетчик;
		Запись.ИдентификаторОперации = Новый УникальныйИдентификатор;
		Запись.ИдентификаторСообщения = Новый УникальныйИдентификатор;
		Запись.ТипОперации = ТипОперации;
		Запись.ПотокДанных = ПотокДанных;
		Запись.ДлительностьМс = 1;
		Запись.Успешно = Успешно;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры


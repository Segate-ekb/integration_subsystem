		.Равно(ЗначениеДоОчистки);

КонецПроцедуры

Процедура ТестПрерываниеОчисткиМеждуПорциямиНеИзменяетЗначениеСчетчика() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Формирование, Истина, 5);

	ЗначениеДоПорции = СуммаСчетчика(ПотокДанных);
	Удалено = РегистрыСведений.инт_СтатистикаОбработкиСообщений.УдалитьПорциюУстаревшейСтатистики(
		ГраницаТестовогоУстаревания(), 2);


// Создаёт активный поток данных с уникальным наименованием: значение метки flow_name
// счётчика берётся из наименования, и по нему тест отбирает свои ряды метрики.
//
// Параметры:
//   Исходящий - Булево - создать исходящий поток данных, иначе входящий
//   Асинхронный - Булево - режим обработки входящего потока данных
//
// Возвращаемое значение:
//   СправочникСсылка.инт_ПотокиДанных - созданный поток данных
//
Функция ТестовыйПотокДанных(Исходящий, Асинхронный = Истина)

	Если Исходящий Тогда
		ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий();
	Иначе
		ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий(Истина, 0, 0, "", Асинхронный);
	КонецЕсли;

	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.Наименование = "Поток " + Строка(Новый УникальныйИдентификатор);
	ОбъектПотока.Записать();

	ЮТест.КонтекстТеста().ТестовыеПотоки.Добавить(ПотокДанных);

	Возврат ПотокДанных;

КонецФункции

// Создаёт подписчика с известным наименованием: значение метки subscriber метрики
// длительности отправки берётся из наименования, и по нему тест отбирает свои ряды.
//
// Возвращаемое значение:
//   ОпределяемыйТип.инт_Подписчик - созданный подписчик
//
Функция ТестовыйПодписчик()

	Подписчик = ГенераторТестовыхДанных.Подписчик();

	ОбъектПодписчика = Подписчик.ПолучитьОбъект();
	ОбъектПодписчика.Наименование = "Подписчик " + Строка(Новый УникальныйИдентификатор);
	ОбъектПодписчика.Записать();

	Возврат Подписчик;

КонецФункции

// Оставляет потоку данных единственного подписчика с известным наименованием: конструктор
// тестовых данных наполняет поток подписчиками со случайными наименованиями, по которым
// нельзя предсказать состав нулевых рядов метрики.
//
// Возвращаемое значение:
//   ОпределяемыйТип.инт_Подписчик - подписчик потока данных
//
Функция ЗадатьЕдинственногоПодписчика(ПотокДанных)

	Подписчик = ТестовыйПодписчик();

	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.ПодписчикиПотока.Очистить();
	ОбъектПотока.ПодписчикиПотока.Добавить().Подписчик = Подписчик;
	ОбъектПотока.Записать();

	Возврат Подписчик;

КонецФункции


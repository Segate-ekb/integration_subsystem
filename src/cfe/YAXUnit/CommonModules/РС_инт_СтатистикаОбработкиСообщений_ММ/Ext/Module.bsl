// {{{ Набор: НакопленноеЧислоУдаленныхЗаписей

Процедура ТестУдаленныеЗаписиУчитываютсяВРазрезеИзмерений() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Формирование, Истина, 2);
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Формирование, Ложь, 1);
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Отправка, Истина, 3);

	УдалитьТестовуюУстаревшуюСтатистику();

	Накоплено = НакопленныеУдаления(ПотокДанных);
	ЮТест.ОжидаетЧто(Накоплено.Получить("formation/success"), "Удалено операций формирования с успехом")
		.Равно(2);
	ЮТест.ОжидаетЧто(Накоплено.Получить("formation/error"), "Удалено операций формирования с ошибкой")
		.Равно(1);
	ЮТест.ОжидаетЧто(Накоплено.Получить("send/success"), "Удалено операций отправки с успехом")
		.Равно(3);

КонецПроцедуры

Процедура ТестЗаписьСтатистикиНеИзменяетНакопленныйИтог() Экспорт

	ПотокДанных = ИсходящийПотокДанных();

	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		Новый УникальныйИдентификатор, ПотокДанных, 3, Истина);

	ЮТест.ОжидаетЧто(НакопленныеУдаления(ПотокДанных).Количество(), "Записи накопленных удалений")
		.Равно(0);

КонецПроцедуры

Процедура ТестПрерываниеТранзакцииПорцииНеИзменяетНиОдинИзРегистров() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	ЗаписатьУстаревшуюСтатистику(ПотокДанных, Перечисления.инт_ТипыОперацийСтатистики.Формирование, Истина, 3);

	Мокито.Обучение(РегистрыСведений.инт_УдаленнаяСтатистикаОбработкиСообщений)
		.Когда("УчестьУдаленныеЗаписи").ВыброситьИсключение("Тестовая ошибка учёта удалённых записей")
		.Прогон();

	ЮТест.ОжидаетЧто(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
		.Метод("УдалитьПорциюУстаревшейСтатистики")
		.Параметр(ГраницаТестовогоУстаревания())
		.Параметр(10)
		.ВыбрасываетИсключение("Тестовая ошибка учёта удалённых записей");

	ЮТест.ОжидаетЧто(ЧислоЗаписейСтатистики(ПотокДанных), "Записи статистики после отката")
		.Равно(3);
	ЮТест.ОжидаетЧто(НакопленныеУдаления(ПотокДанных).Количество(), "Записи накопленных удалений после отката")
		.Равно(0);

КонецПроцедуры


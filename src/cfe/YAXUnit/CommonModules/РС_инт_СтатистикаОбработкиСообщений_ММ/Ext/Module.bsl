// Возвращает накопленные удаления потока данных: ключ соответствия — сочетание
// значений меток operation и status счётчика.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - сочетание меток вида "formation/success"
//     * Значение - Число - накопленное число удалённых записей
//
Функция НакопленныеУдаления(ПотокДанных)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Удаленные.ТипОперации КАК ТипОперации,
	|	Удаленные.Успешно КАК Успешно,
	|	Удаленные.КоличествоУдаленных КАК КоличествоУдаленных
	|ИЗ
	|	РегистрСведений.инт_УдаленнаяСтатистикаОбработкиСообщений КАК Удаленные
	|ГДЕ
	|	Удаленные.ПотокДанных = &ПотокДанных");
	Запрос.УстановитьПараметр("ПотокДанных", ПотокДанных);

	Накоплено = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Накоплено.Вставить(
			СочетаниеМеток(Выборка.ТипОперации, Выборка.Успешно), Выборка.КоличествоУдаленных);
	КонецЦикла;

	Возврат Накоплено;

КонецФункции

Функция СочетаниеМеток(ТипОперации, Успешно)

	Если ТипОперации = Перечисления.инт_ТипыОперацийСтатистики.Формирование Тогда
		Операция = "formation";
	ИначеЕсли ТипОперации = Перечисления.инт_ТипыОперацийСтатистики.Отправка Тогда
		Операция = "send";
	Иначе
		Операция = "incoming";
	КонецЕсли;

	Возврат Операция + "/" + ?(Успешно, "success", "error");

КонецФункции

// Возвращает значения счётчика pde_messages_processed_total по потоку данных.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - сочетание меток вида "formation/success"
//     * Значение - Число - значение счётчика
//
Функция ЗначенияСчетчика(ПотокДанных)

	Значения = Новый Соответствие;

	Для Каждого СтрокаРасчета Из ТаблицаРасчетаСчетчика() Цикл
		Если СтрокаРасчета["flow_name"] <> ПотокДанных.Наименование Тогда
			Продолжить;
		КонецЕсли;
		Значения.Вставить(
			СтрокаРасчета["operation"] + "/" + СтрокаРасчета["status"], СтрокаРасчета["value"]);
	КонецЦикла;

	Возврат Значения;

КонецФункции

Функция СуммаСчетчика(ПотокДанных)

	Сумма = 0;

	Для Каждого Ряд Из ЗначенияСчетчика(ПотокДанных) Цикл
		Сумма = Сумма + Ряд.Значение;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

Функция ТаблицаРасчетаСчетчика()

	Алгоритм = пэмМетрикиСервер.ПолучитьАлгоритмМетрикиИзМакета("пэмМетрика_pde_messages_processed_total");
	Расчет = пэмМетрикиСервер.СформироватьМетрику(Алгоритм);

	ЮТест.ОжидаетЧто(Расчет.Ошибка, "Ошибка расчёта счётчика: " + Расчет.ОписаниеОшибки).ЭтоЛожь();

	Возврат Расчет.МетрикаТаблицей;

КонецФункции

Функция СтрокаЗначенияПотока(ТекстМетрики, ПотокДанных)

	Для Каждого Строка Из СтрРазделить(ТекстМетрики, Символы.ПС, Ложь) Цикл
		Если СтрНайти(Строка, ПотокДанных.Наименование) > 0 Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Процедура УдалитьЗаписиПотока(ПотокДанных)

	Статистика = РегистрыСведений.инт_СтатистикаОбработкиСообщений.СоздатьНаборЗаписей();
	Статистика.Отбор.ПотокДанных.Установить(ПотокДанных);
	Статистика.Записать();

	Удаленные = РегистрыСведений.инт_УдаленнаяСтатистикаОбработкиСообщений.СоздатьНаборЗаписей();
	Удаленные.Отбор.ПотокДанных.Установить(ПотокДанных);
	Удаленные.Записать();

КонецПроцедуры

#КонецОбласти

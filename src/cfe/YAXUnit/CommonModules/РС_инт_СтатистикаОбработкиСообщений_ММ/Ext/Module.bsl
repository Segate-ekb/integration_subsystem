Процедура ТестБезОперацийСчетчикВыгружаетсяСНулем() Экспорт

	ПотокДанных = ИсходящийПотокДанных();

	Значения = ЗначенияСчетчика(ПотокДанных);
	ЮТест.ОжидаетЧто(Значения.Количество(), "Число рядов счётчика по потоку без операций").Равно(4);
	ЮТест.ОжидаетЧто(Значения.Получить("formation/success"), "Формирование с успехом").Равно(0);
	ЮТест.ОжидаетЧто(Значения.Получить("formation/error"), "Формирование с ошибкой").Равно(0);
	ЮТест.ОжидаетЧто(Значения.Получить("send/success"), "Отправка с успехом").Равно(0);
	ЮТест.ОжидаетЧто(Значения.Получить("send/error"), "Отправка с ошибкой").Равно(0);

КонецПроцедуры

Процедура ТестСчетчикВыгружаетсяТипомCounterСТремяМетками() Экспорт

	ПотокДанных = ИсходящийПотокДанных();
	РегистрыСведений.инт_СтатистикаОбработкиСообщений.ЗаписатьСтатистикуФормирования(
		Новый УникальныйИдентификатор, ПотокДанных, 3, Истина);

	Результат = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(
		"pde_messages_processed_total", Перечисления.пэмТипыМетрик.Counter, ТаблицаРасчетаСчетчика());

	ЮТест.ОжидаетЧто(Результат.Ошибка, "Признак ошибки вывода метрики").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.МетрикаСтрокой, "Текст метрики")
		.СодержитСтрокуПоШаблону("# TYPE pde_messages_processed_total counter");

	СтрокаРяда = СтрокаЗначенияПотока(Результат.МетрикаСтрокой, ПотокДанных);
	ЮТест.ОжидаетЧто(СтрокаРяда, "Строка ряда счётчика")
		.СодержитСтрокуПоШаблону("flow_name=")
		.СодержитСтрокуПоШаблону("operation=""formation""")
		.СодержитСтрокуПоШаблону("status=""success""");


// Возвращает ряды метрики-гистограммы, относящиеся к потоку данных.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - имя ряда без базового имени метрики и без метки flow_name,
//                       например _bucket{status="success",le="0.05"}
//     * Значение - Число - значение ряда в ответе
//
Функция РядыГистограммы(ИмяМакета, ИмяМетрики, ПотокДанных)

	Ряды = Новый Соответствие;
	МеткаПотока = "flow_name=""" + ПотокДанных.Наименование + """,";

	Для Каждого Строка Из СтрРазделить(ТекстГистограммы(ИмяМакета, ИмяМетрики), Символы.ПС, Ложь) Цикл

		Если СтрНайти(Строка, МеткаПотока) = 0 Тогда
			Продолжить;
		КонецЕсли;

		КонецМеток = СтрНайти(Строка, "} ");
		Идентификатор = СтрЗаменить(СтрЗаменить(Лев(Строка, КонецМеток), МеткаПотока, ""), ИмяМетрики, "");
		Ряды.Вставить(Идентификатор, ЧислоИзПредставления(Сред(Строка, КонецМеток + 2)));

	КонецЦикла;

	Возврат Ряды;

КонецФункции

// Рассчитывает метрику по макету и приводит её к формату экспозиции как гистограмму.
// Ошибка расчёта и нарушение контракта таблицы значений прерывают тест.
Функция ТекстГистограммы(ИмяМакета, ИмяМетрики)

	Алгоритм = пэмМетрикиСервер.ПолучитьАлгоритмМетрикиИзМакета(ИмяМакета);
	Расчет = пэмМетрикиСервер.СформироватьМетрику(Алгоритм);

	ЮТест.ОжидаетЧто(Расчет.Ошибка, "Ошибка расчёта метрики: " + Расчет.ОписаниеОшибки).ЭтоЛожь();

	Ответ = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(
		ИмяМетрики, Перечисления.пэмТипыМетрик.Histogram, Расчет.МетрикаТаблицей);

	ЮТест.ОжидаетЧто(Ответ.Ошибка, "Метрика не выведена: " + Ответ.ОписаниеОшибки).ЭтоЛожь();

	Возврат Ответ.МетрикаСтрокой;

КонецФункции

Функция ЧислоРядов(Ряды, Префикс)

	Количество = 0;
	Для Каждого Ряд Из Ряды Цикл
		Если Лев(Ряд.Ключ, СтрДлина(Префикс)) = Префикс Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Разбирает представление числа с точкой в качестве разделителя дробной части.
Функция ЧислоИзПредставления(Представление)

	Значение = СокрЛП(Представление);
	Части = СтрРазделить(Значение, ".");
	Результат = Число(Части[0]);

	Если Части.Количество() > 1 И НЕ ПустаяСтрока(Части[1]) Тогда
		Результат = Результат + Число(Части[1]) / Pow(10, СтрДлина(Части[1]));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Записывает статистику с периодом, заведомо более ранним, чем граница тестового
// устаревания: очистка теста не затрагивает записей, накопленных базой ранее.
Процедура ЗаписатьУстаревшуюСтатистику(ПотокДанных, ТипОперации, Успешно, Количество)

	Для Счетчик = 1 По Количество Цикл
		Запись = РегистрыСведений.инт_СтатистикаОбработкиСообщений.СоздатьМенеджерЗаписи();
		Запись.Период = НачалоТестовогоУстаревания() + Счетчик;
		Запись.ИдентификаторОперации = Новый УникальныйИдентификатор;
		Запись.ИдентификаторСообщения = Новый УникальныйИдентификатор;
		Запись.ТипОперации = ТипОперации;
		Запись.ПотокДанных = ПотокДанных;
		Запись.ДлительностьМс = 1;
		Запись.Успешно = Успешно;
		Запись.Записать();
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьТестовуюУстаревшуюСтатистику()

	РегистрыСведений.инт_СтатистикаОбработкиСообщений.УдалитьПорциюУстаревшейСтатистики(
		ГраницаТестовогоУстаревания(), 1000);

КонецПроцедуры


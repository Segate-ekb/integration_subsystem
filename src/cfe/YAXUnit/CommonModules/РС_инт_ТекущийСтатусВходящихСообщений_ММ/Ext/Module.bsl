// Так статус записывает форма очереди входящих, открытая без ключа записи: идентификатор сообщения пустой.
Процедура СтатусСПустымИдентификаторомНеЗаписывается() Экспорт

    ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусВходящихСообщений)
        .Метод("ЗаписатьСтатусСообщения")
        .Параметр(ПустойИдентификаторСообщения())
        .Параметр(Перечисления.инт_СтатусыВходящихСообщений.Новый)
        .ВыбрасываетИсключение("не заполнен идентификатор сообщения");

КонецПроцедуры

Процедура СтатусСПустымИдентификаторомНеЗаписываетсяНапрямую() Экспорт

    ЮТест.ОжидаетЧто(РС_инт_ТекущийСтатусВходящихСообщений_ММ)
        .Метод("ЗаписатьСтатусМенеджеромЗаписи")
        .Параметр(ПустойИдентификаторСообщения())
        .ВыбрасываетИсключение("не заполнен идентификатор сообщения");

КонецПроцедуры

Процедура ОсиротевшийСтатусНеВыбираетсяКОбработке() Экспорт

    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ИдентификаторСообщения = РегистрыСведений.инт_ОчередьВходящихСообщений.ЗарегистрироватьСообщение(
        Новый Структура("Hello", "world"), ПотокДанных);

    ОсиротевшийИдентификатор = Новый УникальныйИдентификатор;
    РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.ЗаписатьСтатусСообщения(
        ОсиротевшийИдентификатор, Перечисления.инт_СтатусыВходящихСообщений.Новый);

    ИдентификаторыКОбработке = РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.ПолучитьИдентификаторыСообщенийКФормированию();

    ЮТест.ОжидаетЧто(ИдентификаторыКОбработке, "Идентификаторы к обработке")
        .Содержит(ИдентификаторСообщения)
        .НеСодержит(ОсиротевшийИдентификатор);

КонецПроцедуры

// Паузу между попытками берут из потока, а его без записи в очереди нет: фиксация статуса не должна падать.
Процедура ОшибкаОбработкиФиксируетсяБезЗаписиВОчереди() Экспорт

    ОсиротевшийИдентификатор = Новый УникальныйИдентификатор;

    ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусВходящихСообщений)
        .Метод("ЗаписатьСтатусСообщения")
        .Параметр(ОсиротевшийИдентификатор)
        .Параметр(Перечисления.инт_СтатусыВходящихСообщений.ОшибкаОбработки)
        .Параметр("Тестовая ошибка обработки")
        .НеВыбрасываетИсключение();

    ЗаписьСтатуса = ЮТЗапросы.Запись("РегистрСведений.инт_ТекущийСтатусВходящихСообщений",
        ЮТест.Предикат().Реквизит("ИдентификаторСообщения").Равно(ОсиротевшийИдентификатор));

    ЮТест.ОжидаетЧто(ЗаписьСтатуса, "Запись статуса")
        .Заполнено()
            .Свойство("КоличествоПопыток").Равно(1)
            .Свойство("ДатаСледующейПопытки").Заполнено();

КонецПроцедуры

// Запись статуса в обход менеджера регистра - проверяет запрет на уровне набора записей.
Процедура ЗаписатьСтатусМенеджеромЗаписи(ИдентификаторСообщения) Экспорт

    Запись = РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.СоздатьМенеджерЗаписи();
    Запись.ИдентификаторСообщения = ИдентификаторСообщения;
    Запись.СтатусСообщения = Перечисления.инт_СтатусыВходящихСообщений.Новый;
    Запись.Записать(Истина);

КонецПроцедуры

#КонецОбласти


// Параметры:
//   ИмяМакета - Строка - имя общего макета с алгоритмом метрики
//   ИмяМетки - Строка - имя колонки-метки
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - значение метки
//     * Значение - Число - значение метрики
//
Функция ЗначенияПоМетке(ИмяМакета, ИмяМетки)

	Значения = Новый Соответствие;
	Для Каждого СтрокаРасчета Из ТаблицаРасчетаМетрики(ИмяМакета) Цикл
		Значения.Вставить(СтрокаРасчета[ИмяМетки], СтрокаРасчета["value"]);
	КонецЦикла;

	Возврат Значения;

КонецФункции

// Сверяет прирост длин очередей с эталонными значениями.
//
// Параметры:
//   ИсходныеДлины - Соответствие - длины очередей до создания тестовых данных
//   Входящая - Число - ожидаемый прирост длины входящей очереди
//   Исходящая - Число - ожидаемый прирост длины исходящей очереди
//   Рассылка - Число - ожидаемый прирост длины очереди рассылки
//
Процедура ПроверитьПриростДлин(ИсходныеДлины, Входящая, Исходящая, Рассылка)

	Длины = ДлиныОчередей();

	ЮТест.ОжидаетЧто(Длины["incoming"] - ИсходныеДлины["incoming"],
		"Прирост длины входящей очереди").Равно(Входящая);
	ЮТест.ОжидаетЧто(Длины["outgoing"] - ИсходныеДлины["outgoing"],
		"Прирост длины исходящей очереди").Равно(Исходящая);
	ЮТест.ОжидаетЧто(Длины["distribution"] - ИсходныеДлины["distribution"],
		"Прирост длины очереди рассылки").Равно(Рассылка);

КонецПроцедуры

// Возвращает возраст, заведомо превышающий возраст любой ожидающей операции очереди: отметка
// времени тестовой операции переносится в прошлое дальше самой ранней из имеющихся, поэтому
// итог метрики определяет именно она.
//
// Параметры:
//   Очередь - Строка - значение метки queue
//
// Возвращаемое значение:
//   Число - возраст в секундах
//
Функция ВозрастСтарше(Очередь)

	Возврат ВозрастОчередей()[Очередь] + 3600;


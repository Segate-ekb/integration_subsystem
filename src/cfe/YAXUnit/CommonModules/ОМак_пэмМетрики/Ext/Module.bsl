	ОжидаемыйВозраст = ВозрастСтарше("incoming");

	ИдентификаторСообщения = ВходящееСообщение(ВходящийПотокДанных(3));
	ЗадатьСтатусВходящего(ИдентификаторСообщения, Перечисления.инт_СтатусыВходящихСообщений.Новый);

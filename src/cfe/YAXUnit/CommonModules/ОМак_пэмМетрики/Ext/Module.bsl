// из наименования, и по нему тест отбирает свои строки расчёта.
//
// Параметры:
//   КоличествоПопытокОбработки - Число - предел попыток обработки сообщений потока данных
//
// Возвращаемое значение:
//   СправочникСсылка.инт_ПотокиДанных - созданный поток данных
//
Функция ВходящийПотокДанных(КоличествоПопытокОбработки)

	Возврат ПотокСУникальнымНаименованием(
		ГенераторТестовыхДанных.ПотокДанныхВходящий(Истина, КоличествоПопытокОбработки));

КонецФункции

Функция ИсходящийПотокДанных(КоличествоПопытокОбработки)

	Возврат ПотокСУникальнымНаименованием(
		ГенераторТестовыхДанных.ПотокДанныхИсходящий(Истина, КоличествоПопытокОбработки));

КонецФункции

Функция ПотокСУникальнымНаименованием(ПотокДанных)

	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.Наименование = "Поток " + Строка(Новый УникальныйИдентификатор);
	ОбъектПотока.Записать();

	Возврат ПотокДанных;

КонецФункции

Функция Подписчик(КоличествоПопытокОтправки)

	Возврат ГенераторТестовыхДанных.Подписчик(, КоличествоПопытокОтправки);

КонецФункции

// Возвращает по одному подписчику каждого вида: единицей очереди рассылки служит пара
// «сообщение, подписчик» независимо от вида подписчика.
//
// Возвращаемое значение:
//   Массив из ОпределяемыйТип.инт_Подписчик - подписчики пяти видов
//
Функция ПодписчикиВсехВидов()

	Виды = Новый Массив;
	Виды.Добавить(Перечисления.инт_ТипыПодписчиков.ПроизвольныйHTTP);
	Виды.Добавить(Перечисления.инт_ТипыПодписчиков.JRPC2);
	Виды.Добавить(Перечисления.инт_ТипыПодписчиков.ПодсистемаИнтеграции);
	Виды.Добавить(Перечисления.инт_ТипыПодписчиков.Kafka);
	Виды.Добавить(Перечисления.инт_ТипыПодписчиков.RabbitMQ);

	Подписчики = Новый Массив;
	Для Каждого ВидПодписчика Из Виды Цикл
		Подписчики.Добавить(ГенераторТестовыхДанных.Подписчик(ВидПодписчика, 3));
	КонецЦикла;

	Возврат Подписчики;

КонецФункции

Функция НовоеСообщение()

	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	ЮТест.КонтекстТеста().ТестовыеСообщения.Добавить(ИдентификаторСообщения);

	Возврат ИдентификаторСообщения;

КонецФункции

Функция ВходящееСообщение(ПотокДанных)

	ИдентификаторСообщения = НовоеСообщение();

	Запись = РегистрыСведений.инт_ОчередьВходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ПотокДанных = ПотокДанных;
	Запись.Записать(Истина);

	Возврат ИдентификаторСообщения;

КонецФункции

Функция ИсходящееСообщение(ПотокДанных)

	ИдентификаторСообщения = НовоеСообщение();

	Запись = РегистрыСведений.инт_ОчередьИсходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ПотокДанных = ПотокДанных;
	Запись.Записать(Истина);

	Возврат ИдентификаторСообщения;

КонецФункции

Функция ВходящееСообщениеСИсчерпаннымиПопытками(ПотокДанных)

	ИдентификаторСообщения = ВходящееСообщение(ПотокДанных);
	ЗадатьСтатусВходящего(ИдентификаторСообщения,
		Перечисления.инт_СтатусыВходящихСообщений.ОшибкаОбработки,
		ПотокДанных.КоличествоПопытокОбработки);

	Возврат ИдентификаторСообщения;

КонецФункции

Процедура ЗадатьСтатусВходящего(ИдентификаторСообщения, СтатусСообщения, КоличествоПопыток = 0)

	Запись = РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.СтатусСообщения = СтатусСообщения;
	Запись.КоличествоПопыток = КоличествоПопыток;
	Запись.ТекстОшибки = ТекстОшибки(
		Перечисления.инт_СтатусыВходящихСообщений.ЭтоОшибочныйСтатус(СтатусСообщения));
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ЗадатьСтатусИсходящего(ИдентификаторСообщения, СтатусСообщения, КоличествоПопыток = 0)

	Запись = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.СтатусСообщения = СтатусСообщения;
	Запись.КоличествоПопыток = КоличествоПопыток;
	Запись.ТекстОшибки = ТекстОшибки(
		Перечисления.инт_СтатусыИсходящихСообщений.ЭтоОшибочныйСтатус(СтатусСообщения));
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ЗадатьСтатусРассылки(ИдентификаторСообщения, ПодписчикСообщения, СтатусСообщения,
	КоличествоПопыток = 0)

	Запись = РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Подписчик = ПодписчикСообщения;
	Запись.СтатусСообщения = СтатусСообщения;
	Запись.КоличествоПопыток = КоличествоПопыток;
	Запись.ТекстОшибки = ТекстОшибки(
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.ЭтоОшибочныйСтатус(СтатусСообщения));
	Запись.Записать(Истина);

КонецПроцедуры

// Регистр текущего статуса не принимает ошибочный статус без текста ошибки.
//
// Параметры:
//   ЭтоОшибочныйСтатус - Булево - статус операции является ошибочным
//
// Возвращаемое значение:
//   Строка - текст ошибки записи регистра
//
Функция ТекстОшибки(ЭтоОшибочныйСтатус)

	Возврат ?(ЭтоОшибочныйСтатус, "Ошибка тестовых данных", "");

КонецФункции

// Переносит отметку истории статусов операции в прошлое: запись истории создаётся обработчиком
// записи регистра текущего статуса моментом записи, а возраст очереди проверяется на операции,
// поставленной в очередь заданное время назад.
//
// Параметры:
//   ИдентификаторСообщения - УникальныйИдентификатор - сообщение
//   СтатусСообщения - ПеречислениеСсылка.инт_СтатусыВходящихСообщений - статус в истории
//   Возраст - Число - возраст отметки времени в секундах
//
Процедура ЗадатьИсториюВходящего(ИдентификаторСообщения, СтатусСообщения, Возраст)

	ОчиститьЗаписиРегистра(РегистрыСведений.инт_ИсторияСтатусовВходящихСообщений,
		ИдентификаторСообщения);

	Запись = РегистрыСведений.инт_ИсторияСтатусовВходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.Период = инт_ОбщегоНазначения.ВремяБазы() - Возраст;
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.СтатусСообщения = СтатусСообщения;
	Запись.Записать(Истина);

КонецПроцедуры

Процедура ЗадатьИсториюРассылки(ИдентификаторСообщения, ПодписчикСообщения, СтатусСообщения, Возраст)

	ОчиститьЗаписиРегистра(РегистрыСведений.инт_ИсторияСтатусовРассылкиСообщений,
		ИдентификаторСообщения);

	ДобавитьИсториюРассылки(ИдентификаторСообщения, ПодписчикСообщения, СтатусСообщения, Возраст);

КонецПроцедуры

Процедура ЗадатьИсториюРассылкиВсехПодписчиков(ИдентификаторСообщения, Подписчики, Возраст)

	ОчиститьЗаписиРегистра(РегистрыСведений.инт_ИсторияСтатусовРассылкиСообщений,
		ИдентификаторСообщения);

	Для Каждого ПодписчикСообщения Из Подписчики Цикл
		ДобавитьИсториюРассылки(ИдентификаторСообщения, ПодписчикСообщения,
			Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый, Возраст);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьИсториюРассылки(ИдентификаторСообщения, ПодписчикСообщения, СтатусСообщения, Возраст)

	Запись = РегистрыСведений.инт_ИсторияСтатусовРассылкиСообщений.СоздатьМенеджерЗаписи();
	Запись.Период = инт_ОбщегоНазначения.ВремяБазы() - Возраст;
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Подписчик = ПодписчикСообщения;
	Запись.СтатусСообщения = СтатусСообщения;
	Запись.Записать(Истина);

КонецПроцедуры

Процедура УдалитьЗаписиСообщения(ИдентификаторСообщения)

	Регистры = Новый Массив;
	Регистры.Добавить(РегистрыСведений.инт_ОчередьВходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ОчередьИсходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ТекущийСтатусВходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ИсторияСтатусовВходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ИсторияСтатусовИсходящихСообщений);
	Регистры.Добавить(РегистрыСведений.инт_ИсторияСтатусовРассылкиСообщений);
	Регистры.Добавить(РегистрыСведений.инт_СообщенияКУдалению);

	Для Каждого МенеджерРегистра Из Регистры Цикл
		ОчиститьЗаписиРегистра(МенеджерРегистра, ИдентификаторСообщения);
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьЗаписиРегистра(МенеджерРегистра, ИдентификаторСообщения)

	НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(ИдентификаторСообщения);
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

	ЮТест.ОжидаетЧто(ИменаКолонок(ТаблицаРасчета), "Набор колонок расчёта").Равно("queue,value");
	ЮТест.ОжидаетЧто(ТаблицаРасчета.Количество(), "Число временных последовательностей").Равно(3);
	ЮТест.ОжидаетЧто(ЗначенияКолонки(ТаблицаРасчета, "queue"), "Значения метки queue")
		.Равно("distribution,incoming,outgoing");

	Для Каждого СтрокаРасчета Из ТаблицаРасчета Цикл
		ЮТест.ОжидаетЧто(СтрокаРасчета["value"], "Длина очереди " + СтрокаРасчета["queue"])
			.БольшеИлиРавно(0);
	КонецЦикла;


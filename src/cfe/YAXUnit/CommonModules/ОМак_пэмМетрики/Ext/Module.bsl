Процедура ПередКаждымТестом() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ТестовыеСообщения", Новый Массив);
	Контекст.Вставить("ТестовыеМетрики", Новый Массив);

КонецПроцедуры

// Снимает записи регистров и метрики, созданные тестом: удаление тестовых данных YAXUnit
// снимает только объекты, созданные конструктором тестовых данных.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Свойство("ИсходныйЧасовойПояс") Тогда
		УстановитьЧасовойПоясСеанса(Контекст.ИсходныйЧасовойПояс);
	КонецЕсли;

	Если Контекст.Свойство("ИсходныеНастройкиРасчета") Тогда
		ВосстановитьНастройкиРасчетаМетрик(Контекст.ИсходныеНастройкиРасчета);
	КонецЕсли;

	Для Каждого ИдентификаторСообщения Из Контекст.ТестовыеСообщения Цикл
		УдалитьЗаписиСообщения(ИдентификаторСообщения);
	КонецЦикла;

	Для Каждого Метрика Из Контекст.ТестовыеМетрики Цикл
		УдалитьСостояниеМетрики(Метрика);
		ОбъектМетрики = Метрика.ПолучитьОбъект();
		Если ОбъектМетрики <> Неопределено Тогда
			ОбъектМетрики.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


Процедура ТестОперацияБезИсторииСтатусовИзОтбораНеИсключается() Экспорт

	ИсходныеДлины = ДлиныОчередей();
	ИсходныйВозраст = ВозрастОчередей()["distribution"];

	ИдентификаторСообщения = ИсходящееСообщение(ИсходящийПотокДанных(3));
	ЗадатьСтатусРассылки(ИдентификаторСообщения, Подписчик(3),
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый);
	ОчиститьЗаписиРегистра(РегистрыСведений.инт_ИсторияСтатусовРассылкиСообщений,
		ИдентификаторСообщения);

	ПроверитьПриростДлин(ИсходныеДлины, 0, 0, 1);
	ЮТест.ОжидаетЧто(ВозрастОчередей()["distribution"] - ИсходныйВозраст,
		"Операция без отметок времени расчёт не прерывает и возраст очереди не изменяет")
		.МеньшеИлиРавно(1);


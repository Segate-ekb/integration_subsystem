//   ТаблицаЗначений - результат расчёта метрики
//
Функция ТаблицаРасчетаМетрики(ИмяМакета)

	Алгоритм = пэмМетрикиСервер.ПолучитьАлгоритмМетрикиИзМакета(ИмяМакета);
	Расчет = пэмМетрикиСервер.СформироватьМетрику(Алгоритм);

	ЮТест.ОжидаетЧто(Расчет.Ошибка,
		"Ошибка расчёта макета " + ИмяМакета + ": " + Расчет.ОписаниеОшибки).ЭтоЛожь();

	Возврат Расчет.МетрикаТаблицей;

КонецФункции

// Параметры:
//   ТаблицаРасчета - ТаблицаЗначений - результат расчёта метрики
//
// Возвращаемое значение:
//   Строка - имена колонок таблицы в порядке сортировки через запятую
//
Функция ИменаКолонок(ТаблицаРасчета)

	Имена = Новый Массив;
	Для Каждого Колонка Из ТаблицаРасчета.Колонки Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;

	Возврат СтрокаСортированныхЗначений(Имена);

КонецФункции

// Параметры:
//   ТаблицаРасчета - ТаблицаЗначений - результат расчёта метрики
//   ИмяКолонки - Строка - имя колонки таблицы
//
// Возвращаемое значение:
//   Строка - значения колонки в порядке сортировки через запятую
//
Функция ЗначенияКолонки(ТаблицаРасчета, ИмяКолонки)

	Возврат СтрокаСортированныхЗначений(ТаблицаРасчета.ВыгрузитьКолонку(ИмяКолонки));

КонецФункции

// Возвращает значения коллекции строкой в порядке сортировки: порядок строк расчёта
// метрики запросом не задан и сравнивать его нельзя.
//
// Параметры:
//   Значения - Массив - сравниваемые значения
//
// Возвращаемое значение:
//   Строка - значения в порядке сортировки через запятую
//
Функция СтрокаСортированныхЗначений(Значения)

	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Значения);
	Список.СортироватьПоЗначению();

	Отсортированные = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Отсортированные.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат СтрСоединить(Отсортированные, ",");

КонецФункции

// Возвращает длины очередей сообщений в разрезе метки queue.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//     * Ключ - Строка - значение метки queue
//     * Значение - Число - значение метрики
//

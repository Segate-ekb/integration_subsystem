	ЮТест.КонтекстТеста().Вставить("ИсходныеНастройкиРасчета", ИсходныеНастройки);

	Константы.пэмМногопоточныйРасчетМетрик.Установить(Ложь);
	Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Установить(120);

КонецПроцедуры

// Очищает текст алгоритма встроенных метрик, чтобы первоначальное заполнение перечитало
// их из макетов. Без очистки заполнение обновляет метрику только при возросшей версии,
// и проверка ответа зависела бы от того, какая версия однажды попала в базу.
Процедура ОчиститьАлгоритмыВстроенныхМетрик()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Метрики.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.пэмМетрики КАК Метрики
	|ГДЕ
	|	Метрики.Предопределенный";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОписаниеМетрики = Выборка.Ссылка.ПолучитьОбъект();
		ОписаниеМетрики.Алгоритм = "";
		ОписаниеМетрики.Записать();
	КонецЦикла;

КонецПроцедуры

// Параметры:
//   ИсходныеНастройки - Структура - настройки расчёта метрик, см. ЗадатьПоследовательныйРасчетМетрик

#Область СлужебныеПроцедурыИФункции // BSLLS:EmptyRegion-off

// Незаполненный обработчик должен быть назван причиной, а не превращаться в системное
// сообщение платформы о ненайденной внешней обработке.
Процедура ФормированиеСообщенияБезОбработчикаНазываетПотокИПричину() Экспорт

    // Arrange
    ПотокДанных = ПотокБезОбработчика(Перечисления.инт_НаправлениеПотокаДанных.Исходящий);

    // Act
    ТекстОшибки = "";
    Попытка
        Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(
            ГенераторТестовыхДанных.демо_Документ(), ПотокДанных);
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Assert
    ЮТест.ОжидаетЧто(ТекстОшибки, "Ошибка формирования сообщения без обработчика")
        .Содержит("Обработчик потока данных не заполнен")
        .Содержит(ПотокДанных.Наименование)
        .НеСодержит("Внешняя обработка не найдена");

КонецПроцедуры

// То же для входящего потока: путь другой, диагностика должна быть та же.
Процедура ОбработкаВходящегоБезОбработчикаНазываетПотокИПричину() Экспорт

    // Arrange
    ПотокДанных = ПотокБезОбработчика(Перечисления.инт_НаправлениеПотокаДанных.Входящий);

    // Act
    ТекстОшибки = "";
    Попытка
        Справочники.инт_ПотокиДанных.ОбработатьВходящееСообщениеПоПотоку(
            Новый Соответствие, ПотокДанных, Ложь);
    Исключение
        ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    // Assert
    ЮТест.ОжидаетЧто(ТекстОшибки, "Ошибка обработки входящего сообщения без обработчика")
        .Содержит("Обработчик потока данных не заполнен")
        .Содержит(ПотокДанных.Наименование)
        .НеСодержит("Внешняя обработка не найдена");

КонецПроцедуры

// Поток нужного направления с очищенным текстом обработчика.
//
// Параметры:
//  НаправлениеПотока - ПеречислениеСсылка.инт_НаправлениеПотокаДанных - Направление.
//
// Возвращаемое значение:
//  СправочникСсылка.инт_ПотокиДанных - Записанный поток без обработчика.
//
Функция ПотокБезОбработчика(Знач НаправлениеПотока)

    Если НаправлениеПотока = Перечисления.инт_НаправлениеПотокаДанных.Исходящий Тогда
        ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("будет очищен");
    Иначе
        ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    КонецЕсли;

    ОбъектПотока = ПотокДанных.ПолучитьОбъект();
    ОбъектПотока.ТекстОбработчика = "";
    ОбъектПотока.Записать();

    Возврат ПотокДанных;

КонецФункции

#КонецОбласти

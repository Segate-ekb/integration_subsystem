// Тест: обращение к потокам в порядке «первый, второй» — каждый исполняет свой обработчик
Процедура ДваПотокаВПрямомПорядкеИсполняютСвойКод() Экспорт
    
    ПотокПервый = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первый");
    ПотокВторой = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("второй");
    ИсходныеДанные = ГенераторТестовыхДанных.демо_Документ();
    
    СообщениеПервого = Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокПервый);
    СообщениеВторого = Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокВторой);
    
    ЮТест.ОжидаетЧто(СообщениеПервого, "Сообщение первого потока").Свойство("метка").Равно("первый");
    ЮТест.ОжидаетЧто(СообщениеВторого, "Сообщение второго потока").Свойство("метка").Равно("второй");
    
КонецПроцедуры

// Тест: обращение к тем же потокам в обратном порядке — результат не зависит от порядка
Процедура ДваПотокаВОбратномПорядкеИсполняютСвойКод() Экспорт
    
    ПотокПервый = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первый");
    ПотокВторой = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("второй");
    ИсходныеДанные = ГенераторТестовыхДанных.демо_Документ();
    
    СообщениеВторого = Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокВторой);
    СообщениеПервого = Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокПервый);
    
    ЮТест.ОжидаетЧто(СообщениеВторого, "Сообщение второго потока").Свойство("метка").Равно("второй");
    ЮТест.ОжидаетЧто(СообщениеПервого, "Сообщение первого потока").Свойство("метка").Равно("первый");
    
КонецПроцедуры

// Тест воспроизводит наблюдавшийся у заказчика дефект: после обращения к другому потоку
// повторное обращение к первому потоку исполняло код второго и держалось до конца сеанса.
Процедура ПовторноеОбращениеКПотокуПослеДругогоПотокаИсполняетЕгоСобственныйКод() Экспорт
    
    ПотокПервый = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первый");
    ПотокВторой = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("второй");
    ИсходныеДанные = ГенераторТестовыхДанных.демо_Документ();
    
    Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокПервый);
    Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокВторой);
    ПовторноеСообщение = Справочники.инт_ПотокиДанных.СформироватьСообщениеПоПотоку(ИсходныеДанные, ПотокПервый);
    
    ЮТест.ОжидаетЧто(ПовторноеСообщение, "Повторное сообщение первого потока")
        .Свойство("метка").Равно("первый");
    
КонецПроцедуры


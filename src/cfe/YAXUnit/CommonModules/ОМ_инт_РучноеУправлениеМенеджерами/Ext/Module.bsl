////////////////////////////////////////////////////////////////////////////////
// ОМ_инт_РучноеУправлениеМенеджерами
// Юнит-тесты общего модуля инт_РучноеУправлениеМенеджерами: ожидание между итерациями
// управляющих фоновых заданий выдерживается средствами платформы (ТР-НФ-002).
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("ОжиданиеБезЗапускаВнешнихПриложений")
		.ДобавитьТест("ТестДлительностьПаузыСоответствуетЗапрошенной");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестДлительностьПаузыСоответствуетЗапрошенной() Экспорт

	ДлительностьСекунд = 2;
	ДопустимоеОтклонение = 0.1;

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	инт_РучноеУправлениеМенеджерами.Пауза(ДлительностьСекунд);
	Затрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;

	Запрошено = ДлительностьСекунд * 1000;

	ЮТест.ОжидаетЧто(Затрачено,
		"Фактическая длительность ожидания не короче запрошенной более чем на 10 процентов")
		.БольшеИлиРавно(Запрошено * (1 - ДопустимоеОтклонение));
	ЮТест.ОжидаетЧто(Затрачено,
		"Фактическая длительность ожидания не длиннее запрошенной более чем на 10 процентов")
		.МеньшеИлиРавно(Запрошено * (1 + ДопустимоеОтклонение));

КонецПроцедуры

#КонецОбласти

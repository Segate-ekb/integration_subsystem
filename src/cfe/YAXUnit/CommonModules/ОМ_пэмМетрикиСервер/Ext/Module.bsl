	СоздатьТестовуюМетрику(ПерваяМетрика, АлгоритмСЗадержкой(1500));
	СоздатьТестовуюМетрику(ВтораяМетрика, АлгоритмСЗадержкой(1500));

	Ответ = РассчитатьТестовыеМетрики();

	ЕстьПервая = СтрНайти(Ответ, ПерваяМетрика) > 0;
	ЕстьВторая = СтрНайти(Ответ, ВтораяМетрика) > 0;
	ЕстьПредупреждение = ЕстьЗаписьЖурнала(МоментНачала, УровеньЖурналаРегистрации.Предупреждение,
		?(ЕстьПервая, ВтораяМетрика, ПерваяМетрика));

	ЮТест.ОжидаетЧто(ЕстьПервая <> ЕстьВторая,
		"Ответ содержит успевшую рассчитаться метрику и не содержит следующую за ней").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЕстьПредупреждение,
		"Не включённая в ответ метрика записана в журнал регистрации с уровнем Предупреждение").ЭтоИстина();


#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьУспешно(ИмяМетрики, ТипМетрики, Таблица)

	Результат = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики, Таблица);
	ЮТест.ОжидаетЧто(Результат.Ошибка,
		"Преобразование завершилось ошибкой: " + Результат.ОписаниеОшибки).ЭтоЛожь();
	Возврат Результат.МетрикаСтрокой;

КонецФункции

Функция ПреобразоватьСОшибкой(ИмяМетрики, ТипМетрики, Таблица)

	МоментНачала = ТекущаяДатаСеанса();

	Результат = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики, Таблица);
	ЮТест.ОжидаетЧто(Результат.Ошибка, "Ожидалось нарушение контракта таблицы значений").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.МетрикаСтрокой, "Метрика с нарушением контракта в ответ не выводится").Равно("");
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОбОшибке(МоментНачала, Результат.ОписаниеОшибки),
		"Нарушение контракта записано в журнал регистрации").ЭтоИстина();

	Возврат Результат.ОписаниеОшибки;

КонецФункции

Функция ПерваяСтрока(Текст)

	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Возврат ?(Строки.Количество() = 0, "", Строки[0]);

КонецФункции

// Разбирает текст метрики на ряды: идентификатор ряда с метками и числовое значение.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Идентификатор - Строка - имя ряда вместе с метками
//     * Значение - Число - значение ряда
//
Функция РазобратьРяды(Текст)

	Ряды = Новый Массив;

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл

		Если Лев(Строка, 1) = "#" Тогда
			Продолжить;
		КонецЕсли;

		КонецМеток = СтрНайти(Строка, "} ");
		Ряды.Добавить(Новый Структура("Идентификатор, Значение",
			Лев(Строка, КонецМеток),
			ЧислоИзПредставления(Сред(Строка, КонецМеток + 2))));

	КонецЦикла;

	Возврат Ряды;

КонецФункции

Функция ИдентификаторыРядов(Ряды)

	Идентификаторы = Новый Массив;
	Для Каждого Ряд Из Ряды Цикл
		Идентификаторы.Добавить(Ряд.Идентификатор);
	КонецЦикла;
	Возврат СтрСоединить(Идентификаторы, Символы.ПС);

КонецФункции

Функция ЗначениеРяда(Ряды, Идентификатор)

	Для Каждого Ряд Из Ряды Цикл
		Если Ряд.Идентификатор = Идентификатор Тогда
			Возврат Ряд.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Разбирает представление числа с точкой в качестве разделителя дробной части.
// Пустое представление означает ноль: действующий формат вывода значения показывает
// ноль пустой строкой, исправление этого отнесено к требованию ТР-Ф-012.
Функция ЧислоИзПредставления(Представление)

	Значение = СокрЛП(Представление);
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Части = СтрРазделить(Значение, ".");
	Результат = Число(Части[0]);
	Если Части.Количество() > 1 И НЕ ПустаяСтрока(Части[1]) Тогда
		Результат = Результат + Число(Части[1]) / Pow(10, СтрДлина(Части[1]));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ТаблицаГистограммы(СМеткой)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("__series", Новый ОписаниеТипов("Строка"));
	Если СМеткой Тогда
		Таблица.Колонки.Добавить("flow", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Таблица.Колонки.Добавить("le");
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

Функция ТаблицаСводки(СМеткой)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("__series", Новый ОписаниеТипов("Строка"));
	Если СМеткой Тогда
		Таблица.Колонки.Добавить("flow", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Таблица.Колонки.Добавить("quantile");
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

Процедура ДобавитьКорзину(Таблица, Граница, Количество, ЗначениеМетки = Неопределено)

	НоваяСтрока = ДобавитьСтроку(Таблица, "bucket", Количество, ЗначениеМетки);
	НоваяСтрока["le"] = Граница;

КонецПроцедуры

Процедура ДобавитьКвантиль(Таблица, Уровень, Значение, ЗначениеМетки = Неопределено)

	НоваяСтрока = ДобавитьСтроку(Таблица, "quantile", Значение, ЗначениеМетки);
	НоваяСтрока["quantile"] = Уровень;

КонецПроцедуры

Процедура ДобавитьСтрокуРяда(Таблица, Ряд, Значение, ЗначениеМетки = Неопределено)

	ДобавитьСтроку(Таблица, Ряд, Значение, ЗначениеМетки);

КонецПроцедуры

Функция ДобавитьСтроку(Таблица, Ряд, Значение, ЗначениеМетки)

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока["__series"] = Ряд;
	НоваяСтрока["value"] = Значение;
	Если ЗначениеМетки <> Неопределено Тогда
		НоваяСтрока["flow"] = ЗначениеМетки;
	КонецЕсли;

	Возврат НоваяСтрока;

КонецФункции

Функция ГистограммаБезМеток()

	Таблица = ТаблицаГистограммы(Ложь);
	ДобавитьКорзину(Таблица, 5, 3);
	ДобавитьКорзину(Таблица, 1, 2);
	ДобавитьКорзину(Таблица, "+Inf", 1);
	ДобавитьСтрокуРяда(Таблица, "sum", 12);

	Возврат Таблица;

КонецФункции

Функция СводкаБезМеток()

	Таблица = ТаблицаСводки(Ложь);
	ДобавитьКвантиль(Таблица, 0.9, 8);
	ДобавитьКвантиль(Таблица, 0.5, 3);
	ДобавитьСтрокуРяда(Таблица, "sum", 20);
	ДобавитьСтрокуРяда(Таблица, "count", 4);

	Возврат Таблица;

КонецФункции

Функция ПростаяТаблица()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("label", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.label = "Показатель_1";
	НоваяСтрока.value = 5;

	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.label = "Показатель_2";
	НоваяСтрока.value = 7;

	Возврат Таблица;

КонецФункции

Функция ЗаписьИндекса(КодМетрики, ИмяТипаМетрики, ИмяМетодаПолучения)

	Запись = Новый Структура;
	Запись.Вставить("код", КодМетрики);
	Запись.Вставить("наименование", "Тестовая метрика");
	Запись.Вставить("типМетрики", ИмяТипаМетрики);
	Запись.Вставить("методПолучения", ИмяМетодаПолучения);
	Запись.Вставить("активность", Истина);
	Запись.Вставить("версия", 9999);
	Запись.Вставить("макет", "пэмМетрика_pde_queue_length");

	Возврат Запись;

КонецФункции

Функция КодыМетрик(Метрики)

	Коды = Новый Массив;
	Для Каждого Метрика Из Метрики Цикл
		Коды.Добавить(Метрика.Код);
	КонецЦикла;

	Возврат СтрСоединить(Коды, ",");

КонецФункции

Функция ЕстьЗаписьЖурналаОбОшибке(МоментНачала, Фрагмент)

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", МоментНачала);
	Отбор.Вставить("Событие", "Prometheus data exporter");
	Отбор.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Отбор);

	Для Каждого Запись Из Записи Цикл
		Если СтрНайти(Запись.Комментарий, Фрагмент) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


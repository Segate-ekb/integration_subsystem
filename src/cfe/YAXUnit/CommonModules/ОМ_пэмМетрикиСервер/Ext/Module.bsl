// Задаёт режим и ограничения расчёта метрик на время теста и подготавливает контекст,
// по которому обработчик ПослеКаждогоТеста возвращает базу в исходное состояние.
//
// Параметры:
//   Многопоточный - Булево - расчёт метрик фоновыми заданиями
//   ОтведенноеВремя - Число - отведённое время формирования ответа, секунд
//   ЧислоЗаданий - Число - число одновременно выполняемых заданий расчёта
//
Процедура ПодготовитьРасчетМетрик(Многопоточный, ОтведенноеВремя, ЧислоЗаданий = 4)

	ИсходныеНастройки = Новый Структура(
		"Многопоточный, ОтведенноеВремя, ЧислоЗаданий",
		Константы.пэмМногопоточныйРасчетМетрик.Получить(),
		Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Получить(),
		Константы.пэмЧислоОдновременныхЗаданийРасчетаМетрик.Получить());

	Контекст = ЮТест.КонтекстТеста();
	Контекст.Вставить("ТестовыеМетрики", Новый Массив);
	Контекст.Вставить("ИсходныеНастройки", ИсходныеНастройки);
	Контекст.Вставить("МоментНачалаТеста", ТекущаяДатаСеанса());

	Константы.пэмМногопоточныйРасчетМетрик.Установить(Многопоточный);
	Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Установить(ОтведенноеВремя);
	Константы.пэмЧислоОдновременныхЗаданийРасчетаМетрик.Установить(ЧислоЗаданий);

КонецПроцедуры

Процедура ВосстановитьНастройкиРасчетаМетрик(ИсходныеНастройки)

	Константы.пэмМногопоточныйРасчетМетрик.Установить(ИсходныеНастройки.Многопоточный);
	Константы.пэмОтведенноеВремяФормированияОтветаМетрик.Установить(ИсходныеНастройки.ОтведенноеВремя);
	Константы.пэмЧислоОдновременныхЗаданийРасчетаМетрик.Установить(ИсходныеНастройки.ЧислоЗаданий);

КонецПроцедуры

// Создаёт метрику с методом получения Push: все встроенные метрики используют метод Pull,
// поэтому выборка расчёта содержит только метрики теста.
//
// Параметры:
//   КодМетрики - Строка - код метрики
//   Алгоритм - Строка - текст алгоритма расчёта
//   Активность - Булево - признак активности метрики
//
// Возвращаемое значение:
//   СправочникСсылка.пэмМетрики - созданная метрика
//
Функция СоздатьТестовуюМетрику(КодМетрики, Алгоритм, Активность = Истина)

	Метрика = Справочники.пэмМетрики.СоздатьЭлемент();
	Метрика.Код = КодМетрики;
	Метрика.Наименование = "Тестовая метрика";
	Метрика.ТипМетрики = Перечисления.пэмТипыМетрик.Gauge;
	Метрика.МетодПолученияМетрики = Перечисления.пэмМетодыПолученияМетрик.Push;
	Метрика.Активность = Активность;
	Метрика.ИдентификаторРегламента = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Метрика.Алгоритм = Алгоритм;
	Метрика.Записать();

	ЮТест.КонтекстТеста().ТестовыеМетрики.Добавить(Метрика.Ссылка);

	Возврат Метрика.Ссылка;

КонецФункции

Функция РассчитатьТестовыеМетрики()

	Возврат пэмМетрикиСервер.ПолучитьМетрики(Перечисления.пэмМетодыПолученияМетрик.Push, Неопределено);

КонецФункции

Функция ПростойАлгоритмМетрики()

	Возврат
	"ТаблицаЗначений = Новый ТаблицаЗначений;
	|ТаблицаЗначений.Колонки.Добавить(""value"", Новый ОписаниеТипов(""Число""));
	|НоваяСтрока = ТаблицаЗначений.Добавить();
	|НоваяСтрока.value = 1;";

КонецФункции

// Возвращает алгоритм метрики, расчёт которой занимает заданное время.
// Пауза выдержана циклом по универсальному времени: алгоритм исполняется на сервере
// в фоновом задании, где средства ожидания тестового расширения недоступны.
//
// Параметры:
//   ДлительностьРасчета - Число - длительность расчёта, миллисекунд
//
// Возвращаемое значение:
//   Строка - текст алгоритма расчёта
//
Функция АлгоритмСЗадержкой(ДлительностьРасчета)

	Задержка = Формат(ДлительностьРасчета, "ЧГ=0");
	РасчетЗначения = ПростойАлгоритмМетрики();

	Возврат СтрШаблон(
	"МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + %1;
	|Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
	|КонецЦикла;
	|%2", Задержка, РасчетЗначения);

КонецФункции

// Возвращает алгоритм метрики, значением которой служит число заданий расчёта метрик,
// выполняемых одновременно с ним.
//
// Возвращаемое значение:
//   Строка - текст алгоритма расчёта
//
Функция АлгоритмЧислаОдновременныхЗаданий()

	Возврат
	"МоментОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах() + 700;
	|Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментОкончания Цикл
	|КонецЦикла;
	|Отбор = Новый Структура(""ИмяМетода, Состояние"",
	|	""пэмМетрикиСервер.СформироватьМетрикуФоновымЗаданием"", СостояниеФоновогоЗадания.Активно);
	|ТаблицаЗначений = Новый ТаблицаЗначений;
	|ТаблицаЗначений.Колонки.Добавить(""value"", Новый ОписаниеТипов(""Число""));
	|НоваяСтрока = ТаблицаЗначений.Добавить();
	|НоваяСтрока.value = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество();";

КонецФункции

// Возвращает значения рядов метрик, выведенных без меток.
//
// Параметры:
//   Текст - Строка - текст метрик в формате экспозиции
//
// Возвращаемое значение:
//   Массив из Число - значения рядов
//
Функция ЗначенияМетрикБезМеток(Текст)

	Значения = Новый Массив;

	Для Каждого Строка Из СтрокиЗначений(Текст) Цикл
		Представление = Сред(Строка, СтрНайти(Строка, " ", НаправлениеПоиска.СКонца) + 1);
		Значения.Добавить(ЧислоИзПредставления(Представление));
	КонецЦикла;

	Возврат Значения;

КонецФункции

Функция СостоянияМетрики(Метрика)

	НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Метрика.Установить(Метрика);
	НаборЗаписей.Прочитать();

	Возврат НаборЗаписей.Выгрузить();

КонецФункции

Процедура УдалитьСостояниеМетрики(Метрика)

	НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Метрика.Установить(Метрика);
	НаборЗаписей.Записать();

КонецПроцедуры

// Дожидается завершения заданий расчёта тестовых метрик, чтобы отменённое задание не записало
// состояние расчёта после удаления метрики.
//
// Параметры:
//   ТестовыеМетрики - Массив из СправочникСсылка.пэмМетрики - метрики, созданные тестом
//
Процедура ДождатьсяЗавершенияЗаданийРасчета(ТестовыеМетрики)

	ЗаданияРасчета = Новый Массив;

	Для Каждого Метрика Из ТестовыеМетрики Цикл
		Для Каждого Задание Из ЗаданияРасчетаМетрик(Метрика.Код) Цикл
			Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				ЗаданияРасчета.Добавить(Задание);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ЗаданияРасчета.Количество() Тогда
		ФоновыеЗадания.ОжидатьЗавершенияВыполнения(ЗаданияРасчета, 10);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьСостояниеМетрики(Метрика)

	НаборЗаписей = РегистрыСведений.пэмСостояниеМетрик.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Метрика.Установить(Метрика);

	Состояние = НаборЗаписей.Добавить();
	Состояние.Метрика = Метрика;
	Состояние.ДатаРасчета = ТекущаяУниверсальнаяДата();
	Состояние.Длительность = 1;

	НаборЗаписей.Записать();

КонецПроцедуры

// Компонует отчёт о состоянии метрик штатным способом: через объект отчёта, чтобы
// отработал обработчик ПриКомпоновкеРезультата, заполняющий смещение часового пояса.
//
// Возвращаемое значение:
//   Строка - тексты ячеек результата компоновки
//
Функция ТекстОтчетаСостоянияМетрик()

	ДокументРезультат = Новый ТабличныйДокумент;

	Отчет = Отчеты.пэмСостояниеМетрик.Создать();
	Отчет.СкомпоноватьРезультат(ДокументРезультат);

	Возврат ТекстТабличногоДокумента(ДокументРезультат);

КонецФункции

// Возвращает тексты всех заполненных ячеек табличного документа.
//
// Параметры:
//   ДокументРезультат - ТабличныйДокумент - результат компоновки отчёта
//
// Возвращаемое значение:
//   Строка - тексты ячеек, разделённые переводом строки
//
Функция ТекстТабличногоДокумента(ДокументРезультат)

	ТекстыЯчеек = Новый Массив;

	Для НомерСтроки = 1 По ДокументРезультат.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По ДокументРезультат.ШиринаТаблицы Цикл
			ТекстЯчейки = ДокументРезультат.Область(НомерСтроки, НомерКолонки).Текст;
			Если НЕ ПустаяСтрока(ТекстЯчейки) Тогда
				ТекстыЯчеек.Добавить(ТекстЯчейки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(ТекстыЯчеек, Символы.ПС);

КонецФункции

// Возвращает число фоновых заданий подсистемы метрик, запущенных начиная с указанного момента.
//
// Параметры:
//   МоментНачала - Дата - момент, начиная с которого учитываются задания
//
// Возвращаемое значение:
//   Число - количество найденных заданий
//
Функция ЧислоФоновыхЗаданийМетрик(МоментНачала)

	Количество = 0;

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания() Цикл
		Если Задание.Начало >= МоментНачала И СтрНачинаетсяС(Задание.ИмяМетода, "пэмМетрикиСервер.") Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Запускает задание расчёта метрики так же, как его запускает пэмМетрикиСервер, и возвращает
// описание расчёта для передачи в ЗавершитьПорциюРасчетов.
//
// Параметры:
//   КодМетрики - Строка - код создаваемой метрики
//   Алгоритм - Строка - текст алгоритма расчёта
//
// Возвращаемое значение:
//   Структура - описание запущенного расчёта
//
Функция ЗапуститьРасчетМетрики(КодМетрики, Алгоритм)

	Метрика = СоздатьТестовуюМетрику(КодМетрики, Алгоритм);
	АдресВХранилище = ПоместитьВоВременноеХранилище("", Новый УникальныйИдентификатор);

	ПараметрыРасчета = Новый Массив;
	ПараметрыРасчета.Добавить(КодМетрики);
	ПараметрыРасчета.Добавить(Перечисления.пэмТипыМетрик.Gauge);
	ПараметрыРасчета.Добавить(Алгоритм);
	ПараметрыРасчета.Добавить(АдресВХранилище);
	ПараметрыРасчета.Добавить(Метрика);
	ПараметрыРасчета.Добавить("");

	КлючЗадания = КодМетрики + " " + Строка(Новый УникальныйИдентификатор);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("пэмМетрикиСервер.СформироватьМетрикуФоновымЗаданием",
		ПараметрыРасчета, КлючЗадания);

	Возврат ОписаниеРасчета(КодМетрики, АдресВХранилище, ФоновоеЗадание);

КонецФункции

// Возвращает описание расчёта метрики в том виде, в каком его принимает ЗавершитьПорциюРасчетов.
//
// Параметры:
//   КодМетрики - Строка - код метрики
//   АдресВХранилище - Строка - адрес значения во временном хранилище
//   ФоновоеЗадание - ФоновоеЗадание, Структура - задание расчёта
//
// Возвращаемое значение:
//   Структура - описание расчёта метрики
//
Функция ОписаниеРасчета(КодМетрики, АдресВХранилище, ФоновоеЗадание)

	Возврат Новый Структура("ИмяМетрики, АдресВХранилище, ФоновоеЗадание",
		КодМетрики, АдресВХранилище, ФоновоеЗадание);

КонецФункции

Функция ПорцияИзОдногоРасчета(Расчет)

	Порция = Новый Массив;
	Порция.Добавить(Расчет);

	Возврат Порция;

КонецФункции

// Возвращает задание, вытесненное из списка заданий: цикл ожидания обращается к нему
// только за уникальным идентификатором, по которому задание уже не находится.
//
// Возвращаемое значение:
//   Структура - подставное задание расчёта
//
Функция ВытесненноеЗадание()

	Возврат Новый Структура("УникальныйИдентификатор", Новый УникальныйИдентификатор);

КонецФункции

// Помещает во временное хранилище результат расчёта метрики в том виде, в каком его
// оставляет задание расчёта.
//
// Параметры:
//   КодМетрики - Строка - код метрики
//
// Возвращаемое значение:
//   Строка - адрес значения во временном хранилище
//
Функция ПоместитьРезультатРасчетаВХранилище(КодМетрики)

	ТекстМетрики = "# TYPE " + КодМетрики + " gauge" + Символы.ПС + КодМетрики + " 1" + Символы.ПС;
	РезультатРасчета = Новый Структура("МетрикаСтрокой, Ошибка, ОписаниеОшибки", ТекстМетрики, Ложь, "");

	Возврат ПоместитьВоВременноеХранилище(РезультатРасчета, Новый УникальныйИдентификатор);

КонецФункции

// Возвращает ограничение времени формирования ответа, отведённое время которого не истечёт
// за время теста.
//
// Возвращаемое значение:
//   Структура - ограничение времени формирования ответа
//
Функция ОграничениеВремениСЗапасом()

	Возврат ОграничениеВремени(ТекущаяУниверсальнаяДатаВМиллисекундах(), 60000);

КонецФункции

// Возвращает ограничение времени формирования ответа, отведённое время которого истекло
// до вызова проверяемого метода.
//
// Возвращаемое значение:
//   Структура - ограничение времени формирования ответа
//
Функция ИстекшееОграничениеВремени()

	ОтведенноеВремя = 1000;
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах() - 2 * ОтведенноеВремя;

	Возврат ОграничениеВремени(МоментНачала, ОтведенноеВремя);

КонецФункции

// Собирает ограничение времени формирования ответа в том виде, в каком его строит
// пэмМетрикиСервер.
//
// Параметры:
//   МоментНачала - Число - момент начала формирования ответа, миллисекунды
//   ОтведенноеВремя - Число - отведённое время формирования ответа, миллисекунды
//
// Возвращаемое значение:
//   Структура - ограничение времени формирования ответа
//
Функция ОграничениеВремени(МоментНачала, ОтведенноеВремя)

	Возврат Новый Структура("МоментНачала, ОтведенноеВремя, МоментЗавершения",
		МоментНачала, ОтведенноеВремя, МоментНачала + ОтведенноеВремя);

КонецФункции

// Возвращает признак доступности значения по адресу временного хранилища.
//
// Параметры:
//   Адрес - Строка - адрес значения во временном хранилище
//
// Возвращаемое значение:
//   Булево - Истина, если значение по адресу доступно для чтения
//
Функция ЗначениеДоступноВоВременномХранилище(Адрес)

	Попытка
		ЗначениеХранилища = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат ЗначениеХранилища <> Неопределено;

КонецФункции

// Возвращает задания расчёта метрик, запущенные текущим тестом, ключи которых начинаются
// с указанного префикса. Ключ задания расчёта начинается с кода метрики; момент запуска
// отсекает задания предыдущих прогонов, если список заданий базы их сохранил.
//
// Параметры:
//   ПрефиксКодаМетрики - Строка - префикс кода метрики
//
// Возвращаемое значение:
//   Массив из ФоновоеЗадание - найденные задания расчёта
//
Функция ЗаданияРасчетаМетрик(ПрефиксКодаМетрики)

	МоментНачалаТеста = ЮТест.КонтекстТеста().МоментНачалаТеста;
	Отбор = Новый Структура("ИмяМетода", "пэмМетрикиСервер.СформироватьМетрикуФоновымЗаданием");
	НайденныеЗадания = Новый Массив;

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если СтрНачинаетсяС(Задание.Ключ, ПрефиксКодаМетрики) И Задание.Начало >= МоментНачалаТеста Тогда
			НайденныеЗадания.Добавить(Задание);
		КонецЕсли;
	КонецЦикла;

	Возврат НайденныеЗадания;

КонецФункции

#КонецОбласти

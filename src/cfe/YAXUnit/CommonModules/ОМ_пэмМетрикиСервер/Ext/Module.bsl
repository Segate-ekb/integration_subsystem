	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, Таблица));

	ЮТест.ОжидаетЧто(ИдентификаторыРядов(Ряды), "Метка le выводится только на строках корзин").Равно(
		"test_hist_bucket{flow=""flow_a"",le=""1""}

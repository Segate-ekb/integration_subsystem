// {{{ Набор: ОпределениеЗначенийПеречисленийПоИмени

Процедура ТестДопустимыеИменаТиповДаютЗначенияПеречисления() Экспорт

	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Gauge"))
		.Равно(Перечисления.пэмТипыМетрик.Gauge);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Counter"))
		.Равно(Перечисления.пэмТипыМетрик.Counter);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Histogram"))
		.Равно(Перечисления.пэмТипыМетрик.Histogram);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Summary"))
		.Равно(Перечисления.пэмТипыМетрик.Summary);

КонецПроцедуры

Процедура ТестНедопустимоеИмяТипаДаетНеопределено() Экспорт

	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Гистограмма"),
		"Недопустимое имя типа не подменяется значением по умолчанию").ЭтоНеопределено();

КонецПроцедуры

Процедура ТестДопустимыеИменаМетодовПолученияДаютЗначенияПеречисления() Экспорт


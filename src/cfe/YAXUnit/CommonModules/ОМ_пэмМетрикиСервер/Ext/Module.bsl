Функция ЕстьЗаписьЖурнала(МоментНачала, Уровень, Фрагмент)

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", МоментНачала);
	Отбор.Вставить("Событие", "Prometheus data exporter");
	Отбор.Вставить("Уровень", Уровень);

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Отбор);

	Для Каждого Запись Из Записи Цикл
		Если СтрНайти(Запись.Комментарий, Фрагмент) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;


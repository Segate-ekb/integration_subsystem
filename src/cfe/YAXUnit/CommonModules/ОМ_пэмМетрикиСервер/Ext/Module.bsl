// Возвращает базу в состояние, предшествовавшее тесту: снимает настройки расчёта метрик
// и удаляет созданные тестом метрики вместе с записями их состояния.
Процедура ПослеКаждогоТеста() Экспорт

	Контекст = ЮТест.КонтекстТеста();
	Если Контекст = Неопределено Или НЕ Контекст.Свойство("ТестовыеМетрики") Тогда
		Возврат;
	КонецЕсли;

	ВосстановитьНастройкиРасчетаМетрик(Контекст.ИсходныеНастройки);
	ДождатьсяЗавершенияЗаданийРасчета(Контекст.ТестовыеМетрики);

	Для Каждого Метрика Из Контекст.ТестовыеМетрики Цикл
		УдалитьСостояниеМетрики(Метрика);
		ОбъектМетрики = Метрика.ПолучитьОбъект();
		Если ОбъектМетрики <> Неопределено Тогда
			ОбъектМетрики.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


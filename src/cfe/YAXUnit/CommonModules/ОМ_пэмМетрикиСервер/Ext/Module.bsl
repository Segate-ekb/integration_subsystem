		.Равно(Перечисления.пэмТипыМетрик.Gauge);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Counter"))
		.Равно(Перечисления.пэмТипыМетрик.Counter);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Histogram"))
		.Равно(Перечисления.пэмТипыМетрик.Histogram);
	ЮТест.ОжидаетЧто(пэмМетрикиСервер.ПолучитьТипМетрикиПоИмени("Summary"))
		.Равно(Перечисления.пэмТипыМетрик.Summary);

КонецПроцедуры


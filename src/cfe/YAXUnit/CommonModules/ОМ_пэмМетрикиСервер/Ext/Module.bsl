	Расчет = ОписаниеРасчета(ИмяМетрики, АдресВХранилище, ВытесненноеЗадание());
	Порция = ПорцияИзОдногоРасчета(Расчет);

	// Ограничение с истекшим временем оставляет вытесненное задание единственным условием выхода:
	// платформенного ожидания оно не переживёт, у него есть только уникальный идентификатор.
	Ограничение = ИстекшееОграничениеВремени();

	Ответ = пэмМетрикиСервер.ЗавершитьПорциюРасчетов(Порция, Ограничение);
	ЗначениеДоступно = ЗначениеДоступноВоВременномХранилище(АдресВХранилище);
	ЕстьПредупреждение = ЕстьЗаписьЖурнала(МоментНачала, УровеньЖурналаРегистрации.Предупреждение,
		ИмяМетрики);

	ЮТест.ОжидаетЧто(Ответ, "Результат вытесненного из списка задания включён в ответ")
		.Содержит(ИмяМетрики);
	ЮТест.ОжидаетЧто(ЗначениеДоступно,
		"Значение временного хранилища освобождено и при отсутствии задания в списке").ЭтоЛожь();
	ЮТест.ОжидаетЧто(ЕстьПредупреждение,
		"Отсутствие задания в списке записано в журнал регистрации").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПреобразоватьУспешно(ИмяМетрики, ТипМетрики, Таблица, ПояснениеМетрики = "")

	Результат = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики,
		Таблица, ПояснениеМетрики);
	ЮТест.ОжидаетЧто(Результат.Ошибка,
		"Преобразование завершилось ошибкой: " + Результат.ОписаниеОшибки).ЭтоЛожь();
	Возврат Результат.МетрикаСтрокой;

КонецФункции

Функция ПреобразоватьСОшибкой(ИмяМетрики, ТипМетрики, Таблица)

	МоментНачала = ТекущаяДатаСеанса();

	Результат = пэмМетрикиСервер.ПривестиТаблицуРасчетаМетрикиКСтрокеPrometheus(ИмяМетрики, ТипМетрики, Таблица);
	ЮТест.ОжидаетЧто(Результат.Ошибка, "Ожидалось нарушение контракта таблицы значений").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.МетрикаСтрокой, "Метрика с нарушением контракта в ответ не выводится").Равно("");
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОбОшибке(МоментНачала, Результат.ОписаниеОшибки),
		"Нарушение контракта записано в журнал регистрации").ЭтоИстина();

	Возврат Результат.ОписаниеОшибки;

КонецФункции

Функция ПерваяСтрока(Текст)

	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Возврат ?(Строки.Количество() = 0, "", Строки[0]);

КонецФункции

// Разбирает текст метрики на ряды: идентификатор ряда с метками и числовое значение.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Идентификатор - Строка - имя ряда вместе с метками
//     * Значение - Число - значение ряда
//
Функция РазобратьРяды(Текст)

	Ряды = Новый Массив;

	Для Каждого Строка Из СтрокиЗначений(Текст) Цикл
		КонецМеток = СтрНайти(Строка, "} ");
		Ряды.Добавить(Новый Структура("Идентификатор, Значение",
			Лев(Строка, КонецМеток),
			ЧислоИзПредставления(Сред(Строка, КонецМеток + 2))));
	КонецЦикла;

	Возврат Ряды;

КонецФункции

// Возвращает строки ответа со значениями метрики, без строк пояснения и объявления типа.
//
// Параметры:
//   Текст - Строка - текст метрики в формате экспозиции
//
// Возвращаемое значение:
//   Массив из Строка - строки значений
//
Функция СтрокиЗначений(Текст)

	Строки = Новый Массив;

	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если Лев(Строка, 1) <> "#" Тогда
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Возвращает представление значения единственного ряда метрики так, как оно выведено в ответ.
//
// Параметры:
//   Значение - Произвольный - содержимое колонки value
//
// Возвращаемое значение:
//   Строка - представление значения
//
Функция ПредставлениеЗначенияПростойМетрики(Значение)

	Строки = СтрокиЗначений(ПреобразоватьУспешно("test_gauge", Перечисления.пэмТипыМетрик.Gauge,
		ПростаяТаблицаСоЗначением(Значение)));
	ЮТест.ОжидаетЧто(Строки.Количество(), "Ожидалась одна строка значения").Равно(1);

	Возврат Сред(Строки[0], СтрНайти(Строки[0], "} ") + 2);

КонецФункции

Функция ИдентификаторыРядов(Ряды)

	Идентификаторы = Новый Массив;
	Для Каждого Ряд Из Ряды Цикл
		Идентификаторы.Добавить(Ряд.Идентификатор);
	КонецЦикла;
	Возврат СтрСоединить(Идентификаторы, Символы.ПС);

КонецФункции

Функция ЗначениеРяда(Ряды, Идентификатор)

	Для Каждого Ряд Из Ряды Цикл
		Если Ряд.Идентификатор = Идентификатор Тогда
			Возврат Ряд.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Разбирает представление числа с точкой в качестве разделителя дробной части.
// Пустое представление недопустимо: значение метрики всегда выводится числом (ТР-Ф-012).
Функция ЧислоИзПредставления(Представление)

	Значение = СокрЛП(Представление);
	ЮТест.ОжидаетЧто(ПустаяСтрока(Значение), "Строка ряда выведена без значения").ЭтоЛожь();

	Части = СтрРазделить(Значение, ".");
	Результат = Число(Части[0]);
	Если Части.Количество() > 1 И НЕ ПустаяСтрока(Части[1]) Тогда
		ДробнаяЧасть = Число(Части[1]) / Pow(10, СтрДлина(Части[1]));
		Результат = Результат + ?(Лев(Значение, 1) = "-", -ДробнаяЧасть, ДробнаяЧасть);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ТаблицаГистограммы(СМеткой)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("__series", Новый ОписаниеТипов("Строка"));
	Если СМеткой Тогда
		Таблица.Колонки.Добавить("flow", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Таблица.Колонки.Добавить("le");
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));

	Возврат Таблица;

КонецФункции

Функция ТаблицаСводки(СМеткой)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("__series", Новый ОписаниеТипов("Строка"));
	Если СМеткой Тогда
		Таблица.Колонки.Добавить("flow", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Таблица.Колонки.Добавить("quantile");
	Таблица.Колонки.Добавить("value", Новый ОписаниеТипов("Число"));

	Возврат Таблица;


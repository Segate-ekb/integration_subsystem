	МоментНачалаФормирования = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = РассчитатьТестовыеМетрики();
	ДлительностьФормирования = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаФормирования;

	ПозицияМетрики = СтрНайти(Ответ, ИмяМетрики);
	ЕстьПредупреждение = ЕстьЗаписьЖурнала(МоментНачала, УровеньЖурналаРегистрации.Предупреждение,
		ИмяМетрики);

	ЮТест.ОжидаетЧто(ДлительностьФормирования,
		"Формирование ответа не удерживает поток дольше алгоритма метрики").Меньше(ДлительностьРасчета);
	ЮТест.ОжидаетЧто(ПозицияМетрики,
		"Метрика, не успевшая рассчитаться, в ответ не включается").Равно(0);

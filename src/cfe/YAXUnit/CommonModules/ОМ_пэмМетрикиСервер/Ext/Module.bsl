// {{{ Набор: ПервоначальноеЗаполнениеПоИндексу

Процедура ТестЗаписьИндексаСТипомHistogramОбрабатываетсяБезИсключения() Экспорт

	Индекс = Новый Массив;
	Индекс.Добавить(ЗаписьИндекса("pde_queue_length", "Histogram", "Pull"));

	ЕстьОшибки = Истина;
	Метрики = пэмМетрикиСервер.ПодготовитьМетрикиПоИндексу(Индекс, ЕстьОшибки);

	ЮТест.ОжидаетЧто(ЕстьОшибки, "Тип Histogram обрабатывается без ошибок").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Метрики.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Метрики[0].ТипМетрики).Равно(Перечисления.пэмТипыМетрик.Histogram);

КонецПроцедуры

Процедура ТестЗаписьИндексаСНедопустимымТипомПропускается() Экспорт

	МоментНачала = ТекущаяДатаСеанса();

	Индекс = Новый Массив;
	Индекс.Добавить(ЗаписьИндекса("pde_queue_length", "Histogram", "Pull"));
	Индекс.Добавить(ЗаписьИндекса("pde_error_count", "Гистограмма", "Pull"));
	Индекс.Добавить(ЗаписьИндекса("pde_retry_count", "Gauge", "Pull"));

	ЕстьОшибки = Ложь;
	Метрики = пэмМетрикиСервер.ПодготовитьМетрикиПоИндексу(Индекс, ЕстьОшибки);

	ЮТест.ОжидаетЧто(ЕстьОшибки, "Недопустимый тип метрики фиксируется как ошибка").ЭтоИстина();
	ЮТест.ОжидаетЧто(КодыМетрик(Метрики), "Остальные записи индекса обработаны")
		.Равно("pde_queue_length,pde_retry_count");
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОбОшибке(МоментНачала, "pde_error_count"),
		"В журнале регистрации есть запись уровня Ошибка с кодом метрики").ЭтоИстина();

КонецПроцедуры

Процедура ТестЗаписьИндексаСНедопустимымМетодомПолученияПропускается() Экспорт

	МоментНачала = ТекущаяДатаСеанса();

	Индекс = Новый Массив;
	Индекс.Добавить(ЗаписьИндекса("pde_queue_length", "Gauge", "Опрос"));
	Индекс.Добавить(ЗаписьИндекса("pde_retry_count", "Gauge", "Pull"));

	ЕстьОшибки = Ложь;
	Метрики = пэмМетрикиСервер.ПодготовитьМетрикиПоИндексу(Индекс, ЕстьОшибки);

	ЮТест.ОжидаетЧто(ЕстьОшибки, "Недопустимый метод получения фиксируется как ошибка").ЭтоИстина();
	ЮТест.ОжидаетЧто(КодыМетрик(Метрики), "Остальные записи индекса обработаны")
		.Равно("pde_retry_count");
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОбОшибке(МоментНачала, "pde_queue_length"),
		"В журнале регистрации есть запись уровня Ошибка с кодом метрики").ЭтоИстина();

КонецПроцедуры

// {{{ Набор: ВыводМетрикиТипаHistogram

Процедура ТестГистограммаВыводитКорзиныСуммуИКоличество() Экспорт

	Текст = ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, ГистограммаБезМеток());

	ЮТест.ОжидаетЧто(ИдентификаторыРядов(РазобратьРяды(Текст))).Равно(
		"test_hist_bucket{le=""1""}
		|test_hist_bucket{le=""5""}
		|test_hist_bucket{le=""+Inf""}
		|test_hist_sum{}
		|test_hist_count{}");

КонецПроцедуры

Процедура ТестКорзиныГистограммыНакапливаютсяМеханизмом() Экспорт

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist",
		Перечисления.пэмТипыМетрик.Histogram, ГистограммаБезМеток()));

	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_bucket{le=""1""}"), "Корзина 1").Равно(2);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_bucket{le=""5""}"), "Корзина 5 накоплена").Равно(5);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_bucket{le=""+Inf""}"), "Корзина +Inf накоплена").Равно(6);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_sum{}"), "Сумма наблюдений").Равно(12);

КонецПроцедуры

Процедура ТестКоличествоНаблюденийРавноНакопленнойКорзинеБесконечности() Экспорт

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist",
		Перечисления.пэмТипыМетрик.Histogram, ГистограммаБезМеток()));

	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_count{}"),
		"Количество наблюдений равно накопленному значению корзины +Inf")
		.Равно(ЗначениеРяда(Ряды, "test_hist_bucket{le=""+Inf""}"));

КонецПроцедуры

Процедура ТестНаблюдениеСверхПоследнейГраницыПопадаетВКорзинуБесконечности() Экспорт

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist",
		Перечисления.пэмТипыМетрик.Histogram, ГистограммаБезМеток()));

	НаблюденийДоПоследнейГраницы = ЗначениеРяда(Ряды, "test_hist_bucket{le=""5""}");
	ВсегоНаблюдений = ЗначениеРяда(Ряды, "test_hist_count{}");

	ЮТест.ОжидаетЧто(ВсегоНаблюдений - НаблюденийДоПоследнейГраницы,
		"Наблюдение сверх наибольшей конечной границы учтено в корзине +Inf и в количестве").Равно(1);

КонецПроцедуры

Процедура ТестМеткаLeНеВыводитсяНаСтрокахСуммыИКоличества() Экспорт

	Таблица = ТаблицаГистограммы(Истина);
	ДобавитьКорзину(Таблица, 1, 2, "flow_a");
	ДобавитьКорзину(Таблица, "+Inf", 1, "flow_a");
	ДобавитьСтрокуРяда(Таблица, "sum", 12, "flow_a");

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, Таблица));

	ЮТест.ОжидаетЧто(ИдентификаторыРядов(Ряды), "Метка le выводится только на строках корзин").Равно(
		"test_hist_bucket{flow=""flow_a"",le=""1""}
		|test_hist_bucket{flow=""flow_a"",le=""+Inf""}
		|test_hist_sum{flow=""flow_a""}
		|test_hist_count{flow=""flow_a""}");

КонецПроцедуры

Процедура ТестОбъявлениеТипаВыводитсяОдинРазНаБазовоеИмя() Экспорт

	Текст = ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, ГистограммаБезМеток());

	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Текст, "# TYPE"),
		"Объявление типа выводится один раз на базовое имя метрики").Равно(1);
	ЮТест.ОжидаетЧто(ПерваяСтрока(Текст), "Объявление типа выводится до строк значений")
		.Равно("# TYPE test_hist histogram");

КонецПроцедуры

Процедура ТестСочетанияМетокГистограммыВыводятсяОтдельнымиРядами() Экспорт

	Таблица = ТаблицаГистограммы(Истина);
	ДобавитьКорзину(Таблица, 1, 2, "flow_a");
	ДобавитьКорзину(Таблица, "+Inf", 1, "flow_a");
	ДобавитьСтрокуРяда(Таблица, "sum", 12, "flow_a");
	ДобавитьКорзину(Таблица, 1, 4, "flow_b");
	ДобавитьКорзину(Таблица, "+Inf", 3, "flow_b");
	ДобавитьСтрокуРяда(Таблица, "sum", 7, "flow_b");

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, Таблица));

	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_count{flow=""flow_a""}"), "Количество ряда flow_a").Равно(3);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_count{flow=""flow_b""}"), "Количество ряда flow_b").Равно(7);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_bucket{flow=""flow_b"",le=""1""}"),
		"Корзина 1 ряда flow_b").Равно(4);

КонецПроцедуры

Процедура ТестДробныеГраницыКорзинУпорядочиваютсяИВыводятсяВМеткеLe() Экспорт

	Таблица = ТаблицаГистограммы(Ложь);
	ДобавитьКорзину(Таблица, 0.025, 1);
	ДобавитьКорзину(Таблица, 0.005, 3);
	ДобавитьКорзину(Таблица, 0.01, 2);
	ДобавитьКорзину(Таблица, "+Inf", 4);
	ДобавитьСтрокуРяда(Таблица, "sum", 42);

	Ряды = РазобратьРяды(ПреобразоватьУспешно("test_hist", Перечисления.пэмТипыМетрик.Histogram, Таблица));

	ЮТест.ОжидаетЧто(ИдентификаторыРядов(Ряды), "Дробные границы упорядочены по возрастанию").Равно(
		"test_hist_bucket{le=""0.005""}
		|test_hist_bucket{le=""0.01""}
		|test_hist_bucket{le=""0.025""}
		|test_hist_bucket{le=""+Inf""}
		|test_hist_sum{}
		|test_hist_count{}");
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_bucket{le=""0.01""}"), "Корзина 0.01 накоплена").Равно(5);
	ЮТест.ОжидаетЧто(ЗначениеРяда(Ряды, "test_hist_count{}"), "Количество наблюдений").Равно(10);


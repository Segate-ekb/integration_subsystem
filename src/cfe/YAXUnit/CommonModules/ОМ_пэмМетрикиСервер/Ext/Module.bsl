	Индекс = Новый Массив;
	Индекс.Добавить(ЗаписьИндекса("pde_queue_length", "Histogram", "Pull"));
	Индекс.Добавить(ЗаписьИндекса("pde_error_count", "Гистограмма", "Pull"));
	Индекс.Добавить(ЗаписьИндекса("pde_retry_count", "Gauge", "Pull"));

	ЕстьОшибки = Ложь;
	Метрики = пэмМетрикиСервер.ПодготовитьМетрикиПоИндексу(Индекс, ЕстьОшибки);

	ЮТест.ОжидаетЧто(ЕстьОшибки, "Недопустимый тип метрики фиксируется как ошибка").ЭтоИстина();
	ЮТест.ОжидаетЧто(КодыМетрик(Метрики), "Остальные записи индекса обработаны")
		.Равно("pde_queue_length,pde_retry_count");
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОбОшибке(МоментНачала, "pde_error_count"),

// Имя, полученное для потока данных дважды без правки обработчика, совпадает,
// и повторное подключение не выполняется: второе обращение обслуживает кеш сеанса.
//
// Отсутствие повторного подключения наблюдается напрямую: между обращениями тест сам
// подключает под тем же именем другую обработку. Если бы второе обращение подключало
// обработчик потока заново, подмена была бы вытеснена. Подсистема так не делает,
// подмена выполнена самим тестом.
Процедура ИмяОбработкиПотока_ПовторныйВызовНеПодключаетЗаново() Экспорт
	
	// Arrange
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("обработчик потока");
	ПервоеИмя = инт_ГенераторОбработок.ИмяОбработкиПотока(ПотокДанных);
	
	ТекстПодмены = "Результат.Вставить(""метка"", ""подмена теста"");";
	инт_ГенераторОбработок.ПодключитьОбработку(
		инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстПодмены), ПервоеИмя);
	
	// Act
	ВтороеИмя = инт_ГенераторОбработок.ИмяОбработкиПотока(ПотокДанных);
	
	// Assert
	ЮТест.ОжидаетЧто(ВтороеИмя, "Имя при повторном обращении к потоку").Равно(ПервоеИмя);
	
	Экземпляр = ВнешниеОбработки.Создать(ВтороеИмя, Ложь);
	ЮТест.ОжидаетЧто(Экземпляр.Обработать(Неопределено),
			"Повторное обращение к потоку не подключало обработку заново")
		.Свойство("метка").Равно("подмена теста");
	
КонецПроцедуры


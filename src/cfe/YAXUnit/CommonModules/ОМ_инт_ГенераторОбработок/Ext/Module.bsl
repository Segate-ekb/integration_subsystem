КонецПроцедуры

// Компилирует и подключает обработку, кладущую метку в результат, и возвращает имя её регистрации.
Функция ПодключитьОбработкуСМеткой(Знач Источник, Знач Метка)
	
	ТекстОбработчика = СтрШаблон("Результат.Вставить(""метка"", ""%1"");", Метка);
	
	Возврат инт_ГенераторОбработок.ПодключитьОбработку(
		инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика),
		инт_ГенераторОбработок.ИмяРегистрацииОбработки(
			Источник, инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика)));
	
КонецФункции

// Записывает HTTP-подписчика с обработчиком пост-обработки, кладущим метку в ответ.
Функция ПодписчикСПостОбработкой(Знач Метка)
	
	Возврат ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		ГенераторТестовыхДанных.ТекстПостОбработкиСМеткой(Метка));
	
КонецФункции

// Пустое имя не должно дойти до ВнешниеОбработки.Создать: платформа ответила бы
// сообщением о ненайденной обработке, из которого причина не видна.
Процедура ИсполнитьОбработку_ПустоеИмяНеДоходитДоПлатформы() Экспорт
	
	// Act
	ТекстОшибки = "";
	Попытка
		инт_ГенераторОбработок.ИсполнитьОбработку("", Неопределено);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(ТекстОшибки, "Текст ошибки при пустом имени обработки")
		.Содержит("Имя подключённой обработки не заполнено");
	
КонецПроцедуры

// Безопасный режим, установленный механизмом, снимается и на пути с исключением:
// иначе отказ одного обработчика менял бы условия исполнения остального кода вызова.
Процедура БезопасныйРежим_ВосстанавливаетсяПослеОшибкиОбработчикаПотока() Экспорт
	
	// Arrange
	РежимДоВызова = БезопасныйРежим();
	ИмяОбработки = ПодключитьОбработкуСМеткой(Справочники.инт_ПотокиДанных.ПолучитьСсылку(), "падение");
	ИмяПадающей = ПодключитьПадающуюОбработку();
	
	// Act
	Попытка
		инт_ГенераторОбработок.ИсполнитьОбработку(ИмяПадающей, Неопределено);
	Исключение
		// Отказ обработчика ожидаем, проверяется восстановление режима.
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(БезопасныйРежим(), "Безопасный режим после отказа обработчика потока")
		.Равно(РежимДоВызова);
	ЮТест.ОжидаетЧто(МеткаПодключеннойОбработки(ИмяОбработки), "Обработчик после отказа соседнего")
		.Равно("падение");
	
КонецПроцедуры

// То же для точки входа пост-обработки подписчика.
Процедура БезопасныйРежим_ВосстанавливаетсяПослеОшибкиОбработчикаПодписчика() Экспорт
	
	// Arrange
	РежимДоВызова = БезопасныйРежим();
	Подписчик = ГенераторТестовыхДанных.ПодписчикСПостОбработкой(
		ГенераторТестовыхДанных.ПодписчикHTTP(),
		200,
		"ВызватьИсключение ""Отказ обработчика подписчика"";");

// Возвращаемое значение:
//  Строка - Имя подключённой обработки.
//
Функция ПодключитьПадающуюОбработку()
	
	ТекстОбработчика = "ВызватьИсключение ""Отказ обработчика потока"";";
	
	Возврат инт_ГенераторОбработок.ПодключитьОбработку(
		инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика),
		инт_ГенераторОбработок.ИмяРегистрацииОбработки(
			Справочники.инт_ПотокиДанных.ПолучитьСсылку(),
			инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика)));
	
КонецФункции

// Число записей журнала регистрации по событию и владельцу.
//
// Параметры:
//  НачалоПроверки - Дата - Момент, начиная с которого просматривается журнал.
//  ИмяСобытия     - Строка - Имя события журнала регистрации.
//  Владелец       - ЛюбаяСсылка - Владелец обработчика, попадающий в параметр "данные".
//
// Возвращаемое значение:
//  Число - Количество подходящих записей.
//
Функция ЧислоЗаписейЖурнала(Знач НачалоПроверки, Знач ИмяСобытия, Знач Владелец)
	
	Отбор = Новый Структура("ДатаНачала, Событие", НачалоПроверки, ИмяСобытия);
	
	Журнал = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Журнал, Отбор);
	
	Количество = 0;
	Для Каждого Запись Из Журнал Цикл
		Если Запись.Данные = Владелец Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

// Сжатие контейнера идёт через временный файл. Тысяча сборок подряд не должна
// оставить в каталоге временных файлов ни одного лишнего файла.
Процедура СборкаОбработки_НеОставляетВременныхФайлов() Экспорт
	
	// Arrange
	МаскаФайлов = МаскаВременныхФайловЭтогоПроцесса();
	ЧислоФайловДо = ЧислоВременныхФайловЭтогоПроцесса(МаскаФайлов);
	
	// Act
	Для НомерСборки = 1 По 1000 Цикл
		инт_ГенераторОбработок.СкомпилироватьОбработку(
			СтрШаблон("Результат.Вставить(""номер"", %1);", Формат(НомерСборки, "ЧГ=0")));
	КонецЦикла;
	
	// Assert
	ЮТест.ОжидаетЧто(ЧислоВременныхФайловЭтогоПроцесса(МаскаФайлов),
			"Временных файлов этого процесса после тысячи сборок")
		.Равно(ЧислоФайловДо);
	
КонецПроцедуры

// Число временных файлов текущего процесса платформы.
// Каталог временных файлов общий для всех программ, поэтому счёт по всему каталогу
// ловил бы чужую работу за время тысячи сборок и ронял проверку случайно.
//
// Параметры:
//  МаскаФайлов - Строка - Маска файлов процесса (см. МаскаВременныхФайловЭтогоПроцесса).
//
// Возвращаемое значение:
//  Число - Количество файлов без учёта подкаталогов.
//
Функция ЧислоВременныхФайловЭтогоПроцесса(Знач МаскаФайлов)
	
	Возврат НайтиФайлы(КаталогВременныхФайлов(), МаскаФайлов, Ложь).Количество();
	
КонецФункции

// Маска временных файлов текущего процесса платформы.
// Платформа даёт временному файлу имя вида "<общая часть>_<номер>.tmp", где общая часть
// своя у каждого процесса: она и отделяет свои файлы от чужих. Маска строится из
// настоящего имени, а не из константы, поэтому переживёт смену правила именования.
//
// Возвращаемое значение:
//  Строка - Маска для НайтиФайлы.
//
Функция МаскаВременныхФайловЭтогоПроцесса()
	
	// Имя запрашивается до первого замера, поэтому на разность счётчиков не влияет.
	ВременныйФайл = Новый Файл(ПолучитьИмяВременногоФайла());
	ИмяФайла = ВременныйФайл.Имя;
	
	// Без разделителя маска выродилась бы в "*" и тихо вернула счёт всего каталога.
	ПозицияНомера = СтрНайти(ИмяФайла, "_", НаправлениеПоиска.СКонца);
	ЮТест.ОжидаетЧто(ПозицияНомера, СтрШаблон("Номер во временном имени ""%1""", ИмяФайла))
		.Больше(0);
	
	Возврат Лев(ИмяФайла, ПозицияНомера) + "*";
	
КонецФункции

// Собирает внешнюю обработку из готового текста модуля объекта.
// Механизм собирает модуль сам, поэтому оператора вне процедур в нём не бывает;
// здесь модуль задаётся целиком, чтобы такой оператор получить.
//
// Идентификатор внутреннего файла тот же, что в инт_ГенераторОбработок: он задан
// шаблоном контейнера, и его расхождение сломало бы и сам механизм.
//
// Параметры:
//  ТекстМодуля - Строка - Текст модуля объекта внешней обработки.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Собранная внешняя обработка.
//
Функция ОбработкаИзТекстаМодуля(Знач ТекстМодуля)
	
	ИдентификаторМодуляОбъекта = "00ab4620-8498-4b18-a4f8-18b53138fcb5.0";
	
	Редактор = Обработки.инт_РедакторОбработки.Создать();
	Редактор.ЗагрузитьШаблон();
	Редактор.УстановитьДанныеФайла(ИдентификаторМодуляОбъекта + "/text", ТекстМодуля);
	
	Возврат Редактор.СформироватьОбработку();
	
КонецФункции

// }}}

#КонецОбласти

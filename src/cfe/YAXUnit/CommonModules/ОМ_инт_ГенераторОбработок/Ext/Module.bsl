Процедура ПостОбработкаПодписчиковНеЗамещаетДругДруга() Экспорт
	
	// Arrange
	Первый = ПодписчикСПостОбработкой("первый");
	Второй = ПодписчикСПостОбработкой("второй");
	ОтветПервого = ГенераторТестовыхДанных.ОтветПодписчика(200);
	ОтветВторого = ГенераторТестовыхДанных.ОтветПодписчика(200);
	ОтветПервогоПовторно = ГенераторТестовыхДанных.ОтветПодписчика(200);
	
	// Act
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Первый, ОтветПервого);
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Второй, ОтветВторого);
	Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Первый, ОтветПервогоПовторно);
	
	// Assert
	ЮТест.ОжидаетЧто(ОтветПервого).Свойство("метка").Равно("первый");
	ЮТест.ОжидаетЧто(ОтветВторого).Свойство("метка").Равно("второй");
	ЮТест.ОжидаетЧто(ОтветПервогоПовторно, "Повторная пост-обработка первого подписчика")
		.Свойство("метка").Равно("первый");
	
КонецПроцедуры

Процедура ПотокДанныхИПодписчикВОдномСеансеИсполняютСвойКод() Экспорт
	

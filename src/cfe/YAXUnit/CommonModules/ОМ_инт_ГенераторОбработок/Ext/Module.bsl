		инт_ГенераторОбработок.ХешТекстаОбработчика(Строка(Новый УникальныйИдентификатор)));
	
	Возврат МеткаПодключеннойОбработки(
		инт_ГенераторОбработок.ПодключитьОбработку(ДвоичныеДанныеEPF, ИмяРегистрации));
	
КонецФункции

Функция МеткаПодключеннойОбработки(Знач ИмяОбработки)
	
	Возврат инт_ГенераторОбработок.ИсполнитьОбработку(ИмяОбработки, Неопределено)["метка"];
	
КонецФункции

// Имя регистрации обработчика пост-обработки для нового подписчика.
//
// Параметры:
//  ТекстОбработчика - Строка - Текст обработчика.
//
// Возвращаемое значение:
//  Строка - Имя регистрации.
//
Функция ИмяРегистрацииДляПодписчика(Знач ТекстОбработчика)

	Возврат инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		Справочники.инт_ПодписчикиHTTP.ПолучитьСсылку(),
		инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика));

КонецФункции

// Номер исходной строки для строки модуля, содержащей заданный текст.
// Ноль означает, что строке модуля исходная строка не соответствует.
//
// Параметры:
//  РезультатГенерации - Структура - См. инт_ГенераторОбработок.СформироватьМодульОбъекта.
//  СтрокиМодуля       - Массив из Строка - Строки сформированного модуля.
//  ИскомыйТекст       - Строка - Текст, по которому отыскивается строка модуля.
//
// Возвращаемое значение:
//  Число - Номер исходной строки, ноль для служебной строки, минус один - если не найдено.
//
Функция ИсходнаяСтрокаПоТексту(Знач РезультатГенерации, Знач СтрокиМодуля, Знач ИскомыйТекст)
	
	Для НомерСтроки = 1 По СтрокиМодуля.Количество() Цикл
		Если СтрНайти(СтрокиМодуля[НомерСтроки - 1], ИскомыйТекст) > 0 Тогда
			ИсходнаяСтрока = РезультатГенерации.СоответствиеСтрок[НомерСтроки];
			Возврат ?(ИсходнаяСтрока = Неопределено, 0, ИсходнаяСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

// Имена переменных контракта через запятую.
//
// Параметры:
//  ВидОбработчика - Строка - См. инт_ГенераторОбработок.ПеременныеКонтекста.
//
// Возвращаемое значение:
//  Строка - Имена через запятую в порядке контракта.
//
Функция ИменаКонтекста(Знач ВидОбработчика)
	
	Имена = Новый Массив;
	Для Каждого ОписаниеПеременной Из инт_ГенераторОбработок.ПеременныеКонтекста(ВидОбработчика) Цикл
		Имена.Добавить(ОписаниеПеременной.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(Имена, ",");
	
КонецФункции

// Имена переменных, объявленных в модуле, через запятую.
//
// Параметры:
//  ТекстМодуля - Строка - Текст сформированного модуля объекта.
//
// Возвращаемое значение:
//  Строка - Имена через запятую в порядке объявления.
//
Функция ОбъявленныеПеременные(Знач ТекстМодуля)
	
	Имена = Новый Массив;
	Для Каждого СтрокаМодуля Из СтрРазделить(ТекстМодуля, Символы.ПС) Цикл
		Если Не СтрНачинаетсяС(СокрЛП(СтрокаМодуля), "Перем ") Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(СтрЗаменить(СокрЛП(СтрокаМодуля), ";", ""), " ");
		Имена.Добавить(Части[1]);
	КонецЦикла;
	
	Возврат СтрСоединить(Имена, ",");
	
КонецФункции

// Файлы документации, в которых размечены примеры обработчиков.
//
// Возвращаемое значение:
//  Массив из Строка - Полные имена файлов.
//
Функция ФайлыДокументацииСПримерами()
	
	ОтносительныеПути = Новый Массив;
	ОтносительныеПути.Добавить("docs/concepts/data-flows.md");
	ОтносительныеПути.Добавить("docs/concepts/subscribers.md");
	ОтносительныеПути.Добавить("docs/guide/configure-subscribers.md");
	
	ПолныеИмена = Новый Массив;
	Для Каждого ОтносительныйПуть Из ОтносительныеПути Цикл
		Зависимость = ЮТест.Зависимость(ЮТЗависимости.ФайлыПроекта(ОтносительныйПуть));
		ПолныеИмена.Добавить(Зависимость.ПолноеИмя);
	КонецЦикла;
	
	Возврат ПолныеИмена;
	
КонецФункции

// Собирает из файла документации размеченные примеры обработчиков.
// Разметка - комментарий вида "пример обработчика: ВидОбработчика" перед блоком кода.
//
// Параметры:
//  ПолноеИмяФайла - Строка - Полное имя файла документации.
//  Примеры        - Массив - Приёмник: Структура с полями Файл, Вид, Текст.
//
Процедура ДляКаждогоПримераИзФайла(Знач ПолноеИмяФайла, Примеры)
	
	ФайлДокументации = Новый Файл(ПолноеИмяФайла);
	ИмяФайла = ФайлДокументации.Имя;
	Строки = СтрРазделить(ЮТОбщий.ДанныеТекстовогоФайла(ПолноеИмяФайла), Символы.ПС);
	
	Вид = "";
	ВнутриПримера = Ложь;
	Текст = Новый Массив;
	
	Для Каждого СтрокаФайла Из Строки Цикл
		
		Обрезанная = СокрЛП(СтрокаФайла);
		
		Если ВнутриПримера Тогда
			Если Обрезанная = "```" Тогда
				Пример = Новый Структура("Файл, Вид, Текст", ИмяФайла, Вид, СтрСоединить(Текст, Символы.ПС));
				Примеры.Добавить(Пример);
				ВнутриПримера = Ложь;
				Вид = "";
			Иначе
				Текст.Добавить(СтрокаФайла);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Обрезанная, "<!-- пример обработчика:") Тогда
			Вид = СокрЛП(СтрЗаменить(СтрЗаменить(Обрезанная, "<!-- пример обработчика:", ""), "-->", ""));
		ИначеЕсли ЗначениеЗаполнено(Вид) И Обрезанная = "```bsl" Тогда
			ВнутриПримера = Истина;
			Текст = Новый Массив;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Собирает пример как обработчик, подключает и создаёт экземпляр.
//
// Параметры:
//  Пример - Структура - Файл, Вид, Текст.
//
// Возвращаемое значение:
//  Строка - Имя подключённой обработки.
//
Функция ИмяСозданнойОбработки(Знач Пример)
	
	ЮТест.ОжидаетЧто(инт_ГенераторОбработок.РазобратьКодНаБлоки(Пример.Текст).Проблемы,
			СтрШаблон("Проблемы разбора примера ""%1"" из %2", Пример.Вид, Пример.Файл))
		.ИмеетДлину(0);
	
	ТочкаВходаПостОбработки = (Пример.Вид = "ПостОбработкаПодписчика");
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(
		Пример.Текст, , ТочкаВходаПостОбработки);
	
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		Справочники.инт_ПотокиДанных.ПолучитьСсылку(),
		инт_ГенераторОбработок.ХешТекстаОбработчика(Пример.Текст));
	
	ИмяПодключенной = инт_ГенераторОбработок.ПодключитьОбработку(ДвоичныеДанныеEPF, ИмяРегистрации);
	ВнешниеОбработки.Создать(ИмяПодключенной, Ложь);
	
	Возврат ИмяПодключенной;
	
КонецФункции

// Текст исключения функции получения имени обработки потока.
//
// Параметры:
//  ПотокДанных - СправочникСсылка.инт_ПотокиДанных - Проверяемый поток данных.

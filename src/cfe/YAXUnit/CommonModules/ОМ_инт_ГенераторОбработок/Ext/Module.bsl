// {{{ РазобратьКодНаБлоки

Процедура РазобратьКод_ТолькоТело() Экспорт
	
	// Arrange
	Код = "Результат.Вставить(""Ключ"", ИсходныеДанные.Наименование);";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Содержит("Результат.Вставить");
	
КонецПроцедуры

Процедура РазобратьКод_ТолькоПроцедура() Экспорт
	
	// Arrange
	Код = "Процедура МояПроцедура()
	|	Сообщить(""Привет"");
	|КонецПроцедуры";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур[0]).Содержит("Процедура МояПроцедура");
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Равно("");
	
КонецПроцедуры

Процедура РазобратьКод_ПроцедураИТело() Экспорт
	
	// Arrange
	Код = "Процедура Помощник(Значение)
	|	Результат.Вставить(""helper"", Значение);
	|КонецПроцедуры
	|
	|Помощник(ИсходныеДанные.Наименование);";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур[0]).Содержит("Процедура Помощник");
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Содержит("Помощник(ИсходныеДанные");
	
КонецПроцедуры

Процедура РазобратьКод_ФункцияИТело() Экспорт
	
	// Arrange
	Код = "Функция ПолучитьЗначение(Ключ)
	|	Возврат ИсходныеДанные[Ключ];
	|КонецФункции
	|
	|Результат.Вставить(""val"", ПолучитьЗначение(""Имя""));";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур[0]).Содержит("Функция ПолучитьЗначение");
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Содержит("ПолучитьЗначение(""Имя"")");
	
КонецПроцедуры

Процедура РазобратьКод_НесколькоПроцедурИТело() Экспорт
	
	// Arrange
	Код = "Функция Сумма(А, Б)
	|	Возврат А + Б;
	|КонецФункции
	|
	|Процедура Логировать(Сообщение)
	|	// пока ничего
	|КонецПроцедуры
	|
	|Результат.Вставить(""итого"", Сумма(1, 2));";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур[0]).Содержит("Функция Сумма");
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур[1]).Содержит("Процедура Логировать");
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Содержит("Сумма(1, 2)");
	
КонецПроцедуры

// Разбор незакрытого блока не меняется: текст по-прежнему уезжает в тело кода.
// Изменилось лишь то, что об этом теперь сообщается, см. отдельный тест.
Процедура РазобратьКод_НезакрытыйБлокСтановитсяТелом() Экспорт
	
	// Arrange — процедура без КонецПроцедуры
	Код = "Процедура Незавершённая()
	|	Сообщить(""тест"");";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert — незакрытый блок попадает в тело кода
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Содержит("Процедура Незавершённая");
	ЮТест.ОжидаетЧто(Блоки.Проблемы.Количество(), "Число проблем разбора").Равно(1);
	
КонецПроцедуры

// Строка начала незакрытого блока и ожидаемое ключевое слово нужны пользователю,
// чтобы искать пропуск в своём тексте, а не в сгенерированном модуле.
Процедура РазобратьКод_НезакрытыйБлокДаетПроблемуСоСтрокой() Экспорт
	
	// Arrange: функция без КонецФункции начинается на третьей строке
	Код = "Результат.Вставить(""ключ"", 1);
	|
	|Функция Незавершённая()
	|	Возврат 1;";
	
	// Act
	Проблемы = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код).Проблемы;
	
	// Assert
	ЮТест.ОжидаетЧто(Проблемы, "Проблемы разбора").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Проблемы[0].Строка, "Строка начала незакрытого блока").Равно(3);
	ЮТест.ОжидаетЧто(Проблемы[0].Текст, "Текст проблемы")
		.Содержит("КонецФункции")
		.Содержит("3");
	
КонецПроцедуры

// Корректный текст проблем не даёт: иначе диагностика мешала бы работе.
Процедура РазобратьКод_КорректныйТекстПроблемНеДает() Экспорт
	
	// Arrange
	Код = "Функция Удвоить(Значение)
	|	Возврат Значение * 2;
	|КонецФункции
	|
	|Результат.Вставить(""ключ"", Удвоить(21));";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.Проблемы, "Проблемы разбора корректного текста").ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество(), "Блоков процедур").Равно(1);
	
КонецПроцедуры

// Объявление переменной в теле обработчика отвергается: тело размещается внутри функции,
// где объявлениям места нет. Внутри пользовательской процедуры Перем допустим.
Процедура РазобратьКод_ОбъявлениеПеременнойОтвергается() Экспорт
	
	// Arrange
	КодСОбъявлением = "Перем Счётчик;
	|Результат.Вставить(""ключ"", 1);";
	КодСОбъявлениемВПроцедуре = "Процедура Служебная()
	|	Перем Счётчик;
	|	Счётчик = 1;
	|КонецПроцедуры
	|
	|Служебная();";
	
	// Act
	ПроблемыТела = инт_ГенераторОбработок.РазобратьКодНаБлоки(КодСОбъявлением).Проблемы;
	ПроблемыПроцедуры = инт_ГенераторОбработок.РазобратьКодНаБлоки(КодСОбъявлениемВПроцедуре).Проблемы;
	
	// Assert
	ЮТест.ОжидаетЧто(ПроблемыТела, "Проблемы для объявления в теле обработчика").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(ПроблемыТела[0].Строка, "Строка объявления").Равно(1);
	ЮТест.ОжидаетЧто(ПроблемыТела[0].Текст, "Текст проблемы").Содержит("Перем");
	ЮТест.ОжидаетЧто(ПроблемыПроцедуры, "Проблемы для объявления внутри процедуры").ИмеетДлину(0);
	
КонецПроцедуры

Процедура РазобратьКод_ПустойКод() Экспорт
	
	// Arrange
	Код = "";
	
	// Act
	Блоки = инт_ГенераторОбработок.РазобратьКодНаБлоки(Код);
	
	// Assert
	ЮТест.ОжидаетЧто(Блоки.БлокиПроцедур.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Блоки.ТелоКода).Равно("");
	
КонецПроцедуры

// }}}

// {{{ СформироватьМодульОбъекта

Процедура Модуль_ТолькоТело_СодержитОбработать() Экспорт
	
	// Arrange
	Код = "Результат.Вставить(""key"", ИсходныеДанные.Наименование);";
	
	// Act
	Результат = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код);
	Модуль = Результат.ТекстМодуля;
	
	// Assert
	ЮТест.ОжидаетЧто(Модуль).Содержит("Перем Результат Экспорт;");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Перем ИсходныеДанные;");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Функция Обработать(пИсходныеДанные) Экспорт");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Возврат Результат;");
	ЮТест.ОжидаетЧто(Модуль).Содержит("КонецФункции");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Результат.Вставить");
	
КонецПроцедуры

Процедура Модуль_СПроцедурой_ПроцедураНаУровнеМодуля() Экспорт
	
	// Arrange
	Код = "Функция МояФункция()
	|	Возврат 42;
	|КонецФункции
	|
	|Результат.Вставить(""answer"", МояФункция());";
	
	// Act
	Результат = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код);
	Модуль = Результат.ТекстМодуля;
	
	// Assert — функция на уровне модуля (вне Обработать)
	ЮТест.ОжидаетЧто(Модуль).Содержит("Функция МояФункция()");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Возврат 42;");
	// Тело кода внутри Обработать
	ЮТест.ОжидаетЧто(Модуль).Содержит("МояФункция()");
	
КонецПроцедуры

// Точка входа пост-обработки запрашивается явным параметром, а не наличием переменной
// с именем Ответ: переменную объявляет сама точка входа.
Процедура Модуль_СДопПеременными_СодержитОтветИПостПроцессинг() Экспорт
	
	// Arrange
	Код = "Сообщить(Ответ.КодСостояния);";
	
	// Act
	Модуль = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код, , Истина).ТекстМодуля;
	
	// Assert
	ЮТест.ОжидаетЧто(Модуль).Содержит("Перем Ответ Экспорт;");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Процедура ОбработатьПостПроцессинг(пОтвет, пИсходныеДанные) Экспорт");
	ЮТест.ОжидаетЧто(Модуль).Содержит("Ответ = пОтвет;");
	
	// Без явного признака точки входа в модуле нет.
	МодульБезПостОбработки = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код).ТекстМодуля;
	ЮТест.ОжидаетЧто(МодульБезПостОбработки, "Модуль без точки входа пост-обработки")
		.НеСодержит("ОбработатьПостПроцессинг");
	
КонецПроцедуры

// Тело обработчика попадает в модуль один раз: точка входа пост-обработки не повторяет
// его, а вызывает ту же функцию Обработать.
Процедура Модуль_ТелоОбработчикаРазмещаетсяОдинРаз() Экспорт
	
	// Arrange
	Код = "Ответ.Вставить(""метка"", ""однажды"");";
	
	// Act
	Результат = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код, , Истина);
	
	// Assert
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Результат.ТекстМодуля, Код), "Вхождений тела обработчика в модуль")
		.Равно(1);
	ЮТест.ОжидаетЧто(Результат.ТекстМодуля)
		.Содержит("Процедура ОбработатьПостПроцессинг(пОтвет, пИсходныеДанные) Экспорт")
		.Содержит("Обработать(пИсходныеДанные);");
	
КонецПроцедуры

// Возврат из тела обработчика допустим: тело лежит в функции, а точка входа
// пост-обработки его лишь вызывает.
Процедура ПостОбработка_ОбработчикСВозвратомИсполняется() Экспорт
	
	// Arrange
	ТекстОбработчика = "Ответ.Вставить(""метка"", ""до возврата"");
	|Возврат Истина;";
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика, , Истина);
	ИмяРегистрации = ИмяРегистрацииДляПодписчика(ТекстОбработчика);
	Обработка = инт_ГенераторОбработок.ПодключаемаяОбработка(ДвоичныеДанныеEPF, ИмяРегистрации);
	Ответ = Новый Структура("метка", "");
	
	// Act
	инт_ГенераторОбработок.ИсполнитьОбработкуПодписчика(Обработка, Ответ, Неопределено);
	
	// Assert
	ЮТест.ОжидаетЧто(Ответ, "Ответ после пост-обработки с оператором Возврат")
		.Свойство("метка").Равно("до возврата");
	
КонецПроцедуры

// Обработка, собранная без точки входа пост-обработки, отвергается с понятным текстом
// до вызова метода: сообщение платформы о ненайденном методе причину не объясняет.
Процедура ПостОбработка_БезТочкиВходаПонятноеИсключение() Экспорт
	
	// Arrange
	ТекстОбработчика = "Результат.Вставить(""метка"", ""без точки входа"");";
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика);
	ИмяРегистрации = ИмяРегистрацииДляПодписчика(ТекстОбработчика);
	Обработка = инт_ГенераторОбработок.ПодключаемаяОбработка(ДвоичныеДанныеEPF, ИмяРегистрации);
	Ответ = Новый Структура("метка", "");
	
	// Act
	ТекстОшибки = "";
	Попытка
		инт_ГенераторОбработок.ИсполнитьОбработкуПодписчика(Обработка, Ответ, Неопределено);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(ТекстОшибки, "Текст исключения при обработке без точки входа")
		.Содержит("без точки входа пост-обработки");
	
КонецПроцедуры

// Карта строк покрывает и процедуры пользователя, и тело кода. Без неё ошибка во второй
// процедуре пересчитывалась бы относительно начала первой.
Процедура СоответствиеСтрок_ДвеПроцедурыИТелоКода() Экспорт
	
	// Arrange
	ТекстОбработчика = "Процедура Первая()
	|	Сообщить(""первая"");
	|КонецПроцедуры
	|
	|Процедура Вторая()
	|	Сообщить(""вторая"");
	|КонецПроцедуры
	|
	|Первая();
	|Вторая();";
	
	// Act
	Результат = инт_ГенераторОбработок.СформироватьМодульОбъекта(ТекстОбработчика);
	СтрокиМодуля = СтрРазделить(Результат.ТекстМодуля, Символы.ПС);
	
	// Assert
	ЮТест.ОжидаетЧто(ИсходнаяСтрокаПоТексту(Результат, СтрокиМодуля, "Сообщить(""первая"");"),
			"Исходная строка тела первой процедуры")
		.Равно(2);
	ЮТест.ОжидаетЧто(ИсходнаяСтрокаПоТексту(Результат, СтрокиМодуля, "Сообщить(""вторая"");"),
			"Исходная строка тела второй процедуры")
		.Равно(6);
	ЮТест.ОжидаетЧто(ИсходнаяСтрокаПоТексту(Результат, СтрокиМодуля, "Первая();"),
			"Исходная строка первой строки тела кода")
		.Равно(9);
	ЮТест.ОжидаетЧто(ИсходнаяСтрокаПоТексту(Результат, СтрокиМодуля, "Перем Результат Экспорт;"),
			"Исходная строка служебного объявления")
		.Равно(0);
	
КонецПроцедуры

// Сохранённая обработка, собранная прежним правилом, к повторному использованию непригодна:
// признака точки входа в ней нет, а текст совпадает.
Процедура СохраненнаяОбработка_СобраннаяПрежнимПравиломНеПригодна() Экспорт
	
	// Arrange
	ТекстОбработчика = "Ответ.Вставить(""метка"", ""прежнее правило"");";
	ВерсияТекста = инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика);
	
	// Обработка того релиза, где точку входа задавал набор переменных.
	ОбработкаСНабором = Новый Структура("ДвоичныеДанные, Версия, Переменные");
	ОбработкаСНабором.ДвоичныеДанные = инт_ГенераторОбработок.СкомпилироватьОбработку(
		ТекстОбработчика, Новый Структура("Ответ", ""));
	ОбработкаСНабором.Версия = ВерсияТекста;
	ОбработкаСНабором.Переменные = "Ответ";
	
	// Обработка без набора и без признака точки входа: и текст, и состав переменных
	// совпадают с требуемыми, поэтому отвергнуть её может только сверка признака.
	ОбработкаБезПризнака = Новый Структура("ДвоичныеДанные, Версия, Переменные");
	ОбработкаБезПризнака.ДвоичныеДанные = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика);
	ОбработкаБезПризнака.Версия = ВерсияТекста;
	ОбработкаБезПризнака.Переменные = "";
	
	ОбработкаТекущегоПравила = инт_ГенераторОбработок.СохраняемаяОбработка(ТекстОбработчика, , Истина);
	
	// Act
	ПригодностьСНабором = инт_ГенераторОбработок.СохраненнаяОбработкаПригодна(
		ОбработкаСНабором, ТекстОбработчика, , Истина);
	ПригодностьБезПризнака = инт_ГенераторОбработок.СохраненнаяОбработкаПригодна(
		ОбработкаБезПризнака, ТекстОбработчика, , Истина);
	ПригодностьТекущей = инт_ГенераторОбработок.СохраненнаяОбработкаПригодна(
		ОбработкаТекущегоПравила, ТекстОбработчика, , Истина);
	
	// Assert
	ЮТест.ОжидаетЧто(ПригодностьСНабором, "Пригодность обработки с прежним набором переменных")
		.Равно(Ложь);
	ЮТест.ОжидаетЧто(ПригодностьБезПризнака, "Пригодность обработки без признака точки входа")
		.Равно(Ложь);
	ЮТест.ОжидаетЧто(ПригодностьТекущей, "Пригодность обработки, собранной текущим правилом")
		.Равно(Истина);
	
КонецПроцедуры

// Сформированный модуль объявляет ровно перечень контракта: имена, которые видит
// пользователь в подсказках редактора и в документации.
Процедура Модуль_ОбъявляетПеременныеКонтрактаДляТрехВидовОбработчиков() Экспорт
	
	// Arrange
	Код = "Результат.Вставить(""ключ"", 1);";
	
	// Act
	МодульПотока = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код).ТекстМодуля;
	МодульПодписчика = инт_ГенераторОбработок.СформироватьМодульОбъекта(Код, , Истина).ТекстМодуля;
	
	// Assert: имена у обоих направлений потока совпадают, поэтому модуль у них один
	ЮТест.ОжидаетЧто(ИменаКонтекста("ПотокДанныхИсходящий"), "Имена контекста исходящего потока")
		.Равно(ИменаКонтекста("ПотокДанныхВходящий"));
	
	ЮТест.ОжидаетЧто(ОбъявленныеПеременные(МодульПотока), "Объявления модуля обработчика потока")
		.Равно("ИсходныеДанные,Результат");
	ЮТест.ОжидаетЧто(ОбъявленныеПеременные(МодульПодписчика), "Объявления модуля обработчика подписчика")
		.Равно("ИсходныеДанные,Ответ,Результат");
	
	ЮТест.ОжидаетЧто(ОбъявленныеПеременные(МодульПотока), "Объявления против контракта потока")
		.Равно(ИменаКонтекста("ПотокДанныхИсходящий"));
	ЮТест.ОжидаетЧто(ОбъявленныеПеременные(МодульПодписчика), "Объявления против контракта подписчика")
		.Равно(ИменаКонтекста("ПостОбработкаПодписчика"));
	
КонецПроцедуры

// Примеры обработчиков из документации собираются и создаются на текущей конфигурации.
// Создание экземпляра - та стадия, на которой платформа компилирует модуль целиком,
// поэтому обращение к необъявленной переменной проявится именно здесь.
Процедура Документация_ПримерыОбработчиковСобираютсяИСоздаются() Экспорт
	
	// Arrange
	Примеры = Новый Массив;
	Для Каждого ПутьКФайлу Из ФайлыДокументацииСПримерами() Цикл
		ДляКаждогоПримераИзФайла(ПутьКФайлу, Примеры);
	КонецЦикла;
	
	// Assert: примеры найдены, иначе проверка выродилась бы в пустой цикл
	ЮТест.ОжидаетЧто(Примеры.Количество(), "Найдено примеров обработчиков в документации")
		.Равно(4);
	
	// Act + Assert
	Для Каждого Пример Из Примеры Цикл
		ИмяСозданной = ИмяСозданнойОбработки(Пример);
		ЮТест.ОжидаетЧто(ИмяСозданной, СтрШаблон("Пример ""%1"" из %2", Пример.Вид, Пример.Файл))
			.Заполнено();
	КонецЦикла;
	
КонецПроцедуры

// Пустой текст обработчика собирать нечего: прежде получался EPF с пустым телом

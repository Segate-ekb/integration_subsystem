	// Act
	Попытка
		Справочники.инт_ПодписчикиHTTP.ВыполнитьПостПроцессинг(Подписчик, Ответ);
	Исключение
		// Отказ обработчика ожидаем, проверяется восстановление режима.
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(БезопасныйРежим(), "Безопасный режим после отказа обработчика подписчика")
		.Равно(РежимДоВызова);
	
КонецПроцедуры

// Привилегированный режим охватывает только вызов подключения и снимается на обоих путях:
// к моменту создания экземпляра и исполнения прикладного кода его уже нет.
Процедура ПривилегированныйРежим_СнятПослеПодключенияИПослеОтказа() Экспорт
	
	// Arrange
	ТекстОбработчика = "Результат.Вставить(""метка"", ""привилегии"");";
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		Справочники.инт_ПотокиДанных.ПолучитьСсылку(),
		инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика));
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика);
	
	// Act: успешное подключение
	ИмяПодключенной = инт_ГенераторОбработок.ПодключитьОбработку(ДвоичныеДанныеEPF, ИмяРегистрации);
	РежимПослеУспеха = ПривилегированныйРежим();
	
	// Act: отказ подключения
	Попытка
		инт_ГенераторОбработок.ПодключитьОбработку(
			ПолучитьДвоичныеДанныеИзСтроки("это не внешняя обработка"), ИмяРегистрации + "_Отказ");
	Исключение
		ТекстОтказа = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	РежимПослеОтказа = ПривилегированныйРежим();
	
	// Assert
	ЮТест.ОжидаетЧто(ИмяПодключенной, "Имя подключённой обработки").Равно(ИмяРегистрации);
	ЮТест.ОжидаетЧто(РежимПослеУспеха, "Привилегированный режим после успешного подключения").Равно(Ложь);
	ЮТест.ОжидаетЧто(РежимПослеОтказа, "Привилегированный режим после отказа подключения").Равно(Ложь);
	ЮТест.ОжидаетЧто(ТекстОтказа, "Текст отказа подключения")
		.Содержит("подключение внешней обработки")
		.Содержит("Интерактивное открытие внешних обработок");
	
КонецПроцедуры

// Компиляция и подключение записываются один раз на версию обработчика в сеансе:
// повторное обращение обходится кэшем и новых записей не даёт.
Процедура Журнал_ПерваяКомпиляцияИПодключениеЗаписаныОдинРаз() Экспорт
	
	// Arrange: признак версии очищен в режиме загрузки, поэтому первое обращение компилирует
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("журнал");
	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.ХешСкомпилированногоОбработчика = "";
	ОбъектПотока.ОбменДанными.Загрузка = Истина;
	ОбъектПотока.Записать();
	
	НачалоПроверки = ТекущаяДатаСеанса();
	
	// Act
	ИмяПервогоОбращения = инт_ГенераторОбработок.ИмяОбработкиПотока(ПотокДанных);
	ЗаписейКомпиляции = ЧислоЗаписейЖурнала(НачалоПроверки,
		"ПодсистемаИнтеграции.ГенераторОбработок.Компиляция", ПотокДанных);
	ЗаписейПодключения = ЧислоЗаписейЖурнала(НачалоПроверки,
		"ПодсистемаИнтеграции.ГенераторОбработок.Подключение", ПотокДанных);
	
	ИмяПовторногоОбращения = инт_ГенераторОбработок.ИмяОбработкиПотока(ПотокДанных);
	
	// Assert
	ЮТест.ОжидаетЧто(ЗаписейКомпиляции, "Записей о компиляции после первого обращения").Равно(1);
	ЮТест.ОжидаетЧто(ЗаписейПодключения, "Записей о подключении после первого обращения").Равно(1);
	ЮТест.ОжидаетЧто(ИмяПовторногоОбращения, "Имя при повторном обращении").Равно(ИмяПервогоОбращения);
	
	ЮТест.ОжидаетЧто(ЧислоЗаписейЖурнала(НачалоПроверки,
			"ПодсистемаИнтеграции.ГенераторОбработок.Компиляция", ПотокДанных),
			"Записей о компиляции после повторного обращения")
		.Равно(1);
	ЮТест.ОжидаетЧто(ЧислоЗаписейЖурнала(НачалоПроверки,
			"ПодсистемаИнтеграции.ГенераторОбработок.Подключение", ПотокДанных),
			"Записей о подключении после повторного обращения")
		.Равно(1);
	
КонецПроцедуры

// Оператор уровня модуля исполняется при создании экземпляра, а экземпляр создаётся
// в ИсполнитьОбработку до включения безопасного режима, то есть с правами вызывающего.
// Проверка наблюдаемая: оператор сам сообщает, с какими правами его исполнили, и путь
// исполнения тот же, что у прикладного обработчика. Она сторожит границу привилегированного
// участка от сдвига за пределы подключения.
Процедура ПривилегированныйРежим_ОператорУровняМодуляИсполняетсяБезПолныхПрав() Экспорт
	
	// Arrange
	ЮТест.ОжидаетЧто(ПривилегированныйРежим(), "Привилегированный режим до обращения к механизму")
		.Равно(Ложь);
	
	ТекстМодуля = "Перем Результат Экспорт;
	|
	|Функция Обработать(пИсходныеДанные) Экспорт
	|	Возврат Результат;
	|КонецФункции
	|
	|Результат = ПривилегированныйРежим();";
	
	ДвоичныеДанныеEPF = ОбработкаИзТекстаМодуля(ТекстМодуля);
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		Справочники.инт_ПотокиДанных.ПолучитьСсылку(),
		инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстМодуля));
	
	// Act
	ИмяПодключенной = инт_ГенераторОбработок.ПодключитьОбработку(ДвоичныеДанныеEPF, ИмяРегистрации);
	РежимВОператоре = инт_ГенераторОбработок.ИсполнитьОбработку(ИмяПодключенной, Неопределено);
	
	// Assert
	ЮТест.ОжидаетЧто(РежимВОператоре, "Привилегированный режим в операторе уровня модуля")
		.Равно(Ложь);
	
КонецПроцедуры

// }}}

// {{{ КэшированиеСкомпилированногоОбработчика

// Совпадение признака версии означает, что сохранённый EPF собран из текущего текста.
// Наблюдается по коду, который исполняет полученный EPF: после повторной компиляции
// он исполнял бы текущий текст, а не сохранённый.
Процедура РазрешитьEPF_ПриСовпаденииВерсииНеКомпилируетЗаново() Экспорт
	
	// Arrange
	ТекстОбработчика = ТекстОбработчикаСМеткой("текущий");
	СохранённыйEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчикаСМеткой("сохранённый"));
	
	// Act
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.РазрешитьEPF(
		ТекстОбработчика,
		СохранённыйEPF,
		инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика));
	
	// Assert
	ЮТест.ОжидаетЧто(МеткаИзEPF(ДвоичныеДанныеEPF), "Метка обработчика из полученного EPF")
		.Равно("сохранённый");
	
КонецПроцедуры

Процедура РазрешитьEPF_ПриНесовпаденииВерсииКомпилируетЗаново() Экспорт
	
	// Arrange
	ТекстОбработчика = ТекстОбработчикаСМеткой("текущий");
	УстаревшийТекст = ТекстОбработчикаСМеткой("устаревший");
	
	// Act
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.РазрешитьEPF(
		ТекстОбработчика,
		инт_ГенераторОбработок.СкомпилироватьОбработку(УстаревшийТекст),
		инт_ГенераторОбработок.ХешТекстаОбработчика(УстаревшийТекст));
	
	// Assert
	ЮТест.ОжидаетЧто(МеткаИзEPF(ДвоичныеДанныеEPF), "Метка обработчика из полученного EPF")
		.Равно("текущий");
	
КонецПроцедуры

// У элементов, записанных до появления признака версии, он пуст, и сохранённому EPF
// доверять нечем: обработка собирается заново.
Процедура РазрешитьEPF_БезПризнакаВерсииКомпилируетЗаново() Экспорт
	
	// Arrange
	ТекстОбработчика = ТекстОбработчикаСМеткой("текущий");
	СохранённыйEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчикаСМеткой("сохранённый"));
	
	// Act
	ДвоичныеДанныеEPF = инт_ГенераторОбработок.РазрешитьEPF(ТекстОбработчика, СохранённыйEPF);
	
	// Assert
	ЮТест.ОжидаетЧто(МеткаИзEPF(ДвоичныеДанныеEPF), "Метка обработчика из полученного EPF")
		.Равно("текущий");
	
КонецПроцедуры

// Признак версии решает, выполняется ли компиляция. По результату это неразличимо:
// повторная компиляция того же текста даёт тот же EPF, что и сохранённый. Различить
// пропуск компиляции от её повторения позволяет только подмена зависимости.
Процедура РазрешитьEPF_КомпилируетТолькоПриНесовпаденииВерсии() Экспорт
	
	// Arrange
	ТекстОбработчика = ТекстОбработчикаСМеткой("сохранённый");
	СохранённыйEPF = инт_ГенераторОбработок.СкомпилироватьОбработку(ТекстОбработчика);
	ПризнакВерсии = инт_ГенераторОбработок.ХешТекстаОбработчика(ТекстОбработчика);
	
	Мокито.Обучение(инт_ГенераторОбработок)
		.Наблюдать("СкомпилироватьОбработку")
		.Прогон();
	
	// Act
	инт_ГенераторОбработок.РазрешитьEPF(ТекстОбработчика, СохранённыйEPF, "признак иной версии");
	инт_ГенераторОбработок.РазрешитьEPF(ТекстОбработчика, СохранённыйEPF, ПризнакВерсии);
	
	// Assert
	Мокито.Проверить(инт_ГенераторОбработок, "Вызовы компиляции на два обращения с разными признаками версии")
		.КоличествоВызовов("СкомпилироватьОбработку")
		.Равно(1);
	
КонецПроцедуры

Процедура ЗаписьПотока_ЗаполняетПризнакВерсииВместеСEPF() Экспорт
	
	// Arrange + Act
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первая версия");
	
	// Assert
	ЮТест.ОжидаетЧто(ПотокДанных.ХешСкомпилированногоОбработчика, "Признак версии обработчика")
		.Равно(инт_ГенераторОбработок.ХешТекстаОбработчика(ПотокДанных.ТекстОбработчика));
	ЮТест.ОжидаетЧто(ПотокДанных.СкомпилированныйОбработчик.Получить(), "Сохранённый EPF")
		.НеРавно(Неопределено);
	
КонецПроцедуры

// Признак версии и сохранённый EPF обновляются при любой записи, а не только из формы элемента.
Процедура ПравкаТекстаОбработчика_ОбновляетПризнакВерсииИEPF() Экспорт
	
	// Arrange
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первая версия");
	НовыйТекст = ТекстОбработчикаСМеткой("вторая версия");
	
	// Act
	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.ТекстОбработчика = НовыйТекст;
	ОбъектПотока.Записать();
	
	// Assert
	ЮТест.ОжидаетЧто(ПотокДанных.ХешСкомпилированногоОбработчика, "Признак версии после правки текста")
		.Равно(инт_ГенераторОбработок.ХешТекстаОбработчика(НовыйТекст));
	ЮТест.ОжидаетЧто(МеткаИзEPF(ПотокДанных.СкомпилированныйОбработчик.Получить()),
			"Метка обработчика из сохранённого EPF")
		.Равно("вторая версия");
	
КонецПроцедуры

// Время жизни кэшей разделено: признак версии перечитывается каждый серверный вызов,
// подключение выполняется раз в сеанс на каждую версию обработчика.
Процедура ВремяПовторногоИспользованияРазделеноМеждуМодулями() Экспорт
	
	ЮТест.ОжидаетЧто(
			Метаданные.ОбщиеМодули.инт_ВерсииОбработчиковПовтИсп.ПовторноеИспользованиеВозвращаемыхЗначений,
			"Повторное использование модуля признака версии")
		.Равно(Метаданные.СвойстваОбъектов.ПовторноеИспользованиеВозвращаемыхЗначений.НаВремяВызова);
	ЮТест.ОжидаетЧто(
			Метаданные.ОбщиеМодули.инт_ГенераторОбработокПовтИсп.ПовторноеИспользованиеВозвращаемыхЗначений,
			"Повторное использование модуля подключённых обработок")
		.Равно(Метаданные.СвойстваОбъектов.ПовторноеИспользованиеВозвращаемыхЗначений.НаВремяСеанса);
	
КонецПроцедуры

// Кэш признака версии живёт в течение вызова, поэтому подключение в нём недопустимо:
// иначе внешняя обработка подключалась бы заново на каждый серверный вызов.
Процедура ВерсияОбработчикаПотока_НеПодключаетОбработку() Экспорт
	
	// Arrange
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("не подключается");
	
	// Act
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		ПотокДанных, инт_ВерсииОбработчиковПовтИсп.ВерсияОбработчикаПотока(ПотокДанных));
	
	// Assert
	ОбработкаПодключена = Истина;
	Попытка
		ВнешниеОбработки.Создать(ИмяРегистрации, Ложь);
	Исключение
		ОбработкаПодключена = Ложь;
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ОбработкаПодключена, "Обработка подключена после чтения признака версии")
		.Равно(Ложь);
	
КонецПроцедуры

// Смена признака версии даёт промах кэша подключений: подключается обработка, собранная
// из нового текста, а прежняя остаётся доступной под своим именем.
//
// Признак версии берётся из базы данных напрямую: в кэше времени вызова до конца
// серверного вызова остаётся прежний, и это принятое поведение (ТР-Ф-050, пункт 7).
Процедура СменаВерсииОбработчика_ПодключаетНовуюОбработку() Экспорт
	
	// Arrange
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("первая версия");
	ИмяДоПравки = инт_ГенераторОбработок.ИмяОбработкиПотока(ПотокДанных);
	
	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.ТекстОбработчика = ТекстОбработчикаСМеткой("вторая версия");
	ОбъектПотока.Записать();
	
	// Act
	ИмяПослеПравки = инт_ГенераторОбработокПовтИсп.ИмяПодключеннойОбработкиПотока(
		ПотокДанных, ПотокДанных.ХешСкомпилированногоОбработчика);
	
	// Assert
	ЮТест.ОжидаетЧто(ИмяПослеПравки, "Имя обработки после правки текста").НеРавно(ИмяДоПравки);
	ЮТест.ОжидаетЧто(МеткаПодключеннойОбработки(ИмяПослеПравки), "Метка обработчика новой версии")
		.Равно("вторая версия");
	ЮТест.ОжидаетЧто(МеткаПодключеннойОбработки(ИмяДоПравки), "Метка обработчика прежней версии")
		.Равно("первая версия");
	
КонецПроцедуры

// Пустая строка больше не служит признаком отсутствия обработчика: она дошла бы
// до платформы и вернулась системным сообщением о ненайденной обработке.
Процедура ИмяОбработкиПотока_БезОбработчикаДаетПонятноеИсключение() Экспорт
	
	// Arrange
	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящийСМеткой("будет очищен");
	ОбъектПотока = ПотокДанных.ПолучитьОбъект();
	ОбъектПотока.ТекстОбработчика = "";
	ОбъектПотока.Записать();
	
	// Act
	ОшибкаБезТекста = ТекстОшибкиИмениОбработкиПотока(ПотокДанных);
	ОшибкаПустойСсылки = ТекстОшибкиИмениОбработкиПотока(Справочники.инт_ПотокиДанных.ПустаяСсылка());
	
	// Assert
	ЮТест.ОжидаетЧто(ОшибкаБезТекста, "Ошибка для потока с пустым обработчиком")
		.Содержит("Обработчик потока данных не заполнен")
		.Содержит(ПотокДанных.Наименование)
		.Содержит("Исходящий");
	ЮТест.ОжидаетЧто(ОшибкаПустойСсылки, "Ошибка для пустой ссылки на поток")
		.Содержит("Обработчик потока данных не заполнен");
	ЮТест.ОжидаетЧто(ПотокДанных.ХешСкомпилированногоОбработчика, "Признак версии очищенного обработчика")
		.Равно("");
	
КонецПроцедуры

// Отказ подключения достижим: платформа отвергает непригодный модуль. Исключение
// поднимается наверх без подмены — вызывающий код разбирает именно его текст.
// Освобождение временного хранилища на этой ветке проверить нечем: адрес наружу не выходит.
Процедура ПодключитьОбработку_ОтказПоднимаетИсходноеИсключение() Экспорт
	
	// Arrange
	НепригодныеДанные = ПолучитьДвоичныеДанныеИзСтроки("это не внешняя обработка");
	ИмяРегистрации = инт_ГенераторОбработок.ИмяРегистрацииОбработки(
		Справочники.инт_ПотокиДанных.ПолучитьСсылку(),
		инт_ГенераторОбработок.ХешТекстаОбработчика("это не внешняя обработка"));
	
	// Act
	ТекстОшибки = "";
	Попытка
		инт_ГенераторОбработок.ПодключитьОбработку(НепригодныеДанные, ИмяРегистрации);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	// Assert
	ЮТест.ОжидаетЧто(ТекстОшибки, "Текст исключения при отказе подключения").Заполнено();
	
КонецПроцедуры

// Текст обработчика, кладущего метку в результат.
Функция ТекстОбработчикаСМеткой(Знач Метка)
	
	Возврат СтрШаблон("Результат.Вставить(""метка"", ""%1"");", Метка);
	
КонецФункции

// Подключает EPF под именем, не занятым другими тестами, и возвращает метку,
// которую кладёт в результат его обработчик.
Функция МеткаИзEPF(Знач ДвоичныеДанныеEPF)
	

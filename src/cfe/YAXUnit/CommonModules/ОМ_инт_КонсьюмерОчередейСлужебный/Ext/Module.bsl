////////////////////////////////////////////////////////////////////////////////
// ОМ_инт_КонсьюмерОчередейСлужебный
// Проверки момента, покидающего подсистему в очереди неразобранных сообщений.
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.УдалениеТестовыхДанных().ВТранзакции()
	.ДобавитьТест("МоментОтказаСоответствуетОбозначениюЧасовогоПояса");

КонецПроцедуры

#Область События

Процедура ПередВсемиТестами() Экспорт
КонецПроцедуры

Процедура ПередКаждымТестом() Экспорт
КонецПроцедуры

Процедура ПослеКаждогоТеста() Экспорт
	// Проверка сдвигает часовой пояс сеанса, остальным тестам он нужен прежним.
	УстановитьЧасовойПоясСеанса();
КонецПроцедуры

Процедура ПослеВсехТестов() Экспорт
КонецПроцедуры

#КонецОбласти

// Поле failed_at снабжено буквой Z, обозначающей нулевое смещение, поэтому и момент в нём
// должен быть универсальным. При сеансе в другом часовом поясе подстановка времени сеанса
// разошлась бы с обозначением на величину смещения.
Процедура МоментОтказаСоответствуетОбозначениюЧасовогоПояса() Экспорт

	Мокито.Обучение(инт_РаботаСКафка)
	.Когда("ОтправитьСообщение").Пропустить()
	.Прогон();

	УстановитьЧасовойПоясСеанса(ГенераторТестовыхДанных.ЧасовойПоясОтличныйОтПоясаБазы());
	Эндпоинт = ГенераторТестовыхДанных.Эндпоинт();
	МоментДоОтправки = ТекущаяУниверсальнаяДата();

	инт_КонсьюмерОчередейСлужебный.ОтправитьВDLQ(Эндпоинт, "dlq-топик", "исходное тело",
		"исходный-топик", 42, 0, "ошибка обработки");

	Вызовы = Мокито.Проверить(инт_РаботаСКафка).Вызовы("ОтправитьСообщение");
	DLQСообщение = инт_КоннекторHTTP.JsonВОбъект(Вызовы[0].Параметры[0]);

	ОтклонениеСек = МоментИзОтметки(DLQСообщение.Получить("failed_at")) - МоментДоОтправки;

	ЮТест.ОжидаетЧто(ОтклонениеСек,
		"Момент отказа записан в универсальном времени, как обозначено буквой Z")
		.БольшеИлиРавно(0).МеньшеИлиРавно(5);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает отметку времени вида "2026-08-23T20:15:30Z" обратно в дату.
//
// Параметры:
//  Отметка - Строка - Значение поля failed_at
//
// Возвращаемое значение:
//  Дата - Момент, записанный в отметке
//
Функция МоментИзОтметки(Отметка)

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Отметка, "-", ""), ":", ""), "T", ""), "Z", "");

	Возврат Дата(Цифры);

КонецФункции

#КонецОбласти

Процедура ЗаписьНеОшибочногоСтатусаСохраняетЧислоПопыток() Экспорт

	ИдентификаторСообщения = ЗарегистрированноеСообщение(3);

	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ОшибкаФормирования, ЮТест.Данные().СлучайнаяСтрока());
	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ФормированиеСообщения);

	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения),
		"Запись неошибочного статуса сохраняет накопленное число попыток").Равно(1);

КонецПроцедуры

Процедура ВозвратВОчередьПослеАварийногоЗавершенияЗасчитываетПопытку() Экспорт

	ИдентификаторСообщения = ЗарегистрированноеСообщение(3);

	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ФормированиеСообщения);

	Статус = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ВернутьСообщениеВОчередь(
		ИдентификаторСообщения, "Фоновое задание завершилось аварийно");

	ЮТест.ОжидаетЧто(Статус, "Запись с оставшимися попытками возвращается в очередь")
		.Равно(Перечисления.инт_СтатусыИсходящихСообщений.Новый);
	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения),
		"Аварийное завершение задания засчитано выполненной попыткой").Равно(1);

КонецПроцедуры

Процедура ЦиклАварийныхЗавершенийЗаданияКонечен() Экспорт

	КоличествоПопытокОбработки = 3;
	ИдентификаторСообщения = ЗарегистрированноеСообщение(КоличествоПопытокОбработки);

	Для Сч = 1 По КоличествоПопытокОбработки Цикл
		РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
			Перечисления.инт_СтатусыИсходящихСообщений.ФормированиеСообщения);
		РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ВернутьСообщениеВОчередь(
			ИдентификаторСообщения, "Фоновое задание завершилось аварийно");
	КонецЦикла;

	СообщенияКФормированию = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ПолучитьИдентификаторыСообщенийКФормированию();

	ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ТекущийСтатусСообщенияПоИдентификатору(
		ИдентификаторСообщения), "Исчерпавшая предел запись переведена в статус ошибки")
		.Равно(Перечисления.инт_СтатусыИсходящихСообщений.ОшибкаФормирования);
	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения),
		"Число попыток достигло предела потока данных").Равно(КоличествоПопытокОбработки);
	ЮТест.ОжидаетЧто(СообщенияКФормированию.Найти(ИдентификаторСообщения),
		"Исчерпавшая предел запись в пул сообщений к формированию больше не возвращается").ЭтоНеопределено();

КонецПроцедуры

Процедура МенеджерПотоковВозвращаетСообщениеАварийногоПотокаЧерезПопытку() Экспорт

	ИдентификаторСообщения = ЗарегистрированноеСообщение(3);
	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ФормированиеСообщения);

	СоставПотока = Новый Массив;
	СоставПотока.Добавить(ИдентификаторСообщения);
	РегистрыСведений.инт_МенеджерПотоковФормированияСообщений.ЗарегистрироватьПоток(
		Новый УникальныйИдентификатор, СоставПотока);

	РегистрыСведений.инт_МенеджерПотоковФормированияСообщений.СобратьМусор();

	ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ТекущийСтатусСообщенияПоИдентификатору(
		ИдентификаторСообщения), "Сообщение аварийно завершившегося потока возвращено в очередь")
		.Равно(Перечисления.инт_СтатусыИсходящихСообщений.Новый);
	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения),
		"Менеджер потоков засчитывает аварийное завершение выполненной попыткой").Равно(1);

КонецПроцедуры

Процедура ВозвратОператоромСбрасываетЧислоПопыток() Экспорт

	ИдентификаторСообщения = ЗарегистрированноеСообщение(3);
	МоментНачала = ТекущаяДатаСеанса();

	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ОшибкаФормирования, ЮТест.Данные().СлучайнаяСтрока());

	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ВернутьСообщениеВОчередьОператором(ИдентификаторСообщения);

	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения),
		"Возврат оператором сбрасывает счётчик попыток").Равно(0);
	ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ТекущийСтатусСообщенияПоИдентификатору(
		ИдентификаторСообщения), "Сообщение возвращено в статус Новый")
		.Равно(Перечисления.инт_СтатусыИсходящихСообщений.Новый);
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОСбросе(МоментНачала, ИдентификаторСообщения),
		"Сброс счётчика попыток записан в журнал регистрации").ЭтоИстина();

КонецПроцедуры

Процедура ПаузаПовтораНеЗависитОтЧасовогоПоясаСеанса() Экспорт

	ПаузаПовтораСек = 3600;
	УстановитьЧасовойПоясСеанса(ГенераторТестовыхДанных.ЧасовойПоясОтличныйОтПоясаБазы());

	ИдентификаторСообщения = ЗарегистрированноеСообщение(3, ПаузаПовтораСек);

	РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
		Перечисления.инт_СтатусыИсходящихСообщений.ОшибкаФормирования, ЮТест.Данные().СлучайнаяСтрока());

	ЮТест.ОжидаетЧто(ОтобраноКФормированию(ИдентификаторСообщения),
		"До истечения паузы сообщение в работу не берётся").ЭтоЛожь();

	ИмитироватьИстечениеПаузы(ИдентификаторСообщения, ПаузаПовтораСек);

	ЮТест.ОжидаетЧто(ОтобраноКФормированию(ИдентификаторСообщения),
		"По истечении паузы сообщение берётся в работу").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтобраноКФормированию(ИдентификаторСообщения)

	Отобранные = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.ПолучитьИдентификаторыСообщенийКФормированию();

	Возврат НЕ Отобранные.Найти(ИдентификаторСообщения) = Неопределено;

КонецФункции

// Имитирует истечение паузы: записанный момент повторной попытки отодвигается в прошлое ровно
// на её длительность, то есть приходится на момент отказа.
Процедура ИмитироватьИстечениеПаузы(ИдентификаторСообщения, ПаузаПовтораСек)

	Запись = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Прочитать();
	Запись.ДатаСледующейПопытки = Запись.ДатаСледующейПопытки - ПаузаПовтораСек;
	Запись.Записать(Истина);

КонецПроцедуры

// Регистрирует сообщение в очереди исходящих по новому потоку данных с заданным пределом попыток.
//
// Параметры:
//  КоличествоПопытокОбработки - Число - Предел числа попыток потока данных
//  ПаузаПовтораСек            - Число - Пауза между попытками обработки, секунд
//
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор зарегистрированного сообщения
//
Функция ЗарегистрированноеСообщение(КоличествоПопытокОбработки, ПаузаПовтораСек = 0)

	ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий(Истина, КоличествоПопытокОбработки, ПаузаПовтораСек);

	Возврат РегистрыСведений.инт_ОчередьИсходящихСообщений.ЗарегистрироватьСообщение(
		ГенераторТестовыхДанных.демо_Документ(), ПотокДанных);

КонецФункции

Функция ЧислоПопыток(ИдентификаторСообщения)

	Запись = РегистрыСведений.инт_ТекущийСтатусИсходящихСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Прочитать();

	Возврат Запись.КоличествоПопыток;

КонецФункции

// Ищет запись журнала регистрации о сбросе счётчика попыток по идентификатору сообщения.
// Прежнее число попыток входит в текст записи, поэтому отдельной проверки не требует.
Функция ЕстьЗаписьЖурналаОСбросе(МоментНачала, ИдентификаторСообщения)

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", МоментНачала);
	Отбор.Вставить("Событие", "ПодсистемаИнтеграции.ОчередьИсходящихСообщений");

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Отбор);

	Для Каждого Запись Из Записи Цикл
		Если СтрНайти(Запись.Комментарий, Строка(ИдентификаторСообщения)) > 0
			И СтрНайти(Запись.Комментарий, "Счётчик попыток сброшен с 1 на 0") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

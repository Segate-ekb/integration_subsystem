// BSLLS-off
// @strict-types

////////////////////////////////////////////////////////////////////////////////
// ОМ_инт_ОбщегоНазначения
// Проверки пространства времени, в котором подсистема хранит и сравнивает моменты.
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.УдалениеТестовыхДанных().ВТранзакции()
	.ДобавитьТест("ВремяБазыНеЗависитОтЧасовогоПоясаСеанса")
	.ДобавитьТест("НезаданныйЧасовойПоясБазыРазрешаетсяЯвно");

КонецПроцедуры

#Область События

Процедура ПередВсемиТестами() Экспорт
КонецПроцедуры

Процедура ПередКаждымТестом() Экспорт
КонецПроцедуры

Процедура ПослеКаждогоТеста() Экспорт
	// Проверка сдвигает часовой пояс сеанса, остальным тестам он нужен прежним.
	УстановитьЧасовойПоясСеанса();
КонецПроцедуры

Процедура ПослеВсехТестов() Экспорт
КонецПроцедуры

#КонецОбласти

Процедура ВремяБазыНеЗависитОтЧасовогоПоясаСеанса() Экспорт

	ВремяБазыДоСмены = инт_ОбщегоНазначения.ВремяБазы();
	ВремяСеансаДоСмены = ТекущаяДатаСеанса();

	УстановитьЧасовойПоясСеанса(ГенераторТестовыхДанных.ЧасовойПоясОтличныйОтПоясаБазы());

	ЮТест.ОжидаетЧто(ТекущаяДатаСеанса() - ВремяСеансаДоСмены,
		"Проверка состоятельна: часовой пояс сеанса сменился на отличный от пояса базы")
		.НеРавно(0);
	ЮТест.ОжидаетЧто(инт_ОбщегоНазначения.ВремяБазы() - ВремяБазыДоСмены,
		"Время базы от часового пояса сеанса не зависит")
		.БольшеИлиРавно(0).МеньшеИлиРавно(5);

КонецПроцедуры

// Часовой пояс информационной базы после её создания не определён. Платформа в этом случае
// молча берёт часовой пояс компьютера, и время базы вырождается во время сервера вместе
// с расхождением между серверами кластера. Проверяется, что подсистема разрешает этот случай
// сама и приходит к универсальному времени, одинаковому на всех серверах кластера.
Процедура НезаданныйЧасовойПоясБазыРазрешаетсяЯвно() Экспорт

	ЧасовойПоясХранения = инт_ОбщегоНазначения.ЧасовойПоясХраненияМоментов(Неопределено);

	ЮТест.ОжидаетЧто(ЧасовойПоясХранения,
		"Незаданный часовой пояс базы разрешается подсистемой, а не оставляется платформе")
		.Заполнено();

	МоментУниверсальный = ТекущаяУниверсальнаяДата();

	ЮТест.ОжидаетЧто(МестноеВремя(МоментУниверсальный, ЧасовойПоясХранения) - МоментУниверсальный,
		"При незаданном часовом поясе базы моменты не уходят в часовой пояс компьютера")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

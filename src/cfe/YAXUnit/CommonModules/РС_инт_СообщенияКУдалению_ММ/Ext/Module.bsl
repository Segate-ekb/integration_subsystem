// Срок хранения определяется по потоку из очереди, поэтому без записи в очереди регистрировать нечего.
Процедура СообщениеВнеОчередиКУдалениюНеРегистрируется(НаправлениеПотока) Экспорт

    ИдентификаторСообщения = Новый УникальныйИдентификатор;

    ЮТест.ОжидаетЧто(РегистрыСведений.инт_СообщенияКУдалению)
        .Метод("ЗарегистрироватьСообщениеКУдалению")
        .Параметр(ИдентификаторСообщения)
        .Параметр(НаправлениеПотока)
        .НеВыбрасываетИсключение();

    ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.инт_СообщенияКУдалению")
        .НеСодержитЗаписи(ЮТест.Предикат().Реквизит("ИдентификаторСообщения").Равно(ИдентификаторСообщения));

КонецПроцедуры

#КонецОбласти


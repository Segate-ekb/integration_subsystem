Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.УдалениеТестовыхДанных().ВТранзакции()
    .ДобавитьТест("СообщениеВнеОчередиКУдалениюНеРегистрируется")
    .Представление("Входящее", Истина)
    .СПараметрами(Перечисления.инт_НаправлениеПотокаДанных.Входящий)
    .ДобавитьТест("СообщениеВнеОчередиКУдалениюНеРегистрируется")
    .Представление("Исходящее", Истина)
    .СПараметрами(Перечисления.инт_НаправлениеПотокаДанных.Исходящий);


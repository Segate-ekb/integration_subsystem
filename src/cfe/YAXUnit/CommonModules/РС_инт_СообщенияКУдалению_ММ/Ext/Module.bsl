// BSLLS-off

/////////////////////////////////////////////////////////////////////////////////
// Тесты ретроспективной регистрации обработанных сообщений к удалению:
// срок хранения задан в потоке позже, чем сообщения были обработаны.
/////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты.УдалениеТестовыхДанных().ВТранзакции()
    .ДобавитьТест("ОбработанныеДоУстановкиСрокаСообщенияПолучаютДатуУдаления")
    .ДобавитьТест("СообщенияРегистрируютсяПачками")
    .ДобавитьТест("ПачкаСЗарегистрированнымСообщениемНеЗатираетЕгоДатуУдаления")
    .ВТранзакции(Ложь)
    .ДобавитьТест("ВходящееСообщениеНеВСтатусеОбработанНеПолучаетДатуУдаления")
    .Представление("Статус «Новый»", Истина)
    .СПараметрами(Перечисления.инт_СтатусыВходящихСообщений.Новый)
    .ДобавитьТест("ВходящееСообщениеНеВСтатусеОбработанНеПолучаетДатуУдаления")
    .Представление("Статус «В обработке»", Истина)
    .СПараметрами(Перечисления.инт_СтатусыВходящихСообщений.ВОбработке)
    .ДобавитьТест("ВходящееСообщениеНеВСтатусеОбработанНеПолучаетДатуУдаления")
    .Представление("Статус «Ошибка обработки»", Истина)
    .СПараметрами(Перечисления.инт_СтатусыВходящихСообщений.ОшибкаОбработки)
    .ДобавитьТест("СообщенияДругихПотоковНеЗатрагиваются")
    .ДобавитьТест("ПовторнаяРегистрацияНеМеняетПроставленнуюДатуУдаления")
    .ДобавитьТест("БезСрокаХраненияСообщенияНеРегистрируются")
    .ДобавитьТест("РазосланноеВсемПодписчикамСообщениеПолучаетДатуУдаления")
    .ДобавитьТест("НеРазосланноеВсемПодписчикамСообщениеНеПолучаетДатуУдаления")
    .ДобавитьТест("УстановкаСрокаХраненияТребуетРегистрацииОбработанныхСообщений")
    .ДобавитьТест("ЗаписьПотокаБезИзмененияСрокаНеТребуетРегистрации");

КонецПроцедуры

#КонецОбласти

Процедура ОбработанныеДоУстановкиСрокаСообщенияПолучаютДатуУдаления() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ИдентификаторСообщения = ОбработанноеВходящееСообщение(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения), "Дата удаления до установки срока")
        .ЭтоНеопределено();

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения), "Дата удаления после регистрации")
        .Заполнено()
        .Больше(ТекущаяДата() + 86400 * 4);
КонецПроцедуры

// Три сообщения при пачке в два: первая пачка сбрасывается в середине цикла, третье уходит хвостом.
Процедура СообщенияРегистрируютсяПачками() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    Сообщения = Новый Массив;
    Для Счетчик = 1 По 3 Цикл
        Сообщения.Добавить(ОбработанноеВходящееСообщение(ПотокДанных));
    КонецЦикла;

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных, 2);

    Для Индекс = 0 По Сообщения.ВГраница() Цикл
        ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(Сообщения[Индекс]),
            СтрШаблон("Дата удаления сообщения %1", Индекс + 1)).Заполнено();
    КонецЦикла;
КонецПроцедуры

// Тест выполняется вне транзакции: после ошибки записи платформа запрещает в транзакции
// любые операции, и восстановление пачки было бы невозможно.
Процедура ПачкаСЗарегистрированнымСообщениемНеЗатираетЕгоДатуУдаления() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ЗарегистрированноеСообщение = ОбработанноеВходящееСообщение(ПотокДанных);

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);
    ПроставленнаяДатаУдаления = ДатаУдаленияВходящегоСообщения(ЗарегистрированноеСообщение);

    // Пока срок не задан, штатный путь сообщение к удалению не регистрирует.
    УстановитьСрокХранения(ПотокДанных, 0);
    НовоеСообщение = ОбработанноеВходящееСообщение(ПотокДанных);
    УстановитьСрокХранения(ПотокДанных, 10);

    ОтбиратьВсеСообщенияПотока();
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ЗарегистрированноеСообщение),
        "Дата удаления ранее зарегистрированного сообщения").Равно(ПроставленнаяДатаУдаления);
    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(НовоеСообщение),
        "Дата удаления сообщения, оставшегося в пачке").Заполнено();
КонецПроцедуры

Процедура ВходящееСообщениеНеВСтатусеОбработанНеПолучаетДатуУдаления(СтатусСообщения) Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ИдентификаторСообщения = РегистрыСведений.инт_ОчередьВходящихСообщений.ЗарегистрироватьСообщение(
        Новый Структура("Hello", "world"), ПотокДанных);
    РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
        СтатусСообщения, "Обработка сообщения не завершена");

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения), "Дата удаления необработанного сообщения")
        .ЭтоНеопределено();
КонецПроцедуры

Процедура СообщенияДругихПотоковНеЗатрагиваются() Экспорт
    РегистрируемыйПоток = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    СтороннийПоток = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    СтороннееСообщение = ОбработанноеВходящееСообщение(СтороннийПоток);

    УстановитьСрокХранения(РегистрируемыйПоток, 5);
    УстановитьСрокХранения(СтороннийПоток, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(РегистрируемыйПоток);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(СтороннееСообщение), "Дата удаления сообщения стороннего потока")
        .ЭтоНеопределено();
КонецПроцедуры

Процедура ПовторнаяРегистрацияНеМеняетПроставленнуюДатуУдаления() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ИдентификаторСообщения = ОбработанноеВходящееСообщение(ПотокДанных);

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);
    ПроставленнаяДатаУдаления = ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения);

    УстановитьСрокХранения(ПотокДанных, 10);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения), "Дата удаления после повторной регистрации")
        .Равно(ПроставленнаяДатаУдаления);
КонецПроцедуры

Процедура БезСрокаХраненияСообщенияНеРегистрируются() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    ИдентификаторСообщения = ОбработанноеВходящееСообщение(ПотокДанных);

    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения), "Дата удаления сообщения потока без срока хранения")
        .ЭтоНеопределено();
КонецПроцедуры

Процедура РазосланноеВсемПодписчикамСообщениеПолучаетДатуУдаления() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий();
    ИдентификаторСообщения = ИсходящееСообщение(ПотокДанных);
    ОтметитьОтправленнымПодписчикам(ИдентификаторСообщения, ПотокДанных, 0);

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияИсходящегоСообщения(ИдентификаторСообщения), "Дата удаления разосланного сообщения")
        .Заполнено();
КонецПроцедуры

Процедура НеРазосланноеВсемПодписчикамСообщениеНеПолучаетДатуУдаления() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий();
    ИдентификаторСообщения = ИсходящееСообщение(ПотокДанных);
    ОтметитьОтправленнымПодписчикам(ИдентификаторСообщения, ПотокДанных, 1);

    УстановитьСрокХранения(ПотокДанных, 5);
    РегистрыСведений.инт_СообщенияКУдалению.ЗарегистрироватьОбработанныеСообщенияПотока(ПотокДанных);

    ЮТест.ОжидаетЧто(ДатаУдаленияИсходящегоСообщения(ИдентификаторСообщения), "Дата удаления не разосланного сообщения")
        .ЭтоНеопределено();
КонецПроцедуры

Процедура УстановкаСрокаХраненияТребуетРегистрацииОбработанныхСообщений() Экспорт
    ОбъектПотока = ГенераторТестовыхДанных.ПотокДанныхВходящий().ПолучитьОбъект();
    ОбъектПотока.УдалятьОбработанныеСообщенияЧерез = 5;
    ОбъектПотока.Записать();

    ЮТест.ОжидаетЧто(ОбъектПотока.ДополнительныеСвойства, "Дополнительные свойства записанного потока")
        .ИмеетСвойство("ЗарегистрироватьОбработанныеСообщенияКУдалению");
КонецПроцедуры

Процедура ЗаписьПотокаБезИзмененияСрокаНеТребуетРегистрации() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();
    УстановитьСрокХранения(ПотокДанных, 5);

    ОбъектПотока = ПотокДанных.ПолучитьОбъект();
    ОбъектПотока.Записать();

    ЮТест.ОжидаетЧто(ОбъектПотока.ДополнительныеСвойства, "Дополнительные свойства записанного потока")
        .НеИмеетСвойства("ЗарегистрироватьОбработанныеСообщенияКУдалению");
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Регистрирует входящее сообщение и переводит его в статус "Обработан".
Функция ОбработанноеВходящееСообщение(ПотокДанных)
    ИдентификаторСообщения = РегистрыСведений.инт_ОчередьВходящихСообщений.ЗарегистрироватьСообщение(
        Новый Структура("Hello", "world"), ПотокДанных);
    РегистрыСведений.инт_ТекущийСтатусВходящихСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
        Перечисления.инт_СтатусыВходящихСообщений.Обработан);

    Возврат ИдентификаторСообщения;
КонецФункции

// Регистрирует исходящее сообщение и ставит его в очередь отправки подписчикам потока.
Функция ИсходящееСообщение(ПотокДанных)
    ИдентификаторСообщения = РегистрыСведений.инт_ОчередьИсходящихСообщений.ЗарегистрироватьСообщение(
        ГенераторТестовыхДанных.демо_Документ(), ПотокДанных);
    РегистрыСведений.инт_ОчередьИсходящихСообщений.ЗарегистрироватьСообщениеКОтправке(ИдентификаторСообщения);

    Возврат ИдентификаторСообщения;
КонецФункции

// Помечает сообщение отправленным всем подписчикам потока, кроме указанного количества последних.
Процедура ОтметитьОтправленнымПодписчикам(ИдентификаторСообщения, ПотокДанных, КоличествоНеотправленных)
    Подписчики = Справочники.инт_ПотокиДанных.ПолучитьПодписчиковПоПотоку(ПотокДанных);

    Для Индекс = 0 По Подписчики.ВГраница() - КоличествоНеотправленных Цикл
        РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения,
            Подписчики[Индекс], Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Отправлен);
    КонецЦикла;
КонецПроцедуры

// Подменяет отбор кандидатов выборкой всех сообщений потока. В пачку попадает сообщение,
// уже зарегистрированное к удалению, и набор записей конфликтует по ключу - так в один поток
// воспроизводится ситуация, когда сообщение успел зарегистрировать штатный путь.
Процедура ОтбиратьВсеСообщенияПотока()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
        |	Очередь.ИдентификаторСообщения КАК ИдентификаторСообщения
        |ИЗ
        |	РегистрСведений.инт_ОчередьВходящихСообщений КАК Очередь
        |ГДЕ
        |	Очередь.ПотокДанных = &ПотокДанных";

    Мокито.Обучение(РегистрыСведений.инт_СообщенияКУдалению)
    .Когда("ЗапросОбработанныхСообщенийБезДатыУдаления").Вернуть(Запрос)
    .Прогон();
КонецПроцедуры

Процедура УстановитьСрокХранения(ПотокДанных, СрокХраненияДней)
    ОбъектПотока = ПотокДанных.ПолучитьОбъект();
    ОбъектПотока.УдалятьОбработанныеСообщенияЧерез = СрокХраненияДней;
    ОбъектПотока.Записать();
КонецПроцедуры

Функция ДатаУдаленияВходящегоСообщения(ИдентификаторСообщения)
    Возврат ДатаУдаления(ИдентификаторСообщения, Перечисления.инт_НаправлениеПотокаДанных.Входящий);
КонецФункции

Функция ДатаУдаленияИсходящегоСообщения(ИдентификаторСообщения)
    Возврат ДатаУдаления(ИдентификаторСообщения, Перечисления.инт_НаправлениеПотокаДанных.Исходящий);
КонецФункции

// Возвращает дату удаления сообщения или Неопределено, если сообщение к удалению не зарегистрировано.
Функция ДатаУдаления(ИдентификаторСообщения, НаправлениеПотока)
    Запись = РегистрыСведений.инт_СообщенияКУдалению.СоздатьМенеджерЗаписи();
    Запись.ИдентификаторСообщения = ИдентификаторСообщения;
    Запись.НаправлениеПотока = НаправлениеПотока;
    Запись.Прочитать();

    Возврат ?(Запись.Выбран(), Запись.ДатаУдаления, Неопределено);
КонецФункции

#КонецОбласти

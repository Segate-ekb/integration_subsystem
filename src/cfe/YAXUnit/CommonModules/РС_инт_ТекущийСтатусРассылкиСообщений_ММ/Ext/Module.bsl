Процедура ЦиклАварийныхЗавершенийЗаданияКонечен() Экспорт
	Мокито.Обучение(РегистрыСведений.инт_СообщенияКУдалению)
	.Когда("ЗарегистрироватьСообщениеКУдалению").Пропустить()
	.Прогон();

	КоличествоПопытокОтправки = 3;
	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Подписчик = ГенераторТестовыхДанных.Подписчик(, КоличествоПопытокОтправки);

	РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый);

	Для Сч = 1 По КоличествоПопытокОтправки Цикл
		РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
			Перечисления.инт_СтатусыРассылкиИсходящихСообщений.ВПроцессеОтправки);
		Статус = РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ВернутьСообщениеВОчередь(
			ИдентификаторСообщения, Подписчик, "Фоновое задание завершилось аварийно");
	КонецЦикла;

	СообщенияКОтправке = РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ПолучитьСообщенияКОтправке(
		0, Подписчик.Метаданные().Имя);

	ЮТест.ОжидаетЧто(Статус, "Исчерпавшая предел запись переведена в статус ошибки")
	.Равно(Перечисления.инт_СтатусыРассылкиИсходящихСообщений.ОшибкаОбработки);
	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения, Подписчик),
		"Число попыток достигло предела подписчика").Равно(КоличествоПопытокОтправки);
	ЮТест.ОжидаетЧто(ЕстьСообщениеВВыборке(СообщенияКОтправке, ИдентификаторСообщения, Подписчик),
		"Исчерпавшая предел запись в пул сообщений больше не возвращается").ЭтоЛожь();

КонецПроцедуры

Процедура ВозвратОператоромСбрасываетЧислоПопыток() Экспорт
	Мокито.Обучение(РегистрыСведений.инт_СообщенияКУдалению)
	.Когда("ЗарегистрироватьСообщениеКУдалению").Пропустить()
	.Прогон();

	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Подписчик = ГенераторТестовыхДанных.Подписчик(, 3);
	МоментНачала = ТекущаяДатаСеанса();

	РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый);
	РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.ОшибкаОбработки, ЮТест.Данные().СлучайнаяСтрока());

	РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ВернутьСообщениеВОчередьОператором(
		ИдентификаторСообщения, Подписчик);

	ЮТест.ОжидаетЧто(ЧислоПопыток(ИдентификаторСообщения, Подписчик),
		"Возврат оператором сбрасывает счётчик попыток").Равно(0);
	ЮТест.ОжидаетЧто(РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ТекущийСтатусСообщения(
		ИдентификаторСообщения, Подписчик), "Сообщение возвращено в статус Новый")
	.Равно(Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый);
	ЮТест.ОжидаетЧто(ЕстьЗаписьЖурналаОСбросе(МоментНачала, ИдентификаторСообщения),
		"Сброс счётчика попыток записан в журнал регистрации").ЭтоИстина();

КонецПроцедуры

Процедура ИсчерпавшаяПопыткиЗаписьМеняетНаборУчитывающихЕеМетрик() Экспорт
	Мокито.Обучение(РегистрыСведений.инт_СообщенияКУдалению)
	.Когда("ЗарегистрироватьСообщениеКУдалению").Пропустить()
	.Прогон();

	КоличествоПопытокОтправки = 2;
	ИдентификаторСообщения = Новый УникальныйИдентификатор;
	Подписчик = ГенераторТестовыхДанных.Подписчик(, КоличествоПопытокОтправки);

	РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
		Перечисления.инт_СтатусыРассылкиИсходящихСообщений.Новый);

	Для Сч = 1 По КоличествоПопытокОтправки Цикл
		РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ЗаписатьСтатусСообщения(ИдентификаторСообщения, Подписчик,
			Перечисления.инт_СтатусыРассылкиИсходящихСообщений.ВПроцессеОтправки);
		РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.ВернутьСообщениеВОчередь(
			ИдентификаторСообщения, Подписчик, "Фоновое задание завершилось аварийно");
	КонецЦикла;

	Условия = пэмМетрикиСервер.УсловияОтбораОперацийОчередей().Рассылка;

	УсловиеВмешательства = "(" + Условия.Ошибочные + ") И (" + Условия.ПопыткиИсчерпаны + ")";
	УсловиеПовтора = "(" + Условия.Ожидающие + ") И Статус.КоличествоПопыток > 0";

	ЮТест.ОжидаетЧто(ЗаписьОтбираетсяУсловием(ИдентификаторСообщения, Подписчик, УсловиеВмешательства),
		"Запись учитывается метрикой операций, ожидающих вмешательства оператора").ЭтоИстина();
	ЮТест.ОжидаетЧто(ЗаписьОтбираетсяУсловием(ИдентификаторСообщения, Подписчик, УсловиеПовтора),
		"Запись перестаёт учитываться метрикой операций, ожидающих повтора").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// Проверяет, отбирается ли запись рассылки условием отбора операций очередей.
// Условия рассчитаны на запрос, в котором регистр текущего статуса имеет псевдоним «Статус»:
// метрики очередей строят запросы по тем же условиям, поэтому проверка условия равносильна
// проверке попадания записи в метрику.
//
// Параметры:
//  ИдентификаторСообщения - УникальныйИдентификатор - Идентификатор сообщения рассылки
//  Подписчик              - ОпределяемыйТип.инт_Подписчик - Подписчик рассылки
//  Условие                - Строка - Условие отбора на языке запросов
//
// Возвращаемое значение:
//  Булево - Истина, если запись отбирается условием
//
Функция ЗаписьОтбираетсяУсловием(ИдентификаторСообщения, Подписчик, Условие)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Статус.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.инт_ТекущийСтатусРассылкиСообщений КАК Статус
	|ГДЕ
	|	Статус.ИдентификаторСообщения = &ИдентификаторСообщения
	|	И Статус.Подписчик = &Подписчик
	|	И (%1)", Условие);
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Запрос.УстановитьПараметр("Подписчик", Подписчик);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция ЧислоПопыток(ИдентификаторСообщения, Подписчик)

	Запись = РегистрыСведений.инт_ТекущийСтатусРассылкиСообщений.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.Подписчик = Подписчик;
	Запись.Прочитать();

	Возврат Запись.КоличествоПопыток;

КонецФункции

Функция ЕстьСообщениеВВыборке(СообщенияКОтправке, ИдентификаторСообщения, Подписчик)

	Для Каждого Сообщение Из СообщенияКОтправке Цикл
		Если Сообщение.ИдентификаторСообщения = ИдентификаторСообщения И Сообщение.Подписчик = Подписчик Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Ищет запись журнала регистрации о сбросе счётчика попыток по идентификатору сообщения.
// Прежнее число попыток входит в текст записи, поэтому отдельной проверки не требует.
Функция ЕстьЗаписьЖурналаОСбросе(МоментНачала, ИдентификаторСообщения)

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", МоментНачала);
	Отбор.Вставить("Событие", "ПодсистемаИнтеграции.ОчередьОтправкиСообщений");

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Отбор);

	Для Каждого Запись Из Записи Цикл
		Если СтрНайти(Запись.Комментарий, Строка(ИдентификаторСообщения)) > 0
			И СтрНайти(Запись.Комментарий, "Счётчик попыток сброшен с 1 на 0") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

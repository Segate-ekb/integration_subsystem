Процедура ОбработкаВходящегоСообщенияПоИсходящемуПотоку() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхИсходящий();
    Сообщение = Новый Соответствие;
    
    ЮТест.ОжидаетЧто(инт_ОбработкаВходящихПотоков)
    .Метод("ОбработкаВходящегоСообщенияПоПотоку")
    .Параметр(Сообщение)
    .Параметр(ПотокДанных)
    .ВыбрасываетИсключение("Нельзя использовать исходящие потоки для входящих сообщений!");
КонецПроцедуры

Процедура ОбработкаАсинхронногоСообщения() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий();

    Сообщение = Новый Соответствие;
    
    Мокито.Обучение(РегистрыСведений.инт_ОчередьВходящихСообщений)
        .Когда("ЗарегистрироватьСообщение").Пропустить()
        .Прогон();
                
    ЮТест.ОжидаетЧто(инт_ОбработкаВходящихПотоков)
        .Метод("ОбработкаВходящегоСообщенияПоПотоку")
        .Параметр(Сообщение)
        .Параметр(ПотокДанных)
        .НеВыбрасываетИсключение();
КонецПроцедуры

Процедура ОбработкаСообщенияССинхроннойОбработкой() Экспорт
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,,Ложь);

    Сообщение = Новый Соответствие;
    
    Мокито.Обучение(Справочники.инт_ПотокиДанных)
        .Когда("ОбработатьВходящееСообщениеПоПотоку").Пропустить()
        .Обучение(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .Когда("ЗаписатьСтатистикуОбработкиВходящего").Пропустить()
        .Прогон();
                
    ЮТест.ОжидаетЧто(инт_ОбработкаВходящихПотоков)
        .Метод("ОбработкаВходящегоСообщенияПоПотоку")
        .Параметр(Сообщение)
        .Параметр(ПотокДанных)
        .НеВыбрасываетИсключение();
КонецПроцедуры

Процедура СинхроннаяОбработкаЗаписываетСтатистикуУспеха() Экспорт
    // Arrange
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,,Ложь);
    Сообщение = Новый Соответствие;
    
    Мокито.Обучение(Справочники.инт_ПотокиДанных)
        .Когда("ОбработатьВходящееСообщениеПоПотоку").Пропустить()
        .Обучение(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .Когда("ЗаписатьСтатистикуОбработкиВходящего").Пропустить()
        .Прогон();
    
    // Act
    инт_ОбработкаВходящихПотоков.ОбработкаВходящегоСообщенияПоПотоку(Сообщение, ПотокДанных);
    
    // Assert — статистика должна быть записана ровно 1 раз
    Мокито.Проверить(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .КоличествоВызовов("ЗаписатьСтатистикуОбработкиВходящего")
        .Равно(1);
    
    // Assert — вызов должен быть с Успешно = Истина
    МассивВызовов = Мокито.Проверить(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .Вызовы("ЗаписатьСтатистикуОбработкиВходящего");
    
    ЮТест.ОжидаетЧто(МассивВызовов[0].Параметры[3])
        .ИмеетТип("Булево")
        .Равно(Истина);
КонецПроцедуры

Процедура СинхроннаяОбработкаЗаписываетСтатистикуОшибки() Экспорт
    // Arrange
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,,Ложь);
    Сообщение = Новый Соответствие;
    
    Мокито.Обучение(Справочники.инт_ПотокиДанных)
        .Когда("ОбработатьВходящееСообщениеПоПотоку").ВыброситьИсключение("Тестовая ошибка обработки")
        .Обучение(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .Когда("ЗаписатьСтатистикуОбработкиВходящего").Пропустить()
        .Прогон();
    
    // Act — должно выбросить исключение
    ЮТест.ОжидаетЧто(инт_ОбработкаВходящихПотоков)
        .Метод("ОбработкаВходящегоСообщенияПоПотоку")
        .Параметр(Сообщение)
        .Параметр(ПотокДанных)
        .ВыбрасываетИсключение("Тестовая ошибка обработки");
    
    // Assert — статистика должна быть записана ровно 1 раз
    Мокито.Проверить(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .КоличествоВызовов("ЗаписатьСтатистикуОбработкиВходящего")
        .Равно(1);
    
    // Assert — вызов должен быть с Успешно = Ложь
    МассивВызовов = Мокито.Проверить(РегистрыСведений.инт_СтатистикаОбработкиСообщений)
        .Вызовы("ЗаписатьСтатистикуОбработкиВходящего");
    
    ЮТест.ОжидаетЧто(МассивВызовов[0].Параметры[3])
        .ИмеетТип("Булево")
        .Равно(Ложь);
КонецПроцедуры

Процедура ОшибкаОбработчикаЗавершаетТранзакциюСообщения() Экспорт
    // Arrange
    ПотокДанных = ПотокСОшибочнымОбработчиком();

    // Act
    ОшибкаОбработки = ОбработатьСообщениеИВернутьОшибку(ПотокДанных);

    // Assert
    ЮТест.ОжидаетЧто(ОшибкаОбработки, "Должна вернуться ошибка обработчика, а не ошибка транзакции")
        .Содержит(ТекстОшибкиОбработчика());
    ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Транзакция ошибочного сообщения должна быть завершена")
        .ЭтоЛожь();
КонецПроцедуры

Процедура ПослеОшибкиОбработчикаОбработкаСообщенийПродолжается() Экспорт
    // Arrange
    ПотокСОшибкой = ПотокСОшибочнымОбработчиком();
    ИсправныйПоток = ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,, Ложь);
    ИдентификаторСообщенияСОшибкой = Новый УникальныйИдентификатор;

    // Act
    ОбработатьСообщениеИВернутьОшибку(ПотокСОшибкой, ИдентификаторСообщенияСОшибкой);

    // Assert
    УсловиеПоискаЗаписи = ЮТест.Предикат()
        .Реквизит("ИдентификаторСообщения").Равно(ИдентификаторСообщенияСОшибкой)
        .Реквизит("Успешно").Равно(Ложь);

    ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.инт_СтатистикаОбработкиСообщений")
        .СодержитЗаписи(УсловиеПоискаЗаписи);

    ЮТест.ОжидаетЧто(инт_ОбработкаВходящихПотоков, "Следующее сообщение должно обрабатываться")
        .Метод("ОбработкаВходящегоСообщенияПоПотоку")
        .Параметр(Новый Соответствие)
        .Параметр(ИсправныйПоток)
        .НеВыбрасываетИсключение();
КонецПроцедуры

Процедура ОбработчикСНезакрытойТранзакциейНеСчитаетсяУспешным() Экспорт
    // Arrange
    ПотокДанных = ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,, Ложь, "НачатьТранзакцию();");

    // Act
    ОшибкаОбработки = ОбработатьСообщениеИВернутьОшибку(ПотокДанных);

    // Assert
    ЮТест.ОжидаетЧто(ОшибкаОбработки, "Обработчик оставил транзакцию открытой, успехом это считать нельзя")
        .Содержит("не закрыв начатую транзакцию");
    ЮТест.ОжидаетЧто(ТранзакцияАктивна(), "Транзакция обработчика должна быть завершена")
        .ЭтоЛожь();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поток с обработчиком, который завершается ошибкой, не закрыв начатую транзакцию.
Функция ПотокСОшибочнымОбработчиком()
    ТекстОбработчика = СтрШаблон("НачатьТранзакцию();
        |ВызватьИсключение ""%1"";", ТекстОшибкиОбработчика());

    Возврат ГенераторТестовыхДанных.ПотокДанныхВходящий(,,,, Ложь, ТекстОбработчика);
КонецФункции

Функция ТекстОшибкиОбработчика()
    Возврат "Обработчик потока не смог обработать сообщение";
КонецФункции

Функция ОбработатьСообщениеИВернутьОшибку(ПотокДанных, ИдентификаторСообщения = Неопределено)
    Попытка
        инт_ОбработкаВходящихПотоков.ОбработкаВходящегоСообщенияПоПотоку(Новый Соответствие, ПотокДанных, ИдентификаторСообщения);
    Исключение
        Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    Возврат "";
КонецФункции

#КонецОбласти
